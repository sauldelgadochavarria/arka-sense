<%- include('../Partials/layout-top', { title: 'Asistencia', session }) %>
<%- include('partials/flujo-asistencia', { pasoActual: 0, fechaDesde: rango.fechaDesde, fechaHasta: rango.fechaHasta }) %>

<section class="page-header">
  <h1>Asistencia</h1>
  <p class="muted">
    <% if (scope && scope.mode === 'supervisor') { %>
    Vista de <strong>supervisor</strong>: tu equipo y autorizaciones pendientes.
    <% } else { %>
    Sigue los pasos de arriba: marcaciones, día, autorizar, evidencia y jornada.
    <% } %>
  </p>
</section>

<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant.</p>
<% } else { %>

<form method="get" action="/asistencia" class="form-grid" style="margin-bottom:1rem;align-items:end">
  <label>Desde
    <input type="date" name="fechaDesde" value="<%= rango.fechaDesde %>" />
  </label>
  <label>Hasta
    <input type="date" name="fechaHasta" value="<%= rango.fechaHasta %>" />
  </label>
  <button type="submit">Filtrar</button>
</form>
<p class="muted">
  <% if (rango.origen === 'periodo' && rango.periodoLabel) { %>
  Rango del período de pre-nómina abierto: <strong><%= rango.periodoLabel %></strong>.
  <% } else if (rango.origen === 'hoy') { %>
  Sin período de pre-nómina abierto: el rango es el día de hoy.
  Si ese día no tiene checadas, los recuadros quedan en cero; amplía Desde y Hasta para ver otros días.
  <% } else { %>
  Rango elegido: <%= rango.fechaDesde %> → <%= rango.fechaHasta %>.
  <% } %>
</p>

<% if (pendientesCount > 0) { %>
<div class="alert alert-warning">
  <strong>Tienes <%= pendientesCount %> autorización(es) pendiente(s).</strong>
  <a class="btn" href="/asistencia-autorizaciones" style="margin-left:.5rem">Revisar ahora</a>
</div>
<% } else { %>
<p class="muted">Sin autorizaciones pendientes<%= scope.mode === 'supervisor' ? ' en tu equipo' : '' %>.</p>
<% } %>

<div class="summary-cards" style="margin:1rem 0">
  <% if (scope.mode === 'supervisor') { %>
  <div class="card"><strong><%= equipoResumen.presentes %></strong> presentes</div>
  <div class="card"><strong><%= equipoResumen.retardos %></strong> retardos</div>
  <div class="card"><strong><%= equipoResumen.faltas %></strong> faltas</div>
  <div class="card"><strong><%= equipoResumen.incompletos %></strong> incompletos</div>
  <% } else { %>
  <a class="card" href="/asistencia-intentos?fechaDesde=<%= rango.fechaDesde %>&amp;fechaHasta=<%= rango.fechaHasta %>"><strong><%= alertasHoy.intentosRechazados %></strong> intentos rechazados</a>
  <a class="card" href="/asistencia-intentos?fechaDesde=<%= rango.fechaDesde %>&amp;fechaHasta=<%= rango.fechaHasta %>"><strong><%= alertasHoy.fueraZona %></strong> fuera de zona</a>
  <a class="card" href="/asistencia-registro-jornada?desde=<%= rango.fechaDesde %>&amp;hasta=<%= rango.fechaHasta %>"><strong><%= alertasHoy.excede12 %></strong> días &gt;12 h</a>
  <a class="card" href="/asistencia-autorizaciones?fechaDesde=<%= rango.fechaDesde %>&amp;fechaHasta=<%= rango.fechaHasta %>"><strong><%= alertasHoy.excepciones %></strong> por autorizar</a>
  <% } %>
</div>

<% if (pendientes && pendientes.length) { %>
<section class="card-block">
  <h2>Pendientes recientes</h2>
  <table>
    <thead>
      <tr><th>Fecha</th><th>Colaborador</th><th>Tipo</th><th>Detalle</th><th></th></tr>
    </thead>
    <tbody>
      <% pendientes.slice(0, 8).forEach(function(p) {
           const ymd = p.fecha ? new Date(p.fecha).toISOString().slice(0, 10) : '—';
      %>
      <tr>
        <td><%= ymd %></td>
        <td><%= empMap.get(String(p.empleadoId)) || '—' %></td>
        <td><code><%= p.tipo %></code></td>
        <td class="muted small">
          <% if (p.tipo === 'retardo') { %><%= p.minutosRetardo || 0 %> min<% } %>
          <%= p.motivoSolicitud || '' %>
        </td>
        <td><a href="/asistencia-autorizaciones#auth-<%= p._id %>">Decidir</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</section>
<% } %>

<section class="card-block">
  <h2>Configurar</h2>
  <div class="toolbar">
    <a class="btn" href="/asistencia-turnos">Turnos / esquema 46-9-12</a>
    <a class="btn" href="/config-puntos-acceso">Puntos de acceso</a>
    <a class="btn" href="/dashboard">Continuar a flujo de nómina →</a>
  </div>
</section>

<% } %>
<%- include('../Partials/layout-bottom') %>
