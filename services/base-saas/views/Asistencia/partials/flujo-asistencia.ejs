<%
  const paso = typeof pasoActual !== 'undefined' ? Number(pasoActual) : 0;
  const fechaQ = typeof fecha !== 'undefined' && fecha ? fecha : new Date().toISOString().slice(0, 10);
  const pasos = [
    { n: 1, titulo: 'Marcaciones', href: '/asistencia-marcaciones?fecha=' + fechaQ },
    { n: 2, titulo: 'Del día', href: '/asistencia-diaria?fecha=' + fechaQ },
    { n: 3, titulo: 'Autorizar', href: '/asistencia-autorizaciones' },
    { n: 4, titulo: 'Evidencia', href: '/asistencia-intentos?fecha=' + fechaQ },
    { n: 5, titulo: 'Jornada', href: '/asistencia-registro-jornada' }
  ];
%>
<nav class="flujo-asistencia" aria-label="Flujo de asistencia" style="margin:0 0 1.25rem;padding:.75rem 1rem;border:1px solid #e5e7eb;border-radius:8px;background:#fafafa">
  <div style="display:flex;flex-wrap:wrap;gap:.5rem 1rem;align-items:center;margin-bottom:.35rem">
    <strong><a href="/asistencia">Asistencia</a></strong>
    <span class="muted small">Un solo recorrido</span>
  </div>
  <p class="muted small" style="margin:0 0 .5rem">
    1 corrige la checada · 2 revisa el día · 3 autoriza la excepción
  </p>
  <ol style="display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;margin:0;padding:0">
    <% pasos.forEach(function(p) { %>
    <li>
      <a href="<%= p.href %>"
         style="display:inline-block;padding:.35rem .7rem;border-radius:999px;text-decoration:none;font-size:.9rem;<%= p.n === paso ? 'background:#0f766e;color:#fff' : 'background:#fff;border:1px solid #d1d5db;color:#374151' %>">
        <span style="opacity:.8"><%= p.n %>.</span> <%= p.titulo %>
      </a>
    </li>
    <% }); %>
  </ol>
</nav>
