<%- include('../Partials/layout-top', { title: 'Autorizaciones de asistencia', session }) %>
<%- include('partials/flujo-asistencia', { pasoActual: 3, fechaDesde: filtros.fechaDesde, fechaHasta: filtros.fechaHasta }) %>

<section class="page-header">
  <h1>Autorizaciones</h1>
  <p class="muted">
    Supervisor / RRHH: aprueba retardos, faltas, incompletos y horas extra del rango.
    Las horas extra solo piden aprobación desde <strong><%= typeof heMinutosParaAutorizar !== 'undefined' ? heMinutosParaAutorizar : 15 %> min</strong>.
    Por debajo, y la checada fuera del horario del turno, quedan como nota.
    El mínimo se cambia en la subsidiaria.
    La excepción de turno se solicita desde la ficha del colaborador.
  </p>
</section>

<% if (!empresa) { %>
<p>No hay empresa vinculada.</p>
<% } else { %>

<div class="toolbar">
  <a class="btn" href="/asistencia">← Hub asistencia</a>
</div>

<% const f = typeof filtros !== 'undefined' && filtros ? filtros : { fechaDesde: '', fechaHasta: '', departamentoId: '' }; %>
<form method="get" action="/asistencia-autorizaciones" class="form-grid" style="margin-bottom:1rem;align-items:end">
  <label>Desde
    <input type="date" name="fechaDesde" value="<%= f.fechaDesde %>" />
  </label>
  <label>Hasta
    <input type="date" name="fechaHasta" value="<%= f.fechaHasta %>" />
  </label>
  <label>Departamento
    <select name="departamentoId">
      <option value="">— Todos —</option>
      <% (departamentos || []).forEach(function(d) { %>
      <option value="<%= d._id %>" <%= String(d._id) === String(f.departamentoId) ? 'selected' : '' %>><%= d.nombre %></option>
      <% }); %>
    </select>
  </label>
  <button type="submit">Filtrar</button>
  <% if (f.departamentoId) { %>
  <a class="btn" href="/asistencia-autorizaciones?fechaDesde=<%= f.fechaDesde %>&amp;fechaHasta=<%= f.fechaHasta %>">Limpiar departamento</a>
  <% } %>
</form>
<% if (typeof rango !== 'undefined' && rango && rango.origen === 'periodo' && rango.periodoLabel) { %>
<p class="muted">Rango del período de pre-nómina: <strong><%= rango.periodoLabel %></strong>.</p>
<% } %>

<form method="post" action="/asistencia-autorizaciones/masiva" class="panel" style="margin-bottom:1rem">
  <h2 class="panel-title">Autorización masiva</h2>
  <p class="muted">
    Un motivo para todos los días del filtro que requieren decisión.
    No toca presente, descanso, vacaciones, horas extra bajo el mínimo, checadas fuera de horario ni lo ya decidido.
  </p>
  <input type="hidden" name="fechaDesde" value="<%= f.fechaDesde %>" />
  <input type="hidden" name="fechaHasta" value="<%= f.fechaHasta %>" />
  <input type="hidden" name="departamentoId" value="<%= f.departamentoId %>" />
  <label>Motivo
    <input name="motivoDecision" placeholder="Motivo para todo el rango" required />
  </label>
  <div style="display:flex;gap:.4rem;margin-top:.5rem">
    <button type="submit" name="decision" value="aprobar">Aprobar los que requieren</button>
    <button type="submit" name="decision" value="rechazar" class="btn-danger">Rechazar los que requieren</button>
  </div>
</form>

<% const lista = filas || []; %>
<h2><%= modoRango ? 'Registros del rango' : 'Pendientes' %> (<%= lista.length %>)</h2>
<% if (topeRango) { %>
<p class="muted">Se muestran los primeros 400. Acota el departamento o el rango.</p>
<% } %>
<table>
  <thead>
    <tr>
      <th>Fecha</th>
      <th>Colaborador</th>
      <th>Departamento</th>
      <th>Registro del día</th>
      <th>Solicitud</th>
      <th>Detalle</th>
      <th>Decisión</th>
    </tr>
  </thead>
  <tbody>
    <% if (!lista.length) { %>
    <tr><td colspan="7" class="muted"><%= modoRango ? 'No hay registros de asistencia ni solicitudes en este rango' : 'No hay pendientes' %><%= scope.mode === 'supervisor' ? ' en tu equipo' : '' %>.</td></tr>
    <% } %>
    <% lista.forEach(function(fila) {
         const p = fila.auth;
         const ymd = fila.fecha ? new Date(fila.fecha).toISOString().slice(0, 10) : '—';
         const dia = fila.daily;
    %>
    <tr id="<%= p ? 'auth-' + p._id : 'dia-' + ymd %>">
      <td><%= ymd %></td>
      <td><%= empMap.get(String(fila.empleadoId)) || '—' %></td>
      <td><%= (typeof deptoPorEmp !== 'undefined' && deptoPorEmp.get(String(fila.empleadoId))) || '—' %></td>
      <td class="small">
        <% if (dia) { %>
          <%= (estatusLabels && estatusLabels[dia.estatus]) || dia.estatus %>
          <% if (fila.clasificacion && fila.clasificacion.observacion) { %>
          <br /><span class="muted"><%= fila.clasificacion.observacion %></span>
          <% } else { %>
            <% if (dia.minutosRetardo) { %><br />Retardo <%= dia.minutosRetardo %> min<% } %>
            <% if (dia.minutosHorasExtra) { %><br />Horas extra <%= dia.minutosHorasExtra %> min<% } %>
          <% } %>
          <% if (dia.notas) { %><br /><span class="muted"><%= dia.notas %></span><% } %>
        <% } else { %>—<% } %>
      </td>
      <td>
        <% if (p) { %><span class="badge"><%= p.tipo %></span> <span class="muted small"><%= p.estado %></span><% } else { %><span class="muted">Sin solicitud</span><% } %>
      </td>
      <td class="small">
        <% if (p && p.tipo === 'retardo') { %>Retardo <%= p.minutosRetardo || 0 %> min<% } %>
        <% if (p && p.tipo === 'fuera_zona') { %>Fuera de geocerca<% } %>
        <% if (p && p.tipo === 'cambio_turno') { %>
          <%= p.esDescansoPropuesto ? 'Descanso' : 'Cambio de turno' %>
        <% } %>
        <% if (p && p.motivoSolicitud) { %><br /><span class="muted"><%= p.motivoSolicitud %></span><% } %>
      </td>
      <td>
        <%
          const clase = fila.clasificacion || { requiere: false, observacion: '' };
          const requiere = clase.requiere;
        %>
        <% if (p && p.estado === 'pendiente') { %>
        <form method="post" action="/asistencia-autorizaciones/<%= p._id %>/decidir" class="form-grid" style="min-width:220px">
          <input type="hidden" name="fechaDesde" value="<%= f.fechaDesde %>" />
          <input type="hidden" name="fechaHasta" value="<%= f.fechaHasta %>" />
          <input type="hidden" name="departamentoId" value="<%= f.departamentoId %>" />
          <input name="motivoDecision" placeholder="Motivo / comentario" required />
          <div style="display:flex;gap:.4rem">
            <button type="submit" name="decision" value="aprobar">Aprobar</button>
            <button type="submit" name="decision" value="rechazar" class="btn-danger">Rechazar</button>
          </div>
        </form>
        <% } else if (p) { %>
        <span class="muted small"><%= p.estado %><% if (p.motivoDecision) { %>: <%= p.motivoDecision %><% } %></span>
        <% } else if (requiere) { %>
        <form method="post" action="/asistencia-autorizaciones/dia/decidir" class="form-grid" style="min-width:220px">
          <input type="hidden" name="fechaDesde" value="<%= f.fechaDesde %>" />
          <input type="hidden" name="fechaHasta" value="<%= f.fechaHasta %>" />
          <input type="hidden" name="departamentoId" value="<%= f.departamentoId %>" />
          <input type="hidden" name="empleadoId" value="<%= fila.empleadoId %>" />
          <input type="hidden" name="fecha" value="<%= ymd %>" />
          <input name="motivoDecision" placeholder="Motivo / comentario" required />
          <div style="display:flex;gap:.4rem">
            <button type="submit" name="decision" value="aprobar">Aprobar</button>
            <button type="submit" name="decision" value="rechazar" class="btn-danger">Rechazar</button>
          </div>
        </form>
        <% } else if (clase.observacion) { %>
        <span class="muted small">Nota, sin autorización</span>
        <% } else { %>
        <span class="muted small">No requiere</span>
        <% } %>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>

<% } %>
<%- include('../Partials/layout-bottom') %>
