<%- include('../Partials/layout-top', { title: 'Marcaciones', session }) %>
<%- include('partials/flujo-asistencia', { pasoActual: 1, fechaDesde: fechaDesde, fechaHasta: fechaHasta }) %>
<h1>Marcaciones</h1>
<p class="page-subtitle">Revisa las checadas del rango. Registrar a mano y generar automáticas son acciones distintas.</p>
<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant.</p>
<% } else {
  const empF = typeof empleadoFiltro !== 'undefined' ? empleadoFiltro : '';
  const tipoSel = (typeof tipoPrefill !== 'undefined' && tipoPrefill) ? tipoPrefill : (empF ? 'salida' : 'entrada');
  const openCaptura = typeof mostrarCaptura !== 'undefined' && mostrarCaptura;
  const tipoLabel = {};
  (tiposMarcacion || []).forEach(function(t) { tipoLabel[t.value] = t.label; });
%>
<div class="toolbar" style="flex-wrap:wrap;gap:.5rem;align-items:flex-end">
  <form method="get" action="/asistencia-marcaciones" class="inline-form form-grid" style="max-width:none;display:flex;flex-wrap:wrap;gap:.5rem;align-items:flex-end">
    <label>Desde
      <input type="date" name="fechaDesde" value="<%= fechaDesde %>" />
    </label>
    <label>Hasta
      <input type="date" name="fechaHasta" value="<%= fechaHasta %>" />
    </label>
    <label>Empleado
      <select name="empleadoId">
        <option value="">— Todos —</option>
        <% empleados.forEach(function(e) { %>
        <option value="<%= e._id %>" <%= String(e._id) === String(empF) ? 'selected' : '' %>>
          <%= e.firstName %> <%= e.lastName %> (<%= e.numEmpleado %>)
        </option>
        <% }); %>
      </select>
    </label>
    <label>Anuladas
      <select name="anuladas">
        <% const modoA = typeof modoAnuladas !== 'undefined' ? modoAnuladas : 'activas'; %>
        <option value="" <%= modoA === 'activas' ? 'selected' : '' %>>Ocultar</option>
        <option value="incluir" <%= modoA === 'incluir' ? 'selected' : '' %>>Incluir en el listado</option>
        <option value="reporte" <%= modoA === 'reporte' ? 'selected' : '' %>>Solo reporte de anuladas</option>
      </select>
    </label>
    <button type="submit">Filtrar</button>
  </form>
  <a class="btn" href="/asistencia-diaria?fechaDesde=<%= fechaDesde %>&amp;fechaHasta=<%= fechaHasta %>">Asistencia del día</a>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin:0 0 1.25rem">
  <details id="captura" class="panel" style="margin:0;border-left:4px solid #0f766e" <%= openCaptura ? 'open' : '' %>>
    <summary style="cursor:pointer;font-weight:700">Registrar una checada a mano</summary>
    <p class="muted small">Una checada de un empleado, con la fecha y la hora que escribas. No genera el resto del turno.</p>
    <form method="post" action="/asistencia-marcaciones" class="form-grid" style="margin-top:.75rem">
      <label>Empleado
        <select name="empleadoId" required>
          <option value="">— Empleado —</option>
          <% empleados.forEach(function(e) { %>
          <option value="<%= e._id %>" <%= String(e._id) === String(empleadoPrefill || '') ? 'selected' : '' %>>
            <%= e.firstName %> <%= e.lastName %> (<%= e.numEmpleado %>)
          </option>
          <% }); %>
        </select>
      </label>
      <label>Tipo
        <select name="tipoMarcacion" required>
          <% tiposMarcacion.forEach(function(t) { %>
          <option value="<%= t.value %>" <%= t.value === tipoSel ? 'selected' : '' %>><%= t.label %></option>
          <% }); %>
        </select>
      </label>
      <label>Fecha y hora
        <input type="datetime-local" name="timestamp" id="marcacion-timestamp" value="<%= fecha %>T08:00" required />
      </label>
      <label class="inline-check">
        <input type="hidden" name="usarHoraServidor" value="0" />
        <input type="checkbox" name="usarHoraServidor" value="1" id="usarHoraServidor" />
        Usar la hora de este momento
      </label>
      <label>Motivo
        <input name="motivoHoraManual" id="marcacion-motivo" placeholder="Por qué no es la hora de este momento" required />
      </label>
      <label>Método
        <select name="metodo">
          <% metodosRegistro.forEach(function(m) { if (m.value === 'automatico') return; %>
          <option value="<%= m.value %>" <%= m.value === 'manual' ? 'selected' : '' %>><%= m.label %></option>
          <% }); %>
        </select>
      </label>
      <label>Notas
        <input name="notas" placeholder="Opcional" />
      </label>
      <button type="submit">Registrar esta checada</button>
    </form>
  </details>

  <details id="automaticas" class="panel" style="margin:0;border-left:4px solid #b45309">
    <summary style="cursor:pointer;font-weight:700">Generar checadas automáticas</summary>
    <% if (!rangoAuto) { %>
    <p class="muted" style="margin:.75rem 0 0">Elige una subsidiaria. El rango aleatorio de entrada y salida se define en esa plaza.</p>
    <% } else { %>
    <p class="muted small">
      <%= subsidiariaNombre %>: solo empleados con la casilla activa (<%= empleadosAuto %>).
      Entrada entre <%= rangoAuto.entradaAntesMin %> min antes y <%= rangoAuto.entradaDespuesMin %> min después del turno;
      salida entre <%= rangoAuto.salidaAntesMin %> min antes y <%= rangoAuto.salidaDespuesMin %> min después.
      No toca checadas de app, manuales ni ya corregidas.
      Los días de descanso se saltan. No genera días futuros. Máximo 62 días.
      <a href="/config-subsidiarias">Ajustar el rango de minutos</a>
    </p>
    <form method="post" action="/asistencia-marcaciones/automaticas" class="form-grid" style="margin-top:.75rem">
      <label>Desde
        <input type="date" name="fechaDesde" value="<%= fechaDesde %>" required />
      </label>
      <label>Hasta
        <input type="date" name="fechaHasta" value="<%= fechaHasta %>" required />
      </label>
      <label>Departamento
        <select name="departamentoId" id="auto-depto">
          <option value="">— Todos —</option>
          <% (departamentos || []).forEach(function(d) { %>
          <option value="<%= d._id %>"><%= d.nombre %></option>
          <% }); %>
        </select>
      </label>
      <label>Empleado
        <select name="empleadoId" id="auto-empleado">
          <option value="">— Todos —</option>
          <% empleados.forEach(function(e) { if (!e.marcacionAutomatica) return; %>
          <option value="<%= e._id %>" data-depto="<%= e.departamentoId || '' %>">
            <%= e.firstName %> <%= e.lastName %> (<%= e.numEmpleado %>)
          </option>
          <% }); %>
        </select>
      </label>
      <button type="submit">Generar / reprocesar el rango</button>
    </form>
    <% } %>
  </details>
</div>

<h2 style="margin-bottom:.35rem">Listado</h2>
<p class="muted small">
  Para cambiar hora o anular, abre la checada. El formulario de arriba no edita estas filas.
  <% if (modoA === 'reporte') { %>Este listado es solo de anuladas: no entran al cálculo.<% } %>
  <% if (modoA === 'incluir') { %>Las anuladas aparecen marcadas y no entran al cálculo.<% } %>
</p>

<table id="lista">
  <thead>
    <tr>
      <th>Fecha</th>
      <th>Hora</th>
      <th>Original</th>
      <th>Empleado</th>
      <th>Tipo</th>
      <th>Zona</th>
      <th>Estado</th>
      <th>Resumen día</th>
      <th>Rastro</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% if (!marcaciones.length) { %>
    <tr><td colspan="10" class="muted"><%= modoA === 'reporte' ? 'No hay marcaciones anuladas en este rango.' : 'Sin marcaciones para este filtro.' %> <% if (modoA !== 'reporte') { %><a href="#captura">Registrar una</a><% } %></td></tr>
    <% } %>
    <% marcaciones.forEach(function(m) {
         const ymdM = m.fecha ? new Date(m.fecha).toISOString().slice(0, 10) : '';
         const daily = dailyMap.get(String(m.empleadoId) + '|' + ymdM) || dailyMap.get(String(m.empleadoId));
         const estLabel = daily
           ? ((estatusDiarioLabels && estatusDiarioLabels[daily.estatus]) || daily.estatus)
           : 'Sin resumen';
         const anulada = m.estado === 'anulada';
         const tsOrig = m.timestampOriginal || m.timestamp;
         const dupKey = String(m.empleadoId) + '|' + ymdM + '|' + m.tipoMarcacion;
         const dupCount = (!anulada && dupKeyCount) ? (dupKeyCount.get(dupKey) || 0) : 0;
         const esUltimaUsada = daily && !anulada && m.tipoMarcacion === 'salida' && daily.salidaReal
           && new Date(daily.salidaReal).getTime() === new Date(m.timestamp).getTime();
         const esUltimaEntrada = daily && !anulada && m.tipoMarcacion === 'entrada' && daily.entradaReal
           && new Date(daily.entradaReal).getTime() === new Date(m.timestamp).getTime();
    %>
    <tr class="<%= anulada ? 'row-muted' : '' %>">
      <td><%= ymdM || '—' %></td>
      <td>
        <a href="/asistencia-marcaciones/<%= m._id %>"><%= formatTimeHHMM(m.timestamp, m.zonaHoraria) %></a>
        <% if (m.metodo === 'automatico') { %> <span class="badge" title="Generada con el rango de la subsidiaria">auto</span><% } %>
        <% if (m.origen === 'ajuste') { %> <span class="badge">ajuste</span><% } %>
        <% if (esUltimaUsada || esUltimaEntrada) { %> <span class="badge badge-activo" title="Esta es la checada que usa el resumen del día">en uso</span><% } %>
        <% if (dupCount > 1) { %> <span class="badge badge-suspendido" title="Hay varias del mismo tipo; el día usa la última">×<%= dupCount %></span><% } %>
      </td>
      <td class="muted small"><%= formatTimeHHMM(tsOrig, m.zonaHoraria) %></td>
      <td><%= empMap.get(String(m.empleadoId)) || '—' %></td>
      <td><%= tipoLabel[m.tipoMarcacion] || m.tipoMarcacion %></td>
      <td><%= (m.geocerca && m.geocerca.zonaNombre) || '—' %></td>
      <td>
        <span class="badge badge-<%= anulada ? 'suspendido' : 'activo' %>">
          <%= anulada ? 'Anulada' : 'Activa' %>
        </span>
      </td>
      <td>
        <span class="badge badge-<%= daily ? daily.estatus : 'falta' %>"><%= estLabel %></span>
        <% if (daily && daily.excedeLimiteDiario) { %>
        <span class="badge badge-suspendido" title="Art. 68">&gt;12 h</span>
        <% } %>
      </td>
      <td class="muted small">
        <% if (m.motivoAjuste) { %>Ajuste: <%= m.motivoAjuste %><% } %>
        <% if (m.motivoAnulacion) { %><%= m.motivoAjuste ? ' · ' : '' %>Anulación: <%= m.motivoAnulacion %><% } %>
        <% if (!m.motivoAjuste && !m.motivoAnulacion) { %><%= m.notas || '—' %><% } %>
      </td>
      <td>
        <% if (!anulada) { %>
        <a href="/asistencia-marcaciones/<%= m._id %>#corregir">Corregir</a>
        <% } else { %>
        <a href="/asistencia-marcaciones/<%= m._id %>">Ver</a>
        <% } %>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>

<% if (bitacora && bitacora.length) { %>
<details class="panel">
<summary style="cursor:pointer;font-weight:700">Bitácora del rango<%= empF ? ' (empleado filtrado)' : '' %></summary>
<table>
  <thead>
    <tr><th>Hora</th><th>Acción</th><th>Usuario</th><th>Motivo</th><th>Detalle</th></tr>
  </thead>
  <tbody>
    <% bitacora.forEach(function(b) { %>
    <tr>
      <td><%= formatTimeHHMM(b.createdAt, b.zonaHoraria) %></td>
      <td><code><%= b.accion %></code></td>
      <td><%= b.userLabel || b.userId || '—' %></td>
      <td><%= b.motivo || '—' %></td>
      <td class="muted small">
        <%= b.mensaje || '—' %>
        <% if (b.detalle && b.detalle.horaAntes && b.detalle.horaDespues) { %>
        · <%= formatTimeHHMM(b.detalle.horaAntes, b.zonaHoraria) %> → <%= formatTimeHHMM(b.detalle.horaDespues, b.zonaHoraria) %>
        <% } else if (b.antes && b.despues && b.antes.timestamp && b.despues.timestamp) { %>
        · <%= formatTimeHHMM(b.antes.timestamp, b.zonaHoraria) %> → <%= formatTimeHHMM(b.despues.timestamp, b.zonaHoraria) %>
        <% } %>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
</details>
<% } %>

<script>
(function () {
  var chk = document.getElementById('usarHoraServidor');
  var ts = document.getElementById('marcacion-timestamp');
  var mot = document.getElementById('marcacion-motivo');
  if (!chk || !ts) return;
  function sync() {
    var ahora = chk.checked;
    ts.disabled = ahora;
    ts.required = !ahora;
    if (mot) mot.required = !ahora;
  }
  chk.addEventListener('change', sync);
  sync();
})();
(function () {
  var paneles = ['captura', 'automaticas'];
  if (location.hash === '#automaticas') {
    var auto = document.getElementById('automaticas');
    if (auto) auto.open = true;
  }
  var autoDepto = document.getElementById('auto-depto');
  var autoEmp = document.getElementById('auto-empleado');
  function syncAutoEmp() {
    if (!autoDepto || !autoEmp) return;
    var id = autoDepto.value;
    Array.prototype.forEach.call(autoEmp.options, function (opt) {
      if (!opt.value) return;
      var ok = !id || opt.getAttribute('data-depto') === id;
      opt.hidden = !ok;
      opt.disabled = !ok;
      if (!ok && opt.selected) autoEmp.value = '';
    });
  }
  if (autoDepto) autoDepto.addEventListener('change', syncAutoEmp);
  syncAutoEmp();
  document.querySelectorAll('a[href="#captura"]').forEach(function (a) {
    a.addEventListener('click', function () {
      var captura = document.getElementById('captura');
      if (captura) captura.open = true;
    });
  });
  paneles.forEach(function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('toggle', function () {
      if (!el.open) return;
      paneles.forEach(function (otroId) {
        if (otroId === id) return;
        var otro = document.getElementById(otroId);
        if (otro) otro.open = false;
      });
    });
  });
})();
</script>
<% } %>
<%- include('../Partials/layout-bottom') %>
