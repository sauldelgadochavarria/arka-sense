<%- include('../Partials/layout-top', { title: 'Marcaciones', session }) %>
<h1>Registro de marcaciones</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant.</p>
<% } else { %>
<div class="toolbar">
  <form method="get" action="/asistencia-marcaciones" class="inline-form">
    <label>Fecha</label>
    <input type="date" name="fecha" value="<%= fecha %>" onchange="this.form.submit()" />
  </form>
  <a class="btn" href="/asistencia-diaria?fecha=<%= fecha %>">Ver asistencia del día</a>
  <form method="post" action="/asistencia-diaria/reprocesar?fecha=<%= fecha %>" class="inline-form">
    <button type="submit">Reprocesar día → asistencia</button>
  </form>
</div>

<p class="muted">
  Flujo: <strong>marcación</strong> → se genera/actualiza el <strong>resumen diario</strong>
  (presente / retardo / incompleto / …) → ese resumen alimenta el <strong>pre-cálculo</strong> del período.
  Solo con <em>entrada</em> el día suele quedar <strong>incompleto</strong> (no cuenta como día trabajado hasta registrar <em>salida</em>).
</p>

<table>
  <thead>
    <tr>
      <th>Hora</th>
      <th>Empleado</th>
      <th>Tipo</th>
      <th>Método</th>
      <th>Procesada</th>
      <th>Asistencia del día</th>
      <th>Notas</th>
    </tr>
  </thead>
  <tbody>
    <% if (!marcaciones.length) { %>
    <tr><td colspan="7" class="muted">Sin marcaciones para esta fecha.</td></tr>
    <% } %>
    <% marcaciones.forEach(function(m) {
         const daily = (typeof dailyMap !== 'undefined' && dailyMap) ? dailyMap.get(String(m.empleadoId)) : null;
         const estLabel = daily
           ? ((estatusDiarioLabels && estatusDiarioLabels[daily.estatus]) || daily.estatus)
           : 'Sin resumen (reprocesar)';
    %>
    <tr>
      <td><%= formatTimeHHMM(m.timestamp) %></td>
      <td><%= empMap.get(String(m.empleadoId)) || '—' %></td>
      <td><%= m.tipoMarcacion %></td>
      <td><%= m.metodo %></td>
      <td>
        <span class="badge badge-<%= m.procesado ? 'activo' : 'suspendido' %>">
          <%= m.procesado ? 'Sí' : 'Pendiente' %>
        </span>
      </td>
      <td>
        <span class="badge badge-<%= daily ? daily.estatus : 'falta' %>"><%= estLabel %></span>
        <% if (daily && daily.estatus === 'incompleto') { %>
        <span class="muted small">· falta salida</span>
        <% } %>
      </td>
      <td><%= m.notas || '—' %></td>
    </tr>
    <% }); %>
  </tbody>
</table>

<h2>Registrar marcación manual</h2>
<form method="post" action="/asistencia-marcaciones" class="form-grid form-wide">
  <select name="empleadoId" required>
    <option value="">— Empleado —</option>
    <% empleados.forEach(function(e) { %>
    <option value="<%= e._id %>"><%= e.firstName %> <%= e.lastName %> (<%= e.numEmpleado %>)</option>
    <% }); %>
  </select>
  <select name="tipoMarcacion" required>
    <% tiposMarcacion.forEach(function(t) { %>
    <option value="<%= t.value %>"><%= t.label %></option>
    <% }); %>
  </select>
  <input type="datetime-local" name="timestamp" required value="<%= fecha %>T08:00" />
  <select name="metodo">
    <% metodosRegistro.forEach(function(m) { %>
    <option value="<%= m.value %>" <%= m.value === 'manual' ? 'selected' : '' %>><%= m.label %></option>
    <% }); %>
  </select>
  <input name="notas" placeholder="Notas / justificación (opcional)" />
  <button type="submit">Registrar marcación</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
