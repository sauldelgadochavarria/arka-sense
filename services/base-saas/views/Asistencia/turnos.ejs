<%- include('../Partials/layout-top', { title: 'Turnos', session }) %>
<%- include('partials/flujo-asistencia', { pasoActual: 0, fecha: null }) %>

<div class="page-header" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:0.75rem">
  <div>
    <h1 style="margin:0">Turnos y horarios</h1>
    <p class="muted" style="margin:0.35rem 0 0">Horarios, tolerancias y esquema de jornada (46 / 9 / 12).</p>
  </div>
  <% if (empresa) { %>
  <a class="btn" href="/asistencia-turnos/nuevo">+ Nuevo turno</a>
  <% } %>
</div>

<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant. Activa el tenant desde Arka-Presence Admin.</p>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Tipo</th>
      <th>Horario</th>
      <th>Holgura</th>
      <th>Tolerancia</th>
      <th>Días</th>
      <th>Activo</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (!turnos.length) { %>
    <tr><td colspan="8" class="muted">No hay turnos. Crea el primero con <a href="/asistencia-turnos/nuevo">Nuevo turno</a>.</td></tr>
    <% } %>
    <% turnos.forEach(function(t) { %>
    <tr class="<%= !t.activo ? 'row-muted' : '' %>">
      <td><span class="color-dot" style="background:<%= t.color %>"></span> <%= t.nombre %></td>
      <td><%= labelTipoTurno(t.tipo) %></td>
      <td><%= t.horaEntrada %> – <%= t.horaSalida %></td>
      <td class="muted" style="font-size:0.9em"><%= describeVentana(t) %></td>
      <td><%= t.modoTolerancia || 'normal' %> · Ent. <%= t.toleranciaEntradaMin %>m</td>
      <td><%= (t.diasLaborables || []).map(function(d) { var item = diasSemana.find(function(x){ return x.value === d; }); return item ? item.short : d; }).join(', ') %></td>
      <td><%= t.activo ? 'Sí' : 'No' %></td>
      <td class="actions">
        <a href="/asistencia-turnos/<%= t._id %>/edit">Editar</a>
        <form method="post" action="/asistencia-turnos/<%= t._id %>/toggle" class="inline-form">
          <button type="submit"><%= t.activo ? 'Desactivar' : 'Activar' %></button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
<% } %>
<%- include('../Partials/layout-bottom') %>
