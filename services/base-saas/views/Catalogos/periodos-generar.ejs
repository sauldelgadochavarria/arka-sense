<%- include('../Partials/layout-top', { title: 'Generar períodos', session }) %>
<p><a href="/catalogos/periodos">← Administración de períodos</a></p>
<h1>Generar períodos del año</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada.</p>
<% } else { %>
<p class="muted">
  Completa los períodos que faltan desde la fecha y el número que indiques, hasta el 31 de diciembre.
  Elige si se crean en pre-nómina, en nómina o en ambas. Lo que ya exista en ese lado se omite.
  El calendario por días respeta la fecha inicial y no la recorre al lunes.
</p>

<form method="post" action="/catalogos/periodos/generar" class="form-grid form-wide" id="form-generar">
  <label>
    Tipo de período *
    <select name="tipoPeriodoId" id="tipoPeriodoId" required>
      <option value="">— Seleccione —</option>
      <% tiposPeriodo.forEach(function(tp) { %>
      <option value="<%= tp._id %>"
        data-motor="<%= tp.tipoMotor %>"
        data-dias="<%= tp.diasPeriodo %>"
        data-aplica-asistencia="<%= tp.aplicaAsistenciaPrenomina !== false ? '1' : '0' %>"
        data-compartir-nomina="<%= tp.compartirConNomina !== false ? '1' : '0' %>">
        <%= tp.codigoLegado %> — <%= tp.nombre %> (<%= tp.tipoMotor %>, <%= tp.diasPeriodo %> días)
      </option>
      <% }); %>
    </select>
  </label>
  <div id="tipo-flags-panel" class="info-panel tipo-periodo-resumen" hidden>
    <span class="flag-labels">
      <label class="flag-readonly" id="flag-aplica-asistencia">
        <input type="checkbox" disabled />
        Aplica asistencia/pre-nómina
      </label>
      <label class="flag-readonly" id="flag-compartir-nomina">
        <input type="checkbox" disabled />
        Compartir con nómina
      </label>
    </span>
    <p class="muted small">El tipo propone el destino. Puedes cambiarlo: esta generación crea solo el lado que elijas.</p>
  </div>
  <label>
    Generar en *
    <select name="destino" id="destino" required>
      <option value="ambos">Pre-nómina y nómina</option>
      <option value="prenomina">Solo pre-nómina</option>
      <option value="nomina">Solo nómina</option>
    </select>
  </label>
  <label>
    Año *
    <input type="number" name="anio" id="anio" min="2000" max="2100" value="<%= anioActual %>" required />
  </label>
  <label>
    Fecha inicial del primer período faltante *
    <input type="date" name="fechaInicial" id="fechaInicial" required />
  </label>
  <label>
    Número donde empieza *
    <input type="number" name="numeroInicial" id="numeroInicial" min="1" max="9999" required />
  </label>
  <p class="muted small" id="sugerencia-periodo"></p>
  <label>
    Tipo de nómina
    <select name="tipoNomina" id="tipoNomina">
      <optgroup label="Ordinarios">
        <% tiposNominaOrdinarios.forEach(function(tn) { %>
        <option value="<%= tn.value %>" <%= tn.value === 'ordinaria' ? 'selected' : '' %>><%= tn.label %></option>
        <% }); %>
      </optgroup>
      <optgroup label="Especiales / extraordinarios">
        <% tiposNominaExtra.forEach(function(tn) { %>
        <option value="<%= tn.value %>"><%= tn.label %></option>
        <% }); %>
      </optgroup>
    </select>
  </label>
  <input name="notas" placeholder="Notas (opcional)" />
  <button type="submit">Generar períodos pendientes</button>
</form>

<h2>Vista previa</h2>
<p class="muted">Revise las fechas antes de confirmar la generación.</p>
<button type="button" class="btn" id="btn-preview">Calcular vista previa</button>
<div id="preview-box" class="preview-box muted" style="margin-top:1rem"></div>

<script>
(function() {
  const selectTipo = document.getElementById('tipoPeriodoId');
  const panel = document.getElementById('tipo-flags-panel');
  const flagAsist = document.getElementById('flag-aplica-asistencia');
  const flagNomina = document.getElementById('flag-compartir-nomina');

  function syncTipoFlags() {
    const opt = selectTipo.options[selectTipo.selectedIndex];
    if (!opt || !opt.value) {
      panel.hidden = true;
      return;
    }
    const aplica = opt.dataset.aplicaAsistencia === '1';
    const compartir = opt.dataset.compartirNomina === '1';
    flagAsist.querySelector('input').checked = aplica;
    flagAsist.classList.toggle('is-on', aplica);
    flagNomina.querySelector('input').checked = compartir;
    flagNomina.classList.toggle('is-on', compartir);
    panel.hidden = false;
  }

  function destinoDelTipo() {
    const opt = selectTipo.options[selectTipo.selectedIndex];
    if (!opt || !opt.value) return 'ambos';
    const aplica = opt.dataset.aplicaAsistencia === '1';
    const compartir = opt.dataset.compartirNomina === '1';
    if (aplica && compartir) return 'ambos';
    if (compartir) return 'nomina';
    return 'prenomina';
  }

  selectTipo.addEventListener('change', function() {
    syncTipoFlags();
    document.getElementById('destino').value = destinoDelTipo();
    cargarSugerencia();
  });
  document.getElementById('anio').addEventListener('change', cargarSugerencia);
  document.getElementById('tipoNomina').addEventListener('change', cargarSugerencia);
  document.getElementById('destino').addEventListener('change', cargarSugerencia);
  syncTipoFlags();

  const nota = document.getElementById('sugerencia-periodo');
  function fmtUltimo(lado, row) {
    if (!row) return lado + ': sin períodos en ' + document.getElementById('anio').value;
    return lado + ' llega al #' + row.numeroPeriodo + ' (' + row.fechaInicio + ' – ' + row.fechaFin + ')';
  }
  async function cargarSugerencia() {
    const tipoPeriodoId = document.getElementById('tipoPeriodoId').value;
    const anio = document.getElementById('anio').value;
    const tipoNomina = document.getElementById('tipoNomina').value;
    const destino = document.getElementById('destino').value;
    if (!tipoPeriodoId || !anio) return;
    try {
      const q = new URLSearchParams({ tipoPeriodoId, anio, tipoNomina, destino });
      const res = await fetch('/catalogos/periodos/sugerencia?' + q.toString());
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Error');
      if (data.fechaInicial) document.getElementById('fechaInicial').value = data.fechaInicial;
      if (data.numeroInicial) document.getElementById('numeroInicial').value = data.numeroInicial;
      nota.textContent = fmtUltimo('Pre-nómina', data.prenomina) + '. ' + fmtUltimo('Nómina', data.nomina) + '.';
    } catch (e) {
      nota.textContent = e.message;
    }
  }

  const btn = document.getElementById('btn-preview');
  const box = document.getElementById('preview-box');
  const destinoLabel = { ambos: 'Pre-nómina y nómina', prenomina: 'Solo pre-nómina', nomina: 'Solo nómina' };
  function marca(aplica, crear, info) {
    if (!aplica) {
      return info && info.numeroPeriodo ? 'No se toca (existe #' + info.numeroPeriodo + ')' : 'No se genera';
    }
    if (crear) return 'Se crea';
    return 'Ya existe' + (info && info.numeroPeriodo ? ' (#' + info.numeroPeriodo + ')' : '');
  }
  btn.addEventListener('click', async function() {
    const tipoPeriodoId = document.getElementById('tipoPeriodoId').value;
    const anio = document.getElementById('anio').value;
    const fechaInicial = document.getElementById('fechaInicial').value;
    const numeroInicial = document.getElementById('numeroInicial').value;
    const tipoNomina = document.getElementById('tipoNomina').value;
    const destino = document.getElementById('destino').value;
    if (!tipoPeriodoId || !anio || !fechaInicial || !numeroInicial || !destino) {
      box.textContent = 'Complete tipo, destino, año, fecha inicial y número.';
      return;
    }
    box.textContent = 'Calculando…';
    try {
      const res = await fetch('/catalogos/periodos/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipoPeriodoId, anio, fechaInicial, numeroInicial, tipoNomina, destino })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Error');
      if (!data.bloques.length) {
        box.textContent = 'Sin períodos para esos datos.';
        return;
      }
      const tp = data.tipoPeriodo || {};
      const flagsHtml = tp.nombre
        ? '<p class="tipo-preview-flags"><strong>' + tp.codigoLegado + ' — ' + tp.nombre + '</strong> · ' +
          'Asistencia/pre-nómina: <strong>' + (tp.aplicaAsistenciaPrenomina ? 'Sí' : 'No') + '</strong> · ' +
          'Compartir nómina: <strong>' + (tp.compartirConNomina ? 'Sí' : 'No') + '</strong> · ' +
          'Esta generación: <strong>' + (destinoLabel[data.destino] || data.destino) + '</strong></p>'
        : '';
      box.innerHTML = flagsHtml + '<p><strong>' + data.porCrear + '</strong> de ' + data.total + ' bloques traen algo nuevo</p><table><thead><tr><th>#</th><th>Inicio</th><th>Fin</th><th>Pre-nómina</th><th>Nómina</th></tr></thead><tbody>' +
        data.bloques.map(function(b) {
          return '<tr><td>' + b.numeroPeriodo + '</td><td>' + b.fechaInicio + '</td><td>' + b.fechaFin + '</td><td>' +
            marca(b.aplicaPrenomina, b.crearPrenomina, b.prenomina) + '</td><td>' +
            marca(b.aplicaNomina, b.crearNomina, b.nomina) + '</td></tr>';
        }).join('') + '</tbody></table>';
    } catch (e) {
      box.textContent = e.message;
    }
  });
})();
</script>
<% } %>
<%- include('../Partials/layout-bottom') %>
