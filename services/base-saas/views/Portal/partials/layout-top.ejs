<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' — Portal' : 'Portal empleado' %></title>
  <link rel="stylesheet" href="/css/variables.css" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="app-shell">
  <%
    var soloPortal = false;
    if (typeof isSoloPortalUser !== 'undefined') {
      soloPortal = !!isSoloPortalUser;
    } else if (session && session.roles && session.roles.length) {
      var roles = session.roles;
      var tieneAdmin = roles.some(function(r) { return r.esAdmin || r.esAdminSistema || r.adminAccesoConfig; });
      soloPortal = !tieneAdmin && roles.every(function(r) { return r.nombre === 'Empleado' || r.esPortalEmpleado; });
    }
  %>
  <header class="topbar portal-bar">
    <div class="brand"><a href="/portal">Arka-Presence · Portal</a></div>
    <nav class="nav" aria-label="Portal">
      <%
        var ff = (typeof featureFlags !== 'undefined' && featureFlags) ? featureFlags : (session.featureFlags || {});
      %>
      <a href="/portal">Inicio</a>
      <% if (ff.asistencia !== false) { %><a href="/portal/asistencia">Mi asistencia</a><% } %>
      <a href="/portal/solicitudes">Mis solicitudes</a>
      <% if (ff.vacaciones) { %>
      <a href="/portal/vacaciones">Vacaciones</a>
      <%
        var caps = (typeof capabilities !== 'undefined' && capabilities) ? capabilities : (session.capabilities || {});
        if (caps.esSupervisor) {
      %>
      <a href="/portal/aprobaciones-vacaciones">Aprobaciones<% if (caps.pendientesAprobacionVacaciones) { %> (<%= caps.pendientesAprobacionVacaciones %>)<% } %></a>
      <% } %>
      <% } %>
      <% if (ff.recibos) { %><a href="/portal/recibos">Recibos</a><% } %>
      <% if (session.empleadoId && !soloPortal) { %><a href="/dashboard">Administración</a><% } %>
    </nav>
    <div class="user"><%= session.user %> · <a href="/logout">Salir</a></div>
  </header>
  <main class="content">
    <%- include('../../Partials/flash') %>
