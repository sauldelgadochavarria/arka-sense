<%- include('Partials/layout-top', { title: 'Inicio', session, menuTree }) %>
<%
  const ff = (typeof featureFlags !== 'undefined' && featureFlags) ? featureFlags : {};
  const hasNomina = !!ff.nomina;
  const hasGestDoc = !!ff.gestion_documental;
  const hasPersonal = ff.personal !== false;
  const hasAsistencia = !!ff.asistencia;
  const hasIncidencias = !!ff.incidencias;
  const hasPrenomina = !!ff.prenomina;
  const hasIntegraciones = !!ff.integraciones;
  const hasReportes = !!ff.reportes;
  const hasConfig = !!ff.config_admin;
%>

<div class="page-header">
  <h1>Bienvenido, <%= session.user %></h1>
  <p class="page-subtitle">
    <% if (tenant) { %>Organización: <strong><%= tenant.displayName %></strong><% } %>
    <% if (session.subsidiariaActiva) { %> · Subsidiaria: <strong><%= session.subsidiariaActiva.nombre %></strong> (<%= session.subsidiariaActiva.codigo %>)<% } %>
  </p>
</div>

<%- include('Partials/flujo-nomina', { flujoNomina, featureFlags: ff, flujoBasePath: typeof flujoBasePath !== 'undefined' ? flujoBasePath : '/dashboard' }) %>

<% if (typeof cumplimiento !== 'undefined' && cumplimiento && cumplimiento.filas) { %>
<%
  function cumpDot(c) {
    if (c === 'ok') return '🟢';
    if (c === 'atrasado') return '🔴';
    return '🟡';
  }
  function cumpClass(c) {
    if (c === 'ok') return 'cump-ok';
    if (c === 'atrasado') return 'cump-bad';
    return 'cump-warn';
  }
  const Ex = cumplimiento.expedientes || {};
%>
<section class="dashboard-kpis dash-section">
  <div class="section-header">
    <h2>Cumplimiento</h2>
    <a href="/nomina/gestion-documental">Ver tablero completo →</a>
  </div>
  <table class="data-table cump-table">
    <thead>
      <tr><th>Proceso</th><th>Periodo</th><th>Fecha límite</th><th>Estado</th></tr>
    </thead>
    <tbody>
      <% cumplimiento.filas.forEach(function(f) { %>
      <tr>
        <td><%= f.proceso %></td>
        <td><%= f.periodo %></td>
        <td><%= f.fechaLimite %></td>
        <td><span class="cump-pill <%= cumpClass(f.estado) %>"><%= cumpDot(f.estado) %> <%= f.estadoLabel %></span></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <p class="muted" style="margin-top:0.75rem">
    Expedientes completos: <strong><%= Ex.completos || 0 %>/<%= Ex.total || 0 %></strong>
    <% if (Ex.incompletos) { %> · <%= Ex.incompletos %> incompletos<% } %>
    <% if (Ex.vencidos) { %> · <%= Ex.vencidos %> con vigencia vencida<% } %>
  </p>
</section>
<% } %>

<% if (typeof kpis !== 'undefined' && kpis) { %>
<section class="dashboard-kpis dash-section">
  <div class="section-header">
    <h2>Indicadores del día</h2>
    <% if (hasReportes) { %><a href="/reportes/kpis">Ver dashboard completo →</a><% } %>
  </div>
  <div class="stats-grid">
    <div class="stat-card ok"><strong><%= kpis.asistenciaHoy.pct %>%</strong><span>Asistencia hoy</span></div>
    <div class="stat-card"><strong><%= kpis.empleadosActivos %></strong><span>Empleados activos</span></div>
    <div class="stat-card warn"><strong><%= kpis.incidenciasPendientes %></strong><span>Pendientes</span></div>
    <div class="stat-card"><strong><%= kpis.heMesMinutos %></strong><span>Min HE (mes)</span></div>
  </div>
  <% if (kpis.alertas.length) { %>
  <ul class="alert-list-compact">
    <% kpis.alertas.forEach(function(a) { %><li><%= a.texto %></li><% }); %>
  </ul>
  <% } %>
</section>
<% } %>

<section class="dash-section">
  <div class="section-header">
    <h2>Accesos directos y catálogos</h2>
    <span class="muted small">Según módulos activos en tu licencia</span>
  </div>
  <div class="card-grid">
    <% if (hasPersonal) { %>
    <div class="module-card">
      <h3><a href="/personal-empleados">Personal</a></h3>
      <p>Empleados, departamentos, puestos y empresa.</p>
      <ul>
        <li><a href="/personal-empleados">Empleados</a></li>
        <li><a href="/personal-departamentos">Departamentos</a></li>
        <li><a href="/config-empresa">Datos de empresa</a></li>
        <li><a href="/config-empresa/cargas">Cargas iniciales</a></li>
      </ul>
    </div>
    <% } %>

    <% if (hasAsistencia) { %>
    <div class="module-card">
      <h3><a href="/asistencia-diaria">Asistencia</a></h3>
      <p>Turnos, marcaciones y resumen diario.</p>
      <ul>
        <li><a href="/asistencia-turnos">Turnos</a></li>
        <li><a href="/asistencia-marcaciones">Marcaciones</a></li>
        <li><a href="/asistencia-diaria">Asistencia del día</a></li>
      </ul>
    </div>
    <% } %>

    <% if (hasIncidencias) { %>
    <div class="module-card">
      <h3><a href="/incidencias">Incidencias</a></h3>
      <p>Solicitudes, vacaciones y portal empleado.</p>
      <ul>
        <li><a href="/incidencias/pendientes">Bandeja pendientes</a></li>
        <li><a href="/incidencias/vacaciones">Vacaciones</a></li>
        <li><a href="/portal">Portal empleado</a></li>
      </ul>
    </div>
    <% } %>

    <% if (hasPrenomina) { %>
    <div class="module-card">
      <h3><a href="/prenomina-periodos">Pre-nómina</a></h3>
      <p>Períodos, cálculo y conceptos (asistencia).</p>
      <ul>
        <li><a href="/prenomina-periodos">Períodos</a></li>
        <li><a href="/prenomina-conceptos">Conceptos</a></li>
      </ul>
    </div>
    <% } %>

    <% if (hasNomina) { %>
    <div class="module-card">
      <h3><a href="/nomina">Nómina</a></h3>
      <p>Cálculo formal, conceptos fiscales y cierre.</p>
      <ul>
        <li><a href="/nomina">Inicio nómina</a></li>
        <li><a href="/nomina/periodos">Períodos</a></li>
        <li><a href="/nomina/conceptos">Conceptos</a></li>
        <li><a href="/nomina/finiquitos">Finiquitos</a></li>
        <li><a href="/nomina/configuracion">Configuración</a></li>
      </ul>
    </div>

    <div class="module-card">
      <h3><a href="/nomina/dispersion-bancaria">Dispersión y timbrado</a></h3>
      <p>Bancos, CFDI, correo y SUA.</p>
      <ul>
        <li><a href="/nomina/dispersion-bancaria">Dispersión bancaria</a></li>
        <li><a href="/nomina/timbrado">Timbrar CFDI</a></li>
        <li><a href="/nomina/sua">Exportar SUA</a></li>
        <li><a href="/nomina/reportes">Reportes nómina</a></li>
      </ul>
    </div>
    <% } %>

    <% if (hasGestDoc) { %>
    <div class="module-card">
      <h3><a href="/nomina/gestion-documental">Gestión documental</a></h3>
      <p>Expediente CFDI, SUA, impuestos y trabajadores.</p>
      <ul>
        <li><a href="/nomina/gestion-documental">Cumplimiento</a></li>
        <li><a href="/nomina/gestion-documental/expediente">Expediente</a></li>
        <li><a href="/nomina/gestion-documental/reporte">Cobertura</a></li>
        <li><a href="/nomina/gestion-documental/config">Storage</a></li>
      </ul>
    </div>
    <% } %>

    <% if (hasIntegraciones) { %>
    <div class="module-card">
      <h3><a href="/integraciones/perfiles">Integraciones</a></h3>
      <p>Perfiles y bitácora de conexiones.</p>
      <ul>
        <li><a href="/integraciones/perfiles">Perfiles</a></li>
        <li><a href="/integraciones/logs">Logs</a></li>
      </ul>
    </div>
    <% } %>

    <% if (hasReportes) { %>
    <div class="module-card">
      <h3><a href="/reportes">Reportes</a></h3>
      <p>KPIs, consultas operativas y exportación.</p>
      <ul>
        <li><a href="/reportes/kpis">Dashboard KPIs</a></li>
        <li><a href="/reportes">Centro de reportes</a></li>
      </ul>
    </div>
    <% } %>

    <% if (hasConfig) { %>
    <div class="module-card">
      <h3><a href="/config-users">Configuración</a></h3>
      <p>Usuarios, roles y subsidiarias.</p>
      <ul>
        <li><a href="/config-users">Usuarios</a></li>
        <li><a href="/config-roles">Roles</a></li>
        <li><a href="/config-subsidiarias">Subsidiarias</a></li>
      </ul>
    </div>
    <% } %>
  </div>
</section>

<script>
(function () {
  document.querySelectorAll('.flow-link[data-href]').forEach(function (el) {
    el.addEventListener('click', function (ev) {
      ev.preventDefault();
      ev.stopPropagation();
      window.location.href = el.getAttribute('data-href');
    });
  });
})();
</script>

<%- include('Partials/layout-bottom') %>
