<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' — Arka-Presence' : 'Arka-Presence' %></title>
  <link rel="stylesheet" href="/css/variables.css" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="app-shell">
  <header class="topbar<%= typeof portalMode !== 'undefined' && portalMode ? ' portal-bar' : '' %>">
    <div class="brand"><a href="/dashboard">Arka-Presence</a></div>
    <%
      const _menuPkgs = typeof menuPackages !== 'undefined' ? menuPackages : [];
      const _menuView = typeof menuModuleView !== 'undefined' ? menuModuleView : 'ambos';
      const _productPkgs = _menuPkgs.filter(function(p) { return p.id !== 'nucleo'; });
      const _showModuleSwitch = _productPkgs.length > 1;
    %>
    <% if (_showModuleSwitch) { %>
    <nav class="module-switch" aria-label="Módulo activo">
      <form method="post" action="/preferencias/modulo" class="module-switch-form">
        <button type="submit" name="view" value="ambos" class="module-chip<%= _menuView === 'ambos' ? ' is-active' : '' %>">Ambos</button>
        <% _productPkgs.forEach(function(p) { %>
        <button type="submit" name="view" value="<%= p.id %>" class="module-chip<%= _menuView === p.id ? ' is-active' : '' %>" title="<%= p.description || '' %>"><%= p.label %></button>
        <% }); %>
      </form>
    </nav>
    <% } %>
    <div class="topbar-meta">
      <% if (typeof session !== 'undefined' && session) { %>
        <a class="topbar-help" href="/ayuda" title="Centro de ayuda">Ayuda</a>
        <span><%= session.user %></span>
        <%
          const _empresas = typeof empresasDisponibles !== 'undefined' ? empresasDisponibles : [];
          const _subs = typeof subsidiariasDisponibles !== 'undefined' ? subsidiariasDisponibles : [];
          const _empAct = (typeof empresaActiva !== 'undefined' && empresaActiva)
            ? empresaActiva
            : (session.empresaActiva || null);
          const _subAct = session.subsidiariaActiva || null;
          const _empLabel = _empAct
            ? (_empAct.nombreComercial || _empAct.razonSocial || 'Empresa')
            : 'Sin empresa';
          const _showCtx = _empresas.length > 0 || _subs.length > 0 || _empAct || _subAct;
        %>
        <% if (_showCtx) { %>
        <details class="ctx-switch">
          <summary class="subsidiaria-tag ctx-switch-summary" title="Cambiar subsidiaria">
            <span class="ctx-switch-emp"><%= _empLabel %></span>
            <% if (_subAct) { %>
            <span class="ctx-switch-sub">· <%= _subAct.codigo %></span>
            <% } %>
          </summary>
          <div class="ctx-switch-menu">
            <% if (_subs.length) { %>
            <div class="ctx-switch-group">
              <% _subs.forEach(function(s) {
                const isActive = _subAct && String(_subAct._id) === String(s._id);
              %>
              <% if (isActive) { %>
              <div class="ctx-switch-item is-active"><strong><%= s.codigo %></strong> — <%= s.nombre %></div>
              <% } else { %>
              <form method="post" action="/cambiar-subsidiaria/<%= s._id %>" class="ctx-switch-form">
                <button type="submit" class="ctx-switch-item"><strong><%= s.codigo %></strong> — <%= s.nombre %></button>
              </form>
              <% } %>
              <% }); %>
            </div>
            <% } %>
          </div>
        </details>
        <% } %>
        <a href="/logout">Salir</a>
      <% } %>
    </div>
  </header>
  <div class="app-body">
    <% if (typeof menuTree !== 'undefined' && menuTree && menuTree.length) { %>
    <aside class="sidebar">
      <nav class="sidebar-nav" aria-label="Menú principal">
        <% menuTree.forEach(function(item) { %>
          <% if (item.esCategoria && item.children && item.children.length) { %>
          <div class="nav-section">
            <div class="nav-section-title"><%= item.menuPrincipal %></div>
            <% item.children.forEach(function(child) { %>
              <% if (child.children && child.children.length) { %>
              <div class="nav-subsection">
                <div class="nav-subsection-title"><%= child.menuPrincipal %></div>
                <% child.children.forEach(function(grand) { %>
                  <% if (grand.rutaApp || grand.rutaMenu) { %>
                  <a class="nav-link nav-link-sub" href="<%= grand.rutaApp || grand.rutaMenu %>"><%= grand.menuPrincipal %></a>
                  <% } %>
                <% }); %>
              </div>
              <% } else if (child.rutaApp || child.rutaMenu) { %>
              <a class="nav-link" href="<%= child.rutaApp || child.rutaMenu %>"><%= child.menuPrincipal %></a>
              <% } %>
            <% }); %>
          </div>
          <% } else if (!item.esCategoria && (item.rutaApp || item.rutaMenu)) { %>
          <a class="nav-link nav-link-root" href="<%= item.rutaApp || item.rutaMenu %>"><%= item.menuPrincipal %></a>
          <% } %>
        <% }); %>
      </nav>
    </aside>
    <% } %>
    <main class="content">
      <%- include('flash') %>
