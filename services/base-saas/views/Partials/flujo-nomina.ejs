<%
  const flujo = (typeof flujoNomina !== 'undefined' && flujoNomina) ? flujoNomina : null;
  const ff = (typeof featureFlags !== 'undefined' && featureFlags) ? featureFlags : {};
  const hasNomina = !!ff.nomina;
  const hasAsistencia = !!ff.asistencia;
  const hasPrenomina = !!ff.prenomina;
  const hasIncidencias = !!ff.incidencias;
  const hasReportes = !!ff.reportes;
  const showFlujo = hasAsistencia || hasPrenomina || hasIncidencias || hasNomina;
%>
<% if (showFlujo) { %>
<%
  const pasoActual = flujo && flujo.pasoActual ? Number(flujo.pasoActual) : 0;
  const pasosDone = new Set((flujo && flujo.pasosCompletados) || []);
  const pasoParcial = flujo && flujo.pasoParcial ? Number(flujo.pasoParcial) : 0;
  const cicloCompleto = !!(flujo && flujo.cicloCompleto);
  const periodosOpts = (flujo && flujo.periodos) || [];
  const periodoSel = flujo && flujo.periodo ? flujo.periodo.id : '';
  const acciones = (flujo && flujo.acciones) || [];
  const basePath = (typeof flujoBasePath !== 'undefined' && flujoBasePath) ? flujoBasePath : '/dashboard';

  const flujoPasos = [
    {
      n: 1,
      titulo: 'Asistencia',
      desc: 'Marcaciones, día y jornada',
      href: '/asistencia',
      visible: hasAsistencia,
      links: [
        { label: 'Inicio', href: '/asistencia' },
        { label: 'Del día', href: '/asistencia-diaria' },
        { label: 'Marcaciones', href: '/asistencia-marcaciones' },
        { label: 'Autorizar', href: '/asistencia-autorizaciones' }
      ]
    },
    {
      n: 2,
      titulo: 'Incidencias',
      desc: 'Autorizar faltas, vacaciones y HE',
      href: '/incidencias/pendientes',
      visible: hasAsistencia || hasIncidencias,
      links: [
        { label: 'Por autorizar', href: '/incidencias/pendientes' },
        { label: 'Vacaciones', href: '/incidencias/vacaciones', requireFeature: 'vacaciones' }
      ]
    },
    {
      n: 3,
      titulo: 'Pre-nómina',
      desc: 'Días, HE y excepciones del período',
      href: '/prenomina-periodos',
      visible: hasPrenomina || hasNomina || hasAsistencia,
      links: [
        { label: 'Períodos', href: '/prenomina-periodos' },
        { label: 'Movimientos', href: '/prenomina/movimientos' },
        { label: 'Conceptos', href: '/prenomina-conceptos' }
      ]
    },
    {
      n: 4,
      titulo: 'Cálculo',
      desc: 'Nómina formal e impuestos',
      href: hasNomina ? '/nomina/periodos' : '/nomina',
      requireNomina: true,
      visible: true,
      links: [
        { label: 'Períodos', href: '/nomina/periodos' },
        { label: 'Conceptos', href: '/nomina/conceptos' }
      ]
    },
    {
      n: 5,
      titulo: 'Revisión y cierre',
      desc: 'Auditar, validar y bloquear el período',
      href: flujo && flujo.periodo ? ('/nomina/periodos/' + flujo.periodo.id) : (hasNomina ? '/nomina/reportes' : '#'),
      requireNomina: true,
      visible: true,
      links: [
        { label: 'Reportes', href: '/nomina/reportes', requireNomina: true },
        { label: 'Acumulados', href: '/nomina/reportes/acumulados', requireNomina: true },
        { label: 'KPIs', href: '/reportes/kpis', requireFeature: 'reportes' },
        { label: 'Período', href: flujo && flujo.periodo ? ('/nomina/periodos/' + flujo.periodo.id) : '/nomina/periodos', requireNomina: true }
      ]
    },
    {
      n: 6,
      titulo: 'Bancos y CFDI',
      desc: 'Dispersión y timbrado',
      href: '/nomina/dispersion-bancaria',
      requireNomina: true,
      visible: true,
      links: [
        { label: 'Dispersión', href: '/nomina/dispersion-bancaria' },
        { label: 'Layouts', href: '/nomina/layouts-bancarios' },
        { label: 'Timbrar', href: '/nomina/timbrado' },
        { label: 'PDF', href: '/nomina/recibos-pdf' },
        { label: 'Correo', href: '/nomina/envio-correo' }
      ]
    }
  ];

  function pasoLocked(paso) {
    if (paso.requireNomina && !hasNomina) return true;
    return false;
  }

  if (flujo && flujo.href) {
    flujoPasos.forEach(function (p) {
      if (p.n === pasoActual) p.href = flujo.href;
    });
  }
%>

<section class="dash-flow">
  <div class="section-header flow-header-row">
    <div>
      <h2>Flujo del ciclo</h2>
      <span class="muted small"><%= hasAsistencia ? 'De la asistencia al CFDI' : 'De la pre-nómina al CFDI' %><% if (typeof session !== 'undefined' && session && session.subsidiariaActiva) { %> · <%= session.subsidiariaActiva.nombre %><% } %></span>
    </div>
    <% if (periodosOpts.length) { %>
    <form method="get" action="<%= basePath %>" class="flow-periodo-form">
      <label class="flow-periodo-label">
        <span class="muted small">Período</span>
        <select name="periodoId" onchange="this.form.submit()" aria-label="Seleccionar período">
          <% periodosOpts.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= String(p.id) === String(periodoSel) ? 'selected' : '' %>>
            <%= p.label %>
          </option>
          <% }); %>
        </select>
      </label>
    </form>
    <% } %>
  </div>

  <% if (flujo) { %>
  <p class="flow-status<%= cicloCompleto ? ' is-done' : '' %>">
    <% if (cicloCompleto) { %>
      <strong>Ciclo completo</strong> — <%= flujo.detalle %>
    <% } else { %>
      Estás en <strong><%= flujo.label %></strong>
      <% if (flujo.periodo && flujo.periodo.rango) { %>
        · período <%= flujo.periodo.numeroPeriodo != null ? '#' + flujo.periodo.numeroPeriodo : '' %>
        <%= flujo.periodo.rango %>
        (<%= flujo.periodo.estatus %>)
      <% } %>
      — <%= flujo.detalle %>
      <% if (flujo.href) { %>
        <a href="<%= flujo.href %>">Continuar →</a>
      <% } %>
    <% } %>
  </p>
  <% if (acciones.length) { %>
  <div class="flow-acciones">
    <% acciones.forEach(function(a) {
      if (a.tipo === 'post') { %>
    <form method="post" action="<%= a.href %>" class="inline-form"<%= a.confirm ? (' onsubmit="return confirm(\'' + String(a.confirm).replace(/'/g, "\\'") + '\')"') : '' %>>
      <input type="hidden" name="returnTo" value="<%= basePath %><%= periodoSel ? ('?periodoId=' + periodoSel) : '' %>" />
      <button type="submit" class="<%= a.className || 'btn' %>"><%= a.label %></button>
    </form>
    <% } else { %>
    <a class="<%= a.className || 'btn' %>" href="<%= a.href %>"><%= a.label %></a>
    <% } }); %>
  </div>
  <% } %>
  <% } %>

  <ol class="flow-track">
    <% flujoPasos.filter(function(p) { return p.visible !== false; }).forEach(function(paso, idx) {
      const locked = pasoLocked(paso);
      const isCurrent = !locked && pasoActual === paso.n;
      const isPartial = !locked && pasoParcial === paso.n && !cicloCompleto;
      const isDone = !locked && !isPartial && (pasosDone.has(paso.n) || (cicloCompleto && paso.n <= 6));
      let cls = 'flow-step';
      if (locked) cls += ' is-locked';
      if (isPartial) cls += ' is-partial';
      else if (isCurrent && !cicloCompleto) cls += ' is-current';
      if (isDone && !isCurrent) cls += ' is-done';
      if (cicloCompleto && isCurrent) cls += ' is-done is-current';
      const lockMsg = 'Activa el módulo Nómina';
    %>
    <li class="<%= cls %>">
      <% if (idx > 0) { %><span class="flow-arrow" aria-hidden="true">→</span><% } %>
      <a class="flow-card" href="<%= locked ? '#' : paso.href %>"<%= locked ? ' aria-disabled="true" tabindex="-1"' : '' %>>
        <span class="flow-num"><% if (isDone && !isPartial && !(isCurrent && !cicloCompleto)) { %>✓<% } else { %><%= paso.n %><% } %></span>
        <span class="flow-title"><%= paso.titulo %></span>
        <span class="flow-desc"><%= paso.desc %></span>
        <% if (isPartial) { %><span class="flow-badge is-parcial">Archivo bancario</span><% } %>
        <% if (isCurrent && !isPartial && !cicloCompleto) { %><span class="flow-badge">Ahora</span><% } %>
        <% if (!locked && paso.links && paso.links.length) { %>
        <span class="flow-links">
          <% paso.links.forEach(function(l) {
            if (l.requireNomina && !hasNomina) return;
            if (l.requireFeature && !ff[l.requireFeature]) return;
          %>
          <span class="flow-link" data-href="<%= l.href %>"><%= l.label %></span>
          <% }); %>
        </span>
        <% } else if (locked) { %>
        <span class="flow-desc muted"><%= lockMsg %></span>
        <% } %>
      </a>
    </li>
    <% }); %>
  </ol>
</section>
<% } %>
