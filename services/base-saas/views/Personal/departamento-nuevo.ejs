<%- include('../Partials/layout-top', { title: 'Nuevo departamento', session }) %>
<p><a href="/personal-departamentos">← Volver a lista</a></p>
<h1>Nuevo departamento</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada.</p>
<% } else { %>
<form method="post" action="/personal-departamentos" class="form-grid">
  <input name="nombre" placeholder="Nombre" required />
  <input name="codigoExterno" placeholder="Código externo" />
  <input name="codigoLegado" type="number" placeholder="Código legado Fortia (CLA_DEPTO)" />
  <input name="cuentaContableExterna" placeholder="Cuenta contable externa" />
  <input name="descripcion" placeholder="Descripción" />
  <select name="parentId">
    <option value="">— Sin departamento padre —</option>
    <% departamentos.forEach(function(d) { %>
    <option value="<%= d._id %>"><%= d.nombre %></option>
    <% }); %>
  </select>
  <button type="submit">Crear</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
