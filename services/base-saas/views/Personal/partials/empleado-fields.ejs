<%
  const dom = (empleado && empleado.domicilio) ? empleado.domicilio : {};
  const _entidades = (typeof entidadesFederativas !== 'undefined' && entidadesFederativas) ? entidadesFederativas : [];
  const _estadosCiviles = (typeof estadosCiviles !== 'undefined' && estadosCiviles) ? estadosCiviles : [];
  const _tiposSalario = (typeof tiposBaseCotizacion !== 'undefined' && tiposBaseCotizacion) ? tiposBaseCotizacion : [
    { value: 'fijo', label: 'Fija' },
    { value: 'variable', label: 'Variable' },
    { value: 'mixto', label: 'Mixta' }
  ];
  const apPat = empleado ? (empleado.apellidoPaterno || '') : '';
  const apMat = empleado ? (empleado.apellidoMaterno || '') : '';
  const lastFallback = empleado && !apPat && !apMat ? (empleado.lastName || '') : '';
%>
<fieldset class="form-section">
  <legend>Datos generales / identificación</legend>
  <input name="numEmpleado" placeholder="Código / No. empleado *" value="<%= empleado ? empleado.numEmpleado : '' %>" required />
  <input name="firstName" placeholder="Nombre(s) *" value="<%= empleado ? empleado.firstName : '' %>" required />
  <input name="apellidoPaterno" placeholder="Apellido paterno *" value="<%= apPat || lastFallback %>" required />
  <input name="apellidoMaterno" placeholder="Apellido materno" value="<%= apMat %>" />
  <input type="hidden" name="lastName" value="<%= empleado ? empleado.lastName : '' %>" />
  <label>Fecha de alta
    <input name="fechaIngreso" type="date" required value="<%= empleado && empleado.fechaIngreso ? toDateInputValue(empleado.fechaIngreso) : '' %>" />
  </label>  <select name="tipoContrato" required>
    <option value="">— Tipo de contrato * —</option>
    <% (tiposContrato || []).forEach(function(t) { %>
    <option value="<%= t.value %>" <%= empleado && empleado.tipoContrato === t.value ? 'selected' : (!empleado && t.value === 'indefinido' ? 'selected' : '') %>><%= t.label %></option>
    <% }); %>
  </select>
  <select name="tipoEmpleado">
    <option value="">— Tipo de empleado —</option>
    <% (tiposEmpleado || []).forEach(function(t) { %>
    <option value="<%= t.value %>" <%= empleado && empleado.tipoEmpleado === t.value ? 'selected' : '' %>><%= t.label %></option>
    <% }); %>
  </select>
  <p class="hint" style="grid-column:1/-1">
    <strong>Fecha de alta</strong> = inicio de la relación laboral.
    <strong>Tipo de contrato</strong> = modalidad jurídica.
    <strong>Tipo de empleado</strong> = confianza / sindicalizado
    (<a href="/config-sistema/enums/tipo_contrato" target="_blank">enums</a>).
  </p>
</fieldset>

<fieldset class="form-section">
  <legend>Información salarial (SDI / SBC)</legend>
  <label>Salario diario (parte fija)
    <input name="salarioDiario" type="number" min="0" step="0.01" placeholder="Ej. 500.00" value="<%= empleado && empleado.salarioDiario != null ? empleado.salarioDiario : '' %>" />
  </label>  <select name="tipoSalario" id="tipoSalario">
    <% _tiposSalario.forEach(function(t) { %>
    <option value="<%= t.value %>" <%= (empleado && (empleado.tipoSalario || 'fijo') === t.value) ? 'selected' : (!empleado && t.value === 'fijo' ? 'selected' : '') %>><%= t.label %></option>
    <% }); %>
  </select>
  <input name="sdi" id="campoSdi" type="number" min="0" step="0.01" placeholder="SDI — Salario Diario Integrado" value="<%= empleado && empleado.sdi > 0 ? empleado.sdi : '' %>" />
  <input type="text" id="sbcTopadoPreview" readonly placeholder="SBC topado (25×UMA) — se calcula al guardar / en nómina" value="" />
  <% if (empleado && empleado._id) { %>
  <div style="grid-column:1/-1;display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center">
    <button type="button" id="btnCalcularSdi" class="btn btn-secondary">Calcular SDI</button>
    <span id="sdiCalcMsg" class="muted small"></span>
    <a href="/personal/prestaciones" target="_blank" class="muted small">Tablas de prestaciones</a>
  </div>
  <pre id="sdiCalcDetalle" class="muted small" style="grid-column:1/-1;white-space:pre-wrap;display:none"></pre>
  <% } %>
  <p class="hint" style="grid-column:1/-1">
    <strong>Base de cotización</strong>: fija (SD × factor + extras diarios), variable (promedio 2 meses) o mixta.
    Factor LFT desde tabla (aguinaldo/vacaciones/prima). SGMM, vales, fondo, etc. se configuran como
    <em>otras prestaciones</em>.
    Resolución: <strong>tabla del empleado</strong> (si se asigna) → puesto → depto → tipo → global.
    <strong>SBC</strong> = <code>min(SDI, 25 × UMA)</code>.
  </p>
  <label style="grid-column:1/-1">Tabla de prestaciones
    <select name="tablaPrestacionesId">
      <option value="">— Automática (puesto → depto → tipo → global) —</option>
      <% (typeof tablasPrestaciones !== 'undefined' && tablasPrestaciones ? tablasPrestaciones : []).forEach(function(t) { %>
      <option value="<%= t._id %>" <%= empleado && empleado.tablaPrestacionesId && String(empleado.tablaPrestacionesId) === String(t._id) ? 'selected' : '' %>>
        <%= t.nombre %> (<%= t.ambito %><% if (t.primaVacacionalPct != null) { %> · prima <%= t.primaVacacionalPct %>%<% } %>)
      </option>
      <% }); %>
    </select>
  </label>
  <% if (empleado) { %>
  <select name="estatus">
    <% estatusOptions.forEach(function(o) { %>
    <option value="<%= o.value %>" <%= empleado.estatus === o.value ? 'selected' : '' %>><%= o.label %></option>
    <% }); %>
  </select>
  <input name="fechaBaja" type="date" value="<%= empleado.fechaBaja ? toDateInputValue(empleado.fechaBaja) : '' %>" />
  <select name="motivoBaja">
    <option value="">— Motivo baja —</option>
    <% motivosBaja.forEach(function(m) { %>
    <option value="<%= m %>" <%= empleado.motivoBaja === m ? 'selected' : '' %>><%= m %></option>
    <% }); %>
  </select>
  <% } %>
</fieldset>

<fieldset class="form-section">
  <legend>Datos para el IMSS</legend>
  <input name="nss" placeholder="NSS (Número de Seguridad Social)" value="<%= empleado ? empleado.nss : '' %>" />
  <input name="registroPatronal" placeholder="Registro patronal IMSS (si vacío usa el de la empresa)" maxlength="11" value="<%= empleado ? (empleado.registroPatronal || '') : '' %>" />
  <p class="muted small" style="grid-column:1/-1">
    El registro patronal es obligatorio para SUA/IDSE. Puede definirse aquí o en
    <a href="/config-empresa">Datos de empresa</a> (aplica a todos los empleados sin override).
  </p>
  <input name="umf" placeholder="UMF (Unidad de Medicina Familiar)" value="<%= empleado ? (empleado.umf || '') : '' %>" />
  <select name="estadoCivil">
    <option value="">— Estado civil —</option>
    <% _estadosCiviles.forEach(function(e) { %>
    <option value="<%= e.value %>" <%= empleado && empleado.estadoCivil === e.value ? 'selected' : '' %>><%= e.label %></option>
    <% }); %>
  </select>
</fieldset>

<fieldset class="form-section">
  <legend>Datos fiscales (RFC / CURP)</legend>
  <input name="rfc" placeholder="RFC" maxlength="13" pattern="[A-ZÑ&amp;]{3,4}[0-9]{6}[A-Z0-9]{3}" value="<%= empleado ? empleado.rfc : '' %>" />
  <input name="curp" placeholder="CURP" maxlength="18" pattern="[A-Z]{4}[0-9]{6}[HM][A-Z]{5}[A-Z0-9]{2}" value="<%= empleado ? empleado.curp : '' %>" />
  <select name="sexo">
    <option value="">— Sexo —</option>
    <option value="M" <%= empleado && empleado.sexo === 'M' ? 'selected' : '' %>>Masculino</option>
    <option value="F" <%= empleado && empleado.sexo === 'F' ? 'selected' : '' %>>Femenino</option>
    <option value="X" <%= empleado && empleado.sexo === 'X' ? 'selected' : '' %>>Otro</option>
  </select>
  <input name="fechaNacimiento" type="date" value="<%= empleado && empleado.fechaNacimiento ? toDateInputValue(empleado.fechaNacimiento) : '' %>" />
  <select name="entidadNacimiento">
    <option value="">— Entidad federativa de nacimiento —</option>
    <% _entidades.forEach(function(e) { %>
    <option value="<%= e.value %>" <%= empleado && empleado.entidadNacimiento === e.value ? 'selected' : '' %>><%= e.label %></option>
    <% }); %>
  </select>
  <input name="ciudadNacimiento" placeholder="Ciudad de nacimiento" value="<%= empleado ? (empleado.ciudadNacimiento || '') : '' %>" />
</fieldset>

<fieldset class="form-section">
  <legend>Domicilio del empleado</legend>
  <input name="domicilio_calle" placeholder="Calle / dirección" value="<%= dom.calle || '' %>" />
  <input name="domicilio_numeroExt" placeholder="No. exterior" value="<%= dom.numeroExt || '' %>" />
  <input name="domicilio_numeroInt" placeholder="No. interior" value="<%= dom.numeroInt || '' %>" />
  <input name="domicilio_colonia" placeholder="Colonia" value="<%= dom.colonia || '' %>" />
  <input name="domicilio_poblacion" placeholder="Población / ciudad" value="<%= dom.poblacion || '' %>" />
  <select name="domicilio_entidad" required>
    <option value="">— Entidad federativa (ISN) * —</option>
    <% _entidades.forEach(function(e) { %>
    <option value="<%= e.value %>" <%= dom.entidad === e.value ? 'selected' : '' %>><%= e.label %> (<%= e.value %>)</option>
    <% }); %>
  </select>
  <input name="domicilio_codigoPostal" placeholder="C.P. * (CFDI)" maxlength="5" pattern="[0-9]{5}" value="<%= dom.codigoPostal || '' %>" />
  <p class="muted small" style="grid-column:1/-1">
    La <strong>entidad federativa</strong> del domicilio determina el impuesto sobre nómina estatal (ISN).
  </p>
  <p class="hint" style="grid-column:1/-1">El <strong>código postal</strong> del trabajador es obligatorio para el timbrado del CFDI de nómina.</p>
</fieldset>

<fieldset class="form-section">
  <legend>Contacto</legend>
  <input name="email" type="email" placeholder="Email corporativo" value="<%= empleado ? empleado.email : '' %>" />
  <input name="emailPersonal" type="email" placeholder="Email personal" value="<%= empleado ? empleado.emailPersonal : '' %>" />
  <input name="telefono" placeholder="Teléfono celular" value="<%= empleado ? empleado.telefono : '' %>" />
  <input name="telefonoFijo" placeholder="Teléfono fijo" value="<%= empleado ? empleado.telefonoFijo : '' %>" />
</fieldset>

<fieldset class="form-section">
  <legend>Asignación organizacional</legend>
  <select name="subsidiariaId">
    <option value="">— Sucursal —</option>
    <% subsidiarias.forEach(function(s) { %>
    <option value="<%= s._id %>" <%= empleado && empleado.subsidiariaId && String(empleado.subsidiariaId) === String(s._id) ? 'selected' : '' %>><%= s.nombre %> (<%= s.codigo %>)</option>
    <% }); %>
  </select>
  <select name="departamentoId">
    <option value="">— Departamento —</option>
    <% departamentos.forEach(function(d) { %>
    <option value="<%= d._id %>" <%= empleado && empleado.departamentoId && String(empleado.departamentoId) === String(d._id) ? 'selected' : '' %>><%= d.nombre %></option>
    <% }); %>
  </select>
  <select name="centroCostoId">
    <option value="">— Centro de costo —</option>
    <% (centrosCosto || []).forEach(function(c) { %>
    <option value="<%= c._id %>" <%= empleado && empleado.centroCostoId && String(empleado.centroCostoId) === String(c._id) ? 'selected' : '' %>><%= c.codigo %> — <%= c.nombre %></option>
    <% }); %>
  </select>
  <select name="puestoId">
    <option value="">— Puesto —</option>
    <% puestos.forEach(function(p) { %>
    <option value="<%= p._id %>" <%= empleado && empleado.puestoId && String(empleado.puestoId) === String(p._id) ? 'selected' : '' %>><%= p.nombre %></option>
    <% }); %>
  </select>
  <select name="turnoId">
    <option value="">— Turno directo (sin plantilla) —</option>
    <% (turnos || []).forEach(function(t) { %>
    <option value="<%= t._id %>" <%= empleado && empleado.turnoId && String(empleado.turnoId) === String(t._id) ? 'selected' : '' %>><%= t.nombre %> (<%= t.horaEntrada %>-<%= t.horaSalida %>)</option>
    <% }); %>
  </select>
  <p class="hint">El turno directo aplica si no hay plantilla asignada, o como respaldo.</p>
  <select name="tipoPeriodoId">
    <option value="">— Tipo de período de pago —</option>
    <% (tiposPeriodo || []).forEach(function(tp) { %>
    <option value="<%= tp._id %>" <%= empleado && empleado.tipoPeriodoId && String(empleado.tipoPeriodoId) === String(tp._id) ? 'selected' : '' %>>
      <%= tp.nombre %> (<%= tp.tipoMotor %><% if (tp.codigoLegado != null) { %> · <%= tp.codigoLegado %><% } %>)
    </option>
    <% }); %>
  </select>
  <p class="hint">Define en qué periodicidad entra el empleado (semanal, quincenal, etc.). Se usa al calcular pre-nómina y nómina.</p>
  <select name="supervisorId">
    <option value="">— Supervisor —</option>
    <% supervisores.forEach(function(s) { %>
    <option value="<%= s._id %>" <%= empleado && empleado.supervisorId && String(empleado.supervisorId) === String(s._id) ? 'selected' : '' %>><%= s.firstName %> <%= s.lastName %></option>
    <% }); %>
  </select>
</fieldset>

<fieldset class="form-section">
  <legend>Plantilla de horario</legend>
  <select name="plantillaRotacionId" id="plantillaRotacionId">
    <option value="">— Sin plantilla (usar turno directo) —</option>
    <% (plantillas || []).forEach(function(p) { %>
    <option value="<%= p._id %>" <%= asignacionCtx && asignacionCtx.asignacion && String(asignacionCtx.asignacion.plantillaRotacionId) === String(p._id) ? 'selected' : '' %>>
      <%= p.nombre %> — <%= p.tipoLabel %>: <%= p.resumen %>
    </option>
    <% }); %>
  </select>
  <label id="labelFechaAncla">Fecha ancla del ciclo
    <input name="plantillaFechaAncla" type="date" id="plantillaFechaAncla"
      value="<%= asignacionCtx && asignacionCtx.asignacion && asignacionCtx.asignacion.fechaAncla ? toDateInputValue(asignacionCtx.asignacion.fechaAncla) : '' %>" />
  </label>
  <p class="hint">
    La plantilla (fija, secuencia o matriz) tiene prioridad sobre el turno directo.
    <a href="/asistencia-rotaciones" target="_blank">Gestionar plantillas</a>
  </p>
</fieldset>

<script>
(function () {
  const sel = document.getElementById('plantillaRotacionId');
  const label = document.getElementById('labelFechaAncla');
  const input = document.getElementById('plantillaFechaAncla');
  if (sel && label) {
    function sync() {
      const on = !!sel.value;
      label.style.display = on ? '' : 'none';
      if (on && input && !input.value) {
        input.value = new Date().toISOString().slice(0, 10);
      }
    }
    sel.addEventListener('change', sync);
    sync();
  }

  const uma = Number(<%= typeof umaVigente !== 'undefined' && umaVigente ? Number(umaVigente) : 0 %>) || 0;
  const topeUma = 25;
  const sdiEl = document.getElementById('campoSdi');
  const sdEl = document.querySelector('input[name="salarioDiario"]');
  const preview = document.getElementById('sbcTopadoPreview');
  function refreshSbc() {
    if (!preview) return;
    const sd = Number(sdEl && sdEl.value) || 0;
    const sdi = Number(sdiEl && sdiEl.value) || sd;
    if (!uma || !sdi) {
      preview.value = uma ? '' : 'UMA no disponible — SBC se calcula en nómina';
      return;
    }
    const tope = uma * topeUma;
    const sbc = Math.min(sdi, tope);
    preview.value = 'SBC topado: $' + sbc.toFixed(2) + ' (tope 25×UMA = $' + tope.toFixed(2) + ')';
  }
  if (sdiEl) sdiEl.addEventListener('input', refreshSbc);
  if (sdEl) sdEl.addEventListener('input', refreshSbc);
  refreshSbc();

  const btnSdi = document.getElementById('btnCalcularSdi');
  if (btnSdi) {
    btnSdi.addEventListener('click', async function () {
      const msg = document.getElementById('sdiCalcMsg');
      const det = document.getElementById('sdiCalcDetalle');
      msg.textContent = 'Calculando…';
      try {
        const tipo = document.getElementById('tipoSalario')?.value || 'fijo';
        const sd = document.querySelector('input[name="salarioDiario"]')?.value || '';
        const res = await fetch('<%= empleado && empleado._id ? "/personal-empleados/" + empleado._id + "/calcular-sdi" : "#" %>', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ tipoSalario: tipo, salarioDiario: sd, aplicar: false })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error');
        if (sdiEl) sdiEl.value = data.sdi;
        refreshSbc();
        msg.textContent = 'SDI $' + Number(data.sdi).toFixed(2) + ' · SBC $' + Number(data.sbc).toFixed(2) + ' (tabla: ' + (data.tabla && data.tabla.nombre) + ')';
        if (det) {
          det.style.display = '';
          det.textContent = JSON.stringify({
            tipo: data.tipoSalario,
            factor: data.factorIntegracion,
            parteFija: data.parteFija,
            extrasDiarios: data.extrasDiarios,
            otrasPrestaciones: data.otrasPrestaciones,
            promedioVariable: data.promedioVariable,
            tabla: data.tabla,
            formula: data.formula
          }, null, 2);
        }
      } catch (e) {
        msg.textContent = e.message || 'No se pudo calcular';
      }
    });
  }
})();
</script>

<fieldset class="form-section">
  <legend>Administración e integración</legend>
  <input name="codigoExterno" placeholder="Código externo (ERP / nómina)" value="<%= empleado ? (empleado.codigoExterno || '') : '' %>" />
  <select name="tipoRegistro" required>
    <% (tiposRegistro || []).forEach(function(t) { %>
    <option value="<%= t.value %>" <%= empleado ? (empleado.tipoRegistro === t.value ? 'selected' : '') : (t.value === 'rol_turnos' ? 'selected' : '') %>><%= t.label %></option>
    <% }); %>
  </select>
  <select name="grupoDispositivosId">
    <option value="">— Grupo de dispositivos —</option>
    <% (gruposDispositivos || []).forEach(function(g) { %>
    <option value="<%= g._id %>" <%= empleado && empleado.grupoDispositivosId && String(empleado.grupoDispositivosId) === String(g._id) ? 'selected' : '' %>><%= g.nombre %></option>
    <% }); %>
  </select>
  <select name="marcajePoliticaGeo">
    <% (politicasMarcajeGeo || []).forEach(function(p) { %>
    <option value="<%= p.value %>" <%= (empleado && empleado.marcajePoliticaGeo ? empleado.marcajePoliticaGeo : 'open_with_flag') === p.value ? 'selected' : '' %>><%= p.label %></option>
    <% }); %>
  </select>
  <fieldset class="form-section">
    <legend>Puntos de acceso fijos</legend>
    <p class="hint muted">Además de la geocerca de la sucursal y las asignaciones temporales. <a href="/config-puntos-acceso" target="_blank">Administrar catálogo</a></p>
    <% const puntosSel = empleado && Array.isArray(empleado.puntoAccesoIds) ? empleado.puntoAccesoIds.map(String) : []; %>
    <% if (!(puntosAcceso || []).length) { %>
    <p class="muted">No hay puntos activos. Crea alguno en Asistencia → Puntos de acceso.</p>
    <% } %>
    <% (puntosAcceso || []).forEach(function(p) { %>
    <label>
      <input type="checkbox" name="puntoAccesoIds" value="<%= p._id %>" <%= puntosSel.indexOf(String(p._id)) >= 0 ? 'checked' : '' %> />
      <%= p.nombre %> (<%= p.radioMetros %> m)
    </label>
    <% }); %>
  </fieldset>
  <div class="checkbox-group">
    <label><input type="checkbox" name="exportarFaltas" value="1" <%= !empleado || empleado.exportarFaltas !== false ? 'checked' : '' %> /> Exportar faltas a nómina</label>
    <label><input type="checkbox" name="exportarRetardos" value="1" <%= !empleado || empleado.exportarRetardos !== false ? 'checked' : '' %> /> Exportar retardos a nómina</label>
    <label><input type="checkbox" name="exportarHorasExtra" value="1" <%= !empleado || empleado.exportarHorasExtra !== false ? 'checked' : '' %> /> Exportar horas extra a nómina</label>
  </div>
</fieldset>

<% const dbanco = empleado && empleado.datosBancarios ? empleado.datosBancarios : {}; %>
<fieldset class="form-section">
  <legend>Datos bancarios (dispersión)</legend>
  <p class="hint">Usados por layouts bancarios (<code>empleado.banco</code>, <code>empleado.cuenta</code>, <code>empleado.clabe</code>).</p>
  <input name="banco_bancoCodigo" maxlength="5" placeholder="Código banco (ej. 012)" value="<%= dbanco.bancoCodigo || '' %>" />
  <input name="banco_bancoNombre" placeholder="Nombre banco" value="<%= dbanco.bancoNombre || '' %>" />
  <input name="banco_cuenta" placeholder="Cuenta" value="<%= dbanco.cuenta || '' %>" />
  <input name="banco_clabe" maxlength="18" placeholder="CLABE (18 dígitos)" value="<%= dbanco.clabe || '' %>" />
</fieldset>

<% if (typeof showNominaConfig !== 'undefined' && showNominaConfig) { %>
<% const nc = empleado && empleado.nominaConfig ? empleado.nominaConfig : {}; %>
<fieldset class="form-section">
  <legend>Nómina formal (INFONAVIT / FONACOT / fondo / finiquito)</legend>
  <p class="hint">Parámetros del motor (créditos, fondo de ahorro, finiquito). El SDI/SBC para IMSS está en «Información salarial».</p>

  <div class="checkbox-group">
    <label><input type="checkbox" name="nomina_aplicaFondoAhorro" value="1" <%= nc.aplicaFondoAhorro ? 'checked' : '' %> /> Aplica fondo de ahorro</label>
  </div>
  <input name="nomina_porcentajeFondoAhorro" type="number" min="0" max="100" step="0.01" placeholder="% fondo de ahorro (vacío = parámetro global)" value="<%= nc.porcentajeFondoAhorro > 0 ? nc.porcentajeFondoAhorro : '' %>" />

  <h3 class="form-subtitle">Despensa / vales (previsión social)</h3>
  <select name="nomina_despensaModalidad" id="nomina_despensaModalidad">
    <%
      const despensaMod = nc.despensaModalidad || ((nc.despensaMonto > 0 || nc.despensaMontoMensual > 0) ? 'fijo' : 'ninguna');
    %>
    <option value="ninguna" <%= despensaMod === 'ninguna' ? 'selected' : '' %>>Sin despensa</option>
    <option value="fijo" <%= despensaMod === 'fijo' ? 'selected' : '' %>>Importe fijo mensual</option>
    <option value="porcentaje" <%= despensaMod === 'porcentaje' ? 'selected' : '' %>>% del sueldo mensual + tope</option>
  </select>
  <input name="nomina_despensaMontoMensual" type="number" min="0" step="0.01" placeholder="Monto fijo mensual ($)" value="<%= (nc.despensaMontoMensual || nc.despensaMonto) > 0 ? (nc.despensaMontoMensual || nc.despensaMonto) : '' %>" />
  <input name="nomina_despensaPorcentaje" type="number" min="0" max="100" step="0.01" placeholder="% del sueldo mensual (ej. 10)" value="<%= nc.despensaPorcentaje > 0 ? nc.despensaPorcentaje : '' %>" />
  <select name="nomina_despensaTopeModo">
    <% const topeMod = nc.despensaTopeModo || 'imss_40_uma'; %>
    <option value="imss_40_uma" <%= topeMod === 'imss_40_uma' ? 'selected' : '' %>>Tope IMSS (40% UMA mensual ≈ $1,426)</option>
    <option value="uma_mensual" <%= topeMod === 'uma_mensual' ? 'selected' : '' %>>Tope 1 UMA mensual (previsión / deducible)</option>
    <option value="monto" <%= topeMod === 'monto' ? 'selected' : '' %>>Tope monto fijo</option>
    <option value="sin_tope" <%= topeMod === 'sin_tope' ? 'selected' : '' %>>Sin tope</option>
  </select>
  <input name="nomina_despensaTopeMonto" type="number" min="0" step="0.01" placeholder="Tope monto fijo (si aplica)" value="<%= nc.despensaTopeMonto > 0 ? nc.despensaTopeMonto : '' %>" />
  <p class="muted small" style="grid-column:1/-1">
    La despensa se paga cuando el <strong>período</strong> tiene «Paga despensa» (2ª quincena / 3ª semana habitualmente).
    El motor resuelve <code>despensaMonto</code> con fijo o % topado.
    ISR: exento hasta <strong>1 UMA mensual</strong> (~$3,566) si el pago es mensual; en semanal, <strong>7 × UMA diaria</strong>. El excedente grava.
  </p>

  <input name="nomina_seguroVidaMonto" type="number" min="0" step="0.01" placeholder="Seguro de vida (monto del período)" value="<%= nc.seguroVidaMonto > 0 ? nc.seguroVidaMonto : '' %>" />
  <input name="nomina_sgmmMonto" type="number" min="0" step="0.01" placeholder="SGMM (monto del período)" value="<%= nc.sgmmMonto > 0 ? nc.sgmmMonto : '' %>" />
  <p class="muted small" style="grid-column:1/-1">
    Tope exento fondo: menor entre % del salario y 1.3 × UMA mensual prorrateada.
    Vida / SGMM: montos del período (<code>seguroVidaMonto</code>, <code>sgmmMonto</code>).
  </p>

  <select name="nomina_tipoCreditoInfonavit" id="nomina_tipoCreditoInfonavit">
    <% (tiposCreditoInfonavit || []).forEach(function(t) { %>
    <option value="<%= t.value %>" <%= (nc.tipoCreditoInfonavit || '') === t.value ? 'selected' : '' %>><%= t.label %></option>
    <% }); %>
  </select>
  <input name="nomina_tasaInfonavit" type="number" min="0" step="0.0001" placeholder="Tasa / valor INFONAVIT (% o monto según tipo)" value="<%= nc.tasaInfonavit > 0 ? nc.tasaInfonavit : '' %>" />
  <input name="nomina_infonavitDescuento" type="number" min="0" step="0.01" placeholder="Descuento fijo por período (opcional, anula cálculo)" value="<%= nc.infonavitDescuento > 0 ? nc.infonavitDescuento : '' %>" />
  <input name="nomina_infonavitNumeroCredito" maxlength="10" placeholder="Núm. crédito INFONAVIT (SUA CRED.TXT)" value="<%= nc.infonavitNumeroCredito || '' %>" />
  <input name="nomina_infonavitFechaInicio" type="date" title="Fecha inicio descuento INFONAVIT" value="<%= nc.infonavitFechaInicio ? new Date(nc.infonavitFechaInicio).toISOString().slice(0,10) : '' %>" />
  <input name="nomina_sueldoIntegrado" type="number" min="0" step="0.01" placeholder="Base créditos del período (opcional)" value="<%= nc.sueldoIntegrado > 0 ? nc.sueldoIntegrado : '' %>" />
  <input name="nomina_diasCotizacionImss" type="number" min="0" step="1" placeholder="Override días cotización IMSS/créditos" value="<%= nc.diasCotizacionImss > 0 ? nc.diasCotizacionImss : '' %>" />

  <h3 class="form-subtitle">FONACOT (cédula de descuentos)</h3>
  <p class="muted small" style="grid-column:1/-1">
    Registra el monto o % de la cédula/portal FONACOT.
    Tope del crédito: <strong>10%</strong> si gana salario mínimo; hasta <strong>20%</strong> (10/15/20) si superior.
    La suma INFONAVIT + FONACOT no supera el <strong>30%</strong> del salario nominal del período (prioridad INFONAVIT).
    CFDI: clave deducción <code>011</code>.
  </p>
  <select name="nomina_tipoCreditoFonacot" id="nomina_tipoCreditoFonacot">
    <% (tiposCreditoFonacot || []).forEach(function(t) { %>
    <option value="<%= t.value %>" <%= (nc.tipoCreditoFonacot || '') === t.value ? 'selected' : '' %>><%= t.label %></option>
    <% }); %>
  </select>
  <input name="nomina_fonacotMonto" type="number" min="0" step="0.01" placeholder="Monto fijo del período ($)" value="<%= nc.fonacotMonto > 0 ? nc.fonacotMonto : '' %>" />
  <input name="nomina_fonacotPorcentaje" type="number" min="0" max="20" step="0.01" placeholder="% sobre bruto (10 / 15 / 20)" value="<%= nc.fonacotPorcentaje > 0 ? nc.fonacotPorcentaje : '' %>" />
  <input name="nomina_fonacotDescuento" type="number" min="0" step="0.01" placeholder="Override fijo período (opcional, anula cálculo)" value="<%= nc.fonacotDescuento > 0 ? nc.fonacotDescuento : '' %>" />

  <h3 class="form-subtitle">Cuota sindical (CCT / contrato)</h3>
  <p class="muted small" style="grid-column:1/-1">
    Deducción voluntaria <strong>después</strong> de ISR/IMSS/INFONAVIT/FONACOT (orden 70).
    Puedes incluirla en el <strong>tope 30%</strong> (prelación: INF → FON → sindicato) o dejarla fuera, según el contrato.
    La política default se define en <a href="/nomina/configuracion">Configuración fiscal</a>.
    CFDI: clave deducción <code>004</code> (Otros).
  </p>
  <select name="nomina_tipoCuotaSindical">
    <% (tiposCuotaSindical || []).forEach(function(t) { %>
    <option value="<%= t.value %>" <%= (nc.tipoCuotaSindical || '') === t.value ? 'selected' : '' %>><%= t.label %></option>
    <% }); %>
  </select>
  <input name="nomina_cuotaSindicalMonto" type="number" min="0" step="0.01" placeholder="Monto fijo del período ($)" value="<%= nc.cuotaSindicalMonto > 0 ? nc.cuotaSindicalMonto : '' %>" />
  <input name="nomina_cuotaSindicalPorcentaje" type="number" min="0" max="100" step="0.01" placeholder="% cuota sindical" value="<%= nc.cuotaSindicalPorcentaje > 0 ? nc.cuotaSindicalPorcentaje : '' %>" />
  <input name="nomina_cuotaSindicalDescuento" type="number" min="0" step="0.01" placeholder="Override fijo período (opcional)" value="<%= nc.cuotaSindicalDescuento > 0 ? nc.cuotaSindicalDescuento : '' %>" />
  <select name="nomina_cuotaSindicalBase">
    <% (cuotaSindicalBaseOpts || []).forEach(function(t) { %>
    <option value="<%= t.value %>" <%= (nc.cuotaSindicalBase || '') === t.value ? 'selected' : '' %>><%= t.label %></option>
    <% }); %>
  </select>
  <select name="nomina_cuotaSindicalEnTope30">
    <% (cuotaSindicalTope30Opts || []).forEach(function(t) { %>
    <option value="<%= t.value %>" <%= (nc.cuotaSindicalEnTope30 || '') === t.value ? 'selected' : '' %>><%= t.label %></option>
    <% }); %>
  </select>

  <h3 class="form-subtitle">Extraordinaria / finiquito</h3>
  <p class="muted small" style="grid-column:1/-1">
    <strong>Prima vacacional:</strong> el % sale de la tabla de prestaciones (o override abajo).
    Si capturas días aquí, se usan como override; si no, y el aniversario cae en el período, se usan los días de la tabla por antigüedad × %.
  </p>
  <input name="nomina_diasPrimaVacacional" type="number" min="0" step="0.01" placeholder="Días prima vacacional (override opcional)" value="<%= nc.diasPrimaVacacional > 0 ? nc.diasPrimaVacacional : '' %>" />
  <input name="nomina_primaVacacionalPct" type="number" min="0" max="100" step="0.01" placeholder="% prima (vacío = tabla)" value="<%= nc.primaVacacionalPct > 0 ? nc.primaVacacionalPct : '' %>" />
  <input name="nomina_proporcionAguinaldoFiniquito" type="number" min="0" step="0.01" placeholder="Monto aguinaldo finiquito" value="<%= nc.proporcionAguinaldoFiniquito > 0 ? nc.proporcionAguinaldoFiniquito : '' %>" />
  <input name="nomina_fondoAhorroSaldoFiniquito" type="number" min="0" step="0.01" placeholder="Saldo fondo de ahorro finiquito" value="<%= nc.fondoAhorroSaldoFiniquito > 0 ? nc.fondoAhorroSaldoFiniquito : '' %>" />
</fieldset>
<% } %>
