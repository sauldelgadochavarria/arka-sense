<%- include('../Partials/layout-top', { title: 'Puestos', session }) %>
<h1>Puestos</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant. Activa el tenant desde Arka-Presence Admin.</p>
<% } else { %>
<table>
  <thead><tr><th>Nombre</th><th>Cód. legado</th><th>Nivel</th><th>Descripción</th><th>Activo</th><th></th></tr></thead>
  <tbody>
    <% puestos.forEach(function(p) { %>
    <tr class="<%= !p.activo ? 'row-muted' : '' %>">
      <td><%= p.nombre %></td>
      <td><%= p.codigoLegado != null ? p.codigoLegado : '—' %></td>
      <td><%= p.nivel || '—' %></td>
      <td><%= p.descripcion || '—' %></td>
      <td><%= p.activo ? 'Sí' : 'No' %></td>
      <td class="actions">
        <a href="/personal-puestos/<%= p._id %>/edit">Editar</a>
        <form method="post" action="/personal-puestos/<%= p._id %>/toggle" class="inline-form">
          <button type="submit"><%= p.activo ? 'Desactivar' : 'Activar' %></button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>

<h2>Nuevo puesto</h2>
<form method="post" action="/personal-puestos" class="form-grid">
  <input name="nombre" placeholder="Nombre del puesto" required />
  <input name="codigoLegado" type="number" placeholder="Código legado Fortia (CLA_PUESTO)" />
  <input name="nivel" placeholder="Nivel (ej. Operativo, Gerencial)" />
  <input name="descripcion" placeholder="Descripción" />
  <button type="submit">Crear</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
