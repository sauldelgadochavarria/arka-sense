<%- include('../Partials/layout-top', { title: 'Editar empleado', session }) %>
<p><a href="/personal-empleados/<%= empleado._id %>">← Volver al expediente</a></p>

<h1>Editar empleado</h1>
<form method="post" action="/personal-empleados/<%= empleado._id %>" class="form-grid form-wide">
  <%- include('partials/empleado-fields', {
    empleado, subsidiarias, departamentos, puestos, turnos,
    tiposPeriodo: typeof tiposPeriodo !== 'undefined' ? tiposPeriodo : [],
    supervisores, gruposDispositivos, plantillas, asignacionCtx,
    tiposRegistro, tiposContrato,
    tiposEmpleado: typeof tiposEmpleado !== 'undefined' ? tiposEmpleado : [],
    estatusOptions, motivosBaja, toDateInputValue, showNominaConfig, tiposCreditoInfonavit
  }) %>
  <button type="submit">Guardar cambios</button>
</form>
<%- include('../Partials/layout-bottom') %>
