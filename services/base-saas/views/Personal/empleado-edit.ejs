<%- include('../Partials/layout-top', { title: 'Editar empleado', session }) %>
<p><a href="/personal-empleados/<%= empleado._id %>">← Volver al expediente</a></p>

<h1>Editar empleado</h1>
<form method="post" action="/personal-empleados/<%= empleado._id %>" class="form-fichas">
  <%- include('partials/empleado-fields', {
    empleado, subsidiarias, departamentos, puestos, turnos,
    centrosCosto: typeof centrosCosto !== 'undefined' ? centrosCosto : [],
    tiposPeriodo: typeof tiposPeriodo !== 'undefined' ? tiposPeriodo : [],
    supervisores, gruposDispositivos, plantillas, asignacionCtx,
    tiposRegistro, tiposContrato,
    tiposEmpleado: typeof tiposEmpleado !== 'undefined' ? tiposEmpleado : [],
    estatusOptions, motivosBaja, toDateInputValue, showNominaConfig, tiposCreditoInfonavit,
    entidadesFederativas: typeof entidadesFederativas !== 'undefined' ? entidadesFederativas : [],
    estadosCiviles: typeof estadosCiviles !== 'undefined' ? estadosCiviles : [],
    tiposBaseCotizacion: typeof tiposBaseCotizacion !== 'undefined' ? tiposBaseCotizacion : [],
    umaVigente: typeof umaVigente !== 'undefined' ? umaVigente : 0
  }) %>
  <div class="ficha-savebar">
    <button type="submit">Guardar cambios</button>
  </div>
</form>
<form id="form-acceso-portal" method="post" action="/personal-empleados/<%= empleado._id %>/acceso-portal"></form>
<form id="form-documentacion" method="post" action="/nomina/gestion-documental/subir" enctype="multipart/form-data"></form>
<%- include('../Partials/layout-bottom') %>
