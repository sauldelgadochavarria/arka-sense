<%- include('../Partials/layout-top', { title: 'Nuevo empleado', session }) %>
<p><a href="/personal-empleados">← Volver al listado</a></p>
<h1>Nuevo empleado</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant. Activa el tenant desde Arka-Presence Admin.</p>
<% } else { %>
<form method="post" action="/personal-empleados" class="form-fichas">
  <%- include('partials/empleado-fields', {
    empleado: null,
    subsidiarias, departamentos, puestos, turnos,
    centrosCosto: typeof centrosCosto !== 'undefined' ? centrosCosto : [],
    tiposPeriodo: typeof tiposPeriodo !== 'undefined' ? tiposPeriodo : [],
    supervisores, gruposDispositivos, plantillas,
    asignacionCtx: null,
    tiposRegistro,
    tiposContrato,
    tiposEmpleado: typeof tiposEmpleado !== 'undefined' ? tiposEmpleado : [],
    toDateInputValue,
    showNominaConfig,
    tiposCreditoInfonavit,
    entidadesFederativas: typeof entidadesFederativas !== 'undefined' ? entidadesFederativas : [],
    estadosCiviles: typeof estadosCiviles !== 'undefined' ? estadosCiviles : [],
    tiposBaseCotizacion: typeof tiposBaseCotizacion !== 'undefined' ? tiposBaseCotizacion : [],
    umaVigente: typeof umaVigente !== 'undefined' ? umaVigente : 0
  }) %>
  <div class="ficha-savebar">
    <button type="submit">Crear empleado</button>
  </div>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
