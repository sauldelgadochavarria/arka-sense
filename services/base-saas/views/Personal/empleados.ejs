<%- include('../Partials/layout-top', { title: 'Empleados', session }) %>
<h1>Empleados</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant. Activa el tenant desde Arka-Presence Admin.</p>
<% } else { %>
<div class="toolbar">
  <form method="get" action="/personal-empleados" class="inline-form">
    <label>Estatus</label>
    <select name="estatus" onchange="this.form.submit()">
      <option value="activo" <%= estatus === 'activo' ? 'selected' : '' %>>Activos</option>
      <option value="suspendido" <%= estatus === 'suspendido' ? 'selected' : '' %>>Suspendidos</option>
      <option value="baja" <%= estatus === 'baja' ? 'selected' : '' %>>Baja</option>
      <option value="todos" <%= estatus === 'todos' ? 'selected' : '' %>>Todos</option>
    </select>
  </form>
</div>

<table>
  <thead>
    <tr>
      <th>No.</th>
      <th>Cód. ext.</th>
      <th>Nombre</th>
      <th>RFC</th>
      <th>Sucursal</th>
      <th>Departamento</th>
      <th>Puesto</th>
      <th>Período</th>
      <th>Ingreso</th>
      <th>Estatus</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (!empleados.length) { %>
    <tr><td colspan="11" class="muted">No hay empleados con este filtro.</td></tr>
    <% } %>
    <% empleados.forEach(function(e) { %>
    <tr class="<%= e.estatus !== 'activo' ? 'row-muted' : '' %>">
      <td><code><%= e.numEmpleado %></code></td>
      <td><%= e.codigoExterno || '—' %></td>
      <td><a href="/personal-empleados/<%= e._id %>"><%= e.firstName %> <%= e.lastName %></a></td>
      <td><%= e.rfc || '—' %></td>
      <td><%= e.subsidiariaId ? (subMap.get(String(e.subsidiariaId)) || '—') : '—' %></td>
      <td><%= e.departamentoId ? (deptMap.get(String(e.departamentoId)) || '—') : '—' %></td>
      <td><%= e.puestoId ? (puestoMap.get(String(e.puestoId)) || '—') : '—' %></td>
      <td><%= e.tipoPeriodoId && tipoPeriodoMap ? (tipoPeriodoMap.get(String(e.tipoPeriodoId)) || '—') : '—' %></td>
      <td><%= e.fechaIngreso ? new Date(e.fechaIngreso).toLocaleDateString('es-MX') : '—' %></td>
      <td><span class="badge badge-<%= e.estatus %>"><%= e.estatus %></span></td>
      <td class="actions">
        <a href="/personal-empleados/<%= e._id %>/edit">Editar</a>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>

<h2>Nuevo empleado</h2>
<form method="post" action="/personal-empleados" class="form-grid form-wide">
  <%- include('partials/empleado-fields', {
    empleado: null,
    subsidiarias, departamentos, puestos, turnos,
    tiposPeriodo: typeof tiposPeriodo !== 'undefined' ? tiposPeriodo : [],
    supervisores, gruposDispositivos, plantillas,
    asignacionCtx: null,
    tiposRegistro,
    tiposContrato,
    tiposEmpleado: typeof tiposEmpleado !== 'undefined' ? tiposEmpleado : [],
    toDateInputValue,
    showNominaConfig,
    tiposCreditoInfonavit
  }) %>
  <button type="submit">Crear empleado</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
