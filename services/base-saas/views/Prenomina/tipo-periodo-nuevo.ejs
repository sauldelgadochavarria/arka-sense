<%- include('../Partials/layout-top', { title: 'Nuevo tipo de período', session }) %>
<p><a href="/prenomina/tipos-periodo">← Volver a lista</a></p>
<h1>Nuevo tipo de período</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada.</p>
<% } else { %>
<form method="post" action="/prenomina/tipos-periodo" class="form-grid form-wide">
  <input name="codigoLegado" type="number" placeholder="Código legado (CLA_PERIODO)" required />
  <input name="codigoExterno" placeholder="Código externo" />
  <input name="nombre" placeholder="Nombre (NOM_PERIODO)" required />
  <select name="tipoMotor" required>
    <% tiposMotor.forEach(function(t) { %>
    <option value="<%= t.value %>"><%= t.label %></option>
    <% }); %>
  </select>
  <input name="diasPeriodo" type="number" min="1" placeholder="Días período (DIAS_PER)" />
  <input name="diasLaborables" type="number" min="0" placeholder="Días laborables (DIAS_LAB)" />
  <input name="leyenda" placeholder="Leyenda (LEYENDA_PER)" />
  <select name="periodicidadPagoSat">
    <option value="">— Periodicidad SAT —</option>
    <% periodicidadSat.forEach(function(p) { %>
    <option value="<%= p.value %>"><%= p.value %> — <%= p.label %></option>
    <% }); %>
  </select>
  <label><input type="checkbox" name="esSeptimo" value="1" /> Es séptimo día (ES_SEPTIMO)</label>
  <label><input type="checkbox" name="aplicaAsistenciaPrenomina" value="1" checked /> Aplica asistencia/pre-nómina</label>
  <label><input type="checkbox" name="compartirConNomina" value="1" checked /> Compartir con nómina</label>
  <button type="submit">Crear tipo</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
