<%- include('../Partials/layout-top', { title: 'Nuevo tipo de período', session }) %>
<p><a href="/prenomina/tipos-periodo">← Volver a lista</a></p>
<h1>Nuevo tipo de período</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada.</p>
<% } else { %>
<p class="muted">Define un tipo (semanal, quincenal, mensual…) con su código interno y parámetros de pago.</p>
<form method="post" action="/prenomina/tipos-periodo" class="form-grid form-wide">
  <%- include('partials/tipo-periodo-fields', { tipo: null, tiposMotor, periodicidadSat, sugeridoCodigoLegado, codigosOcupadosJson, diasSemanaOpts, modosCalendario }) %>
  <button type="submit">Crear tipo</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
