<%- include('../Partials/layout-top', { title: 'Nuevo tipo de período', session }) %>
<% const _base = typeof catalogBase !== 'undefined' && catalogBase ? catalogBase : '/prenomina/tipos-periodo'; %>
<p><a href="<%= _base %>">← Volver a lista</a></p>
<h1>Nuevo tipo de período</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada.</p>
<% } else { %>
<p class="muted">
  Catálogo compartido prenómina/nómina
  <% if (typeof subsidiariaId !== 'undefined' && subsidiariaId) { %>· subsidiaria activa<% } %>.
  Define días del período, laborables y séptimo día.
</p>
<form method="post" action="<%= _base %>" class="form-grid form-wide">
  <%- include('partials/tipo-periodo-fields', { tipo: null, tiposMotor, periodicidadSat, sugeridoCodigoLegado, codigosOcupadosJson, diasSemanaOpts, modosCalendario }) %>
  <button type="submit">Crear tipo</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
