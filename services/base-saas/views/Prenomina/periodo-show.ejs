<%- include('../Partials/layout-top', { title: 'Período de pre-nómina', session }) %>
<h1>Período <%= periodo.tipo %></h1>
<p>
  <strong><%= new Date(periodo.fechaInicio).toLocaleDateString('es-MX') %></strong>
  al
  <strong><%= new Date(periodo.fechaFin).toLocaleDateString('es-MX') %></strong>
  <% if (periodo.fechaPago) { %>
  · Pago: <strong><%= new Date(periodo.fechaPago).toLocaleDateString('es-MX') %></strong>
  <% } %>
  · Estatus: <span class="badge badge-<%= periodo.estatus === 'cerrado' ? 'baja' : periodo.estatus === 'pendiente' ? 'suspendido' : periodo.estatus === 'borrador' ? 'activo' : 'alta' %>"><%= estatusLabels[periodo.estatus] || periodo.estatus %></span>
  <% if (periodo.numeroPeriodo) { %> · #<%= periodo.numeroPeriodo %> / <%= periodo.anio || '' %><% } %>
</p>

<%- include('../Partials/periodo-config-panel', {
  aplicaAsistencia: periodo.aplicaAsistenciaPrenomina !== false,
  compartirNomina: periodo.compartirConNomina === true,
  nota: 'Configuración guardada en este período al generarlo (snapshot del tipo de período).'
}) %>

<% if (periodo.estatus === 'pendiente') { %>
<div class="alert alert-warning">
  Este período está <strong>pendiente</strong>. Ábrelo para poder calcular asistencia / pre-cálculo.
  <form method="post" action="/prenomina-periodos/<%= periodo._id %>/abrir" class="inline-form" style="display:inline;margin-left:.5rem">
    <button type="submit">Abrir período</button>
  </form>
  · o desde <a href="/catalogos/periodos">Administración de períodos</a>.
</div>
<% } %>

<% if (preflight && !preflight.ok) { %>
<div class="alert alert-warning">
  <strong><%= periodo.estatus === 'borrador' ? 'Cierre bloqueado (preflight 422)' : 'Atención antes de cerrar (preflight)' %></strong>
  <ul>
    <% if (preflight.sinCodigo && preflight.sinCodigo.length) { %>
    <li><%= preflight.sinCodigo.length %> empleado(s) sin código externo / núm. empleado:
      <ul>
        <% preflight.sinCodigo.forEach(function(e) { %>
        <li><a href="/personal-empleados/<%= e._id %>/edit"><%= e.nombre %></a> (No. <%= e.numEmpleado || '—' %>)</li>
        <% }); %>
      </ul>
    </li>
    <% } %>
    <% (preflight.bloqueos || []).forEach(function(b) { %>
    <li><code><%= b.codigo %></code> — <%= b.mensaje %></li>
    <% }); %>
  </ul>
</div>
<% } else if (preflight && preflight.ok && periodo.estatus === 'borrador') { %>
<p class="muted small">Pre-flight de cierre OK — puedes cerrar el período.</p>
<% } %>
<% if (preflight && preflight.advertencias && preflight.advertencias.length) { %>
<div class="alert alert-warning">
  <strong>Advertencias (no bloquean el cálculo; pueden bloquear el cierre):</strong>
  <ul>
    <% preflight.advertencias.forEach(function(a) { %>
    <li><code><%= a.codigo %></code> — <%= a.mensaje %>
      <% if (a.detalle && a.detalle.length && (a.codigo === 'ASIS_INCOMPLETA_EN_CURSO' || a.codigo === 'ASIS_INCOMPLETA')) { %>
      <ul>
        <% a.detalle.forEach(function(d) {
          const ymd = d.fecha ? new Date(d.fecha).toISOString().slice(0, 10) : '';
        %>
        <li>
          <%= d.nombre || '—' %><% if (d.numEmpleado) { %> #<%= d.numEmpleado %><% } %>
          · <a href="/asistencia-diaria?fecha=<%= ymd %>&amp;periodoId=<%= periodo._id %>"><%= ymd %></a>
          · <%= (estatusDiarioLabels && estatusDiarioLabels[d.estatus]) || d.estatus %>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </li>
    <% }); %>
  </ul>
  <p class="muted small">
    Tratamiento incompleto:
    <strong>día en curso</strong> → no paga ni falta (espera salida);
    <strong>día pasado</strong> → al recalcular cuenta como falta y bloquea el cierre hasta corregir marcación o justificar.
    · <a href="/asistencia-registro-jornada?desde=<%= cobertura && cobertura.fechaInicioStr %>&amp;hasta=<%= cobertura && cobertura.fechaFinStr %>">registro de jornada</a>
  </p>
</div>
<% } %>

<% if (preflight && preflight.bloqueos) {
  const asisBloqueo = (preflight.bloqueos || []).find(function(b) { return b.codigo === 'ASIS_INCOMPLETA'; });
  if (asisBloqueo && asisBloqueo.detalle && asisBloqueo.detalle.length) { %>
<div class="alert alert-warning">
  <strong>Asistencia incompleta (bloquea cierre)</strong>
  <ul>
    <% asisBloqueo.detalle.forEach(function(d) {
      const ymd = d.fecha ? new Date(d.fecha).toISOString().slice(0, 10) : '';
    %>
    <li>
      <%= d.nombre || '—' %><% if (d.numEmpleado) { %> #<%= d.numEmpleado %><% } %>
      · <a href="/asistencia-diaria?fecha=<%= ymd %>&amp;periodoId=<%= periodo._id %>"><%= ymd %></a>
      · <%= (estatusDiarioLabels && estatusDiarioLabels[d.estatus]) || d.estatus %>
      — completa checada, justifica o déjalo como falta y recalcula.
    </li>
    <% }); %>
  </ul>
</div>
<% } } %>

<% if (typeof cobertura !== 'undefined' && cobertura) { %>
<section class="panel">
  <h2 class="panel-title">Ligación con asistencia</h2>
  <p class="muted small">
    Cadena recomendada:
    <strong>Marcaciones</strong> → <strong>Asistencia diaria</strong> → <strong>Calcular pre-nómina</strong> → (opcional) Nómina formal.
  </p>
  <% if (!cobertura.usaAsistencia) { %>
  <p class="warn-text">Este período tiene «Aplica asistencia» desactivado: el cálculo no leerá checadas.</p>
  <% } else if (cobertura.registrosDiarios === 0) { %>
  <div class="alert alert-warning">
    <strong>Sin asistencia diaria en este rango</strong>
    (<%= cobertura.fechaInicioStr %> → <%= cobertura.fechaFinStr %>).
    Por eso ves días trab. = 0 y montos en $0.
    Reprocesa la asistencia del período (toma las marcaciones) y luego recalcula.
  </div>
  <% } else { %>
  <p>
    Cobertura: <strong><%= cobertura.registrosDiarios %></strong> registros diarios ·
    <strong><%= cobertura.empleadosConAsistencia %></strong> / <%= cobertura.empleadosActivos %> empleados con al menos un día ·
    <% if (cobertura.empleadosSinAsistencia) { %>
    <span class="warn-text"><%= cobertura.empleadosSinAsistencia %> sin asistencia en el rango</span>
    <% } else { %>
    todos con asistencia
    <% } %>
  </p>
  <% } %>
  <p class="muted small">
    Ver día a día:
    <a href="/asistencia-diaria?fecha=<%= cobertura.fechaInicioStr %>">asistencia diaria</a>
    ·
    <a href="/asistencia-marcaciones">marcaciones</a>
  </p>
</section>
<% } %>

<div class="toolbar">
  <a class="btn" href="/prenomina-periodos">← Períodos</a>
  <% if (periodo.estatus === 'abierto' || periodo.estatus === 'borrador') { %>
  <form method="post" action="/prenomina-periodos/<%= periodo._id %>/reprocesar-asistencia" class="inline-form"
        onsubmit="return confirm('¿Reprocesar asistencia diaria de todo el rango del período a partir de las marcaciones?');">
    <button type="submit">1. Reprocesar asistencia del período</button>
  </form>
  <form method="post" action="/prenomina-periodos/<%= periodo._id %>/calcular" class="inline-form">
    <button type="submit"><%= periodo.estatus === 'borrador' ? '2. Recalcular pre-nómina' : '2. Calcular pre-nómina' %></button>
  </form>
  <% } %>
  <% if (periodo.estatus === 'borrador' || periodo.estatus === 'cerrado') { %>
  <form method="post" action="/prenomina-periodos/<%= periodo._id %>/cerrar" class="inline-form"
        onsubmit="return confirm('¿Cerrar período? No se podrán hacer más cambios.');">
    <button type="submit"
      <%= periodo.estatus === 'cerrado' || (preflight && !preflight.ok) ? 'disabled' : '' %>
      title="<%= preflight && !preflight.ok ? 'Corrige el pre-flight antes de cerrar' : '' %>">
      Cerrar período
    </button>
  </form>
  <% if (preflight && !preflight.ok && periodo.estatus === 'borrador') { %>
  <span class="muted small">Cierre bloqueado por pre-flight</span>
  <% } %>
  <% } %>
</div>

<% if (periodo.totales) { %>
<div class="summary-cards">
  <div class="card"><strong><%= periodo.totales.empleados %></strong> empleados</div>
  <div class="card"><strong>$<%= periodo.totales.percepciones.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong> percepciones</div>
  <div class="card"><strong>$<%= periodo.totales.deducciones.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong> deducciones</div>
  <div class="card"><strong>$<%= periodo.totales.neto.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong> neto</div>
</div>
<% } %>

<% if (typeof cobertura !== 'undefined' && cobertura && cobertura.usaAsistencia) { %>
<section class="panel" style="margin-top:1.5rem">
  <h2 class="panel-title">Asistencia del período</h2>
  <p class="muted small">
    Vista de checadas / días del rango
    (<%= cobertura.fechaInicioStr %> → <%= cobertura.fechaFinStr %>,
    <%= (fechasYmd && fechasYmd.length) || 0 %> día(s)).
    Revisa <strong>antes</strong> de calcular y vuelve a consultar <strong>después</strong> de reprocesar.
    Pulsa <strong>+</strong> para ver el detalle día a día.
  </p>

  <table class="asistencia-periodo-table">
    <thead>
      <tr>
        <th style="width:2rem"></th>
        <th>Empleado</th>
        <th>Días trab.</th>
        <th>Faltas</th>
        <th>Incomp.</th>
        <th>Sin proc.</th>
        <th>Retardo (min)</th>
        <th>HE (min)</th>
      </tr>
    </thead>
    <tbody>
      <% if (!asistenciaFilas || !asistenciaFilas.length) { %>
      <tr><td colspan="8" class="muted">No hay empleados activos en el alcance de este tipo de período.</td></tr>
      <% } %>
      <% (asistenciaFilas || []).forEach(function(fila) {
        const r = fila.resumen;
        const rowId = 'asist-det-' + fila.empleadoId;
      %>
      <tr>
        <td>
          <button type="button" class="btn-expand" data-target="<%= rowId %>" aria-expanded="false" title="Ver detalle diario">+</button>
        </td>
        <td>
          <%= fila.nombre %>
          <% if (fila.numEmpleado) { %><span class="muted small"> #<%= fila.numEmpleado %></span><% } %>
        </td>
        <td><%= r.diasTrabajados %></td>
        <td><%= r.faltas %></td>
        <td><%= r.incompletos %></td>
        <td class="<%= r.sinProcesar ? 'warn-text' : '' %>"><%= r.sinProcesar %></td>
        <td><%= r.minutosRetardo %></td>
        <td><%= r.minutosHE %></td>
      </tr>
      <tr id="<%= rowId %>" class="expand-row" hidden>
        <td colspan="8">
          <table class="nested-table" style="margin:.5rem 0 .75rem;width:100%">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Entrada</th>
                <th>Salida comida</th>
                <th>Regreso</th>
                <th>Salida</th>
                <th>Retardo</th>
                <th>HE</th>
                <th>Estatus</th>
                <th>Incidencias</th>
              </tr>
            </thead>
            <tbody>
              <% fila.dias.forEach(function(dia) {
                const estLabel = dia.estatus === 'sin_procesar'
                  ? 'Sin procesar'
                  : ((estatusDiarioLabels && estatusDiarioLabels[dia.estatus]) || dia.estatus);
                const warnRow = ['falta', 'registro_parcial', 'fuera_de_rango', 'incompleto', 'sin_procesar'].includes(dia.estatus);
              %>
              <tr class="<%= warnRow ? 'row-muted' : '' %>">
                <td>
                  <a href="/asistencia-diaria?fecha=<%= dia.ymd %>&amp;periodoId=<%= periodo._id %>"><%= dia.ymd %></a>
                </td>
                <td><%= dia.entrada && formatTimeHHMM ? formatTimeHHMM(dia.entrada) : '—' %></td>
                <td><%= dia.salidaComida && formatTimeHHMM ? formatTimeHHMM(dia.salidaComida) : '—' %></td>
                <td><%= dia.regresoComida && formatTimeHHMM ? formatTimeHHMM(dia.regresoComida) : '—' %></td>
                <td><%= dia.salida && formatTimeHHMM ? formatTimeHHMM(dia.salida) : '—' %></td>
                <td><%= dia.minutosRetardo ? dia.minutosRetardo + ' min' : '—' %></td>
                <td><%= dia.minutosHorasExtra ? dia.minutosHorasExtra + ' min' : '—' %></td>
                <td><span class="badge badge-<%= dia.estatus %>"><%= estLabel %></span></td>
                <td class="muted small"><%= dia.incidencias && dia.incidencias.length ? dia.incidencias.join(', ') : '—' %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</section>
<script>
(function () {
  document.querySelectorAll('.btn-expand[data-target]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var row = document.getElementById(btn.getAttribute('data-target'));
      if (!row) return;
      var open = row.hasAttribute('hidden');
      if (open) {
        row.removeAttribute('hidden');
        btn.textContent = '−';
        btn.setAttribute('aria-expanded', 'true');
      } else {
        row.setAttribute('hidden', '');
        btn.textContent = '+';
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  });
})();
</script>
<% } %>

<h2>Pre-cálculo por empleado<%= detalles.length ? '' : ' (pendiente)' %></h2>
<% if (!detalles.length) { %>
<p class="muted">Aún no hay cálculo monetario. Revisa la asistencia arriba, luego usa «Calcular pre-nómina».</p>
<% } %>
<table>
  <thead>
    <tr><th>Empleado</th><th>Días trab.</th><th>Faltas</th><th>Retardo (min)</th><th>HE (min)</th><th>Percepciones</th><th>Deducciones</th><th>Neto</th><th></th></tr>
  </thead>
  <tbody>
    <% if (!detalles.length) { %>
    <tr><td colspan="9" class="muted">Sin cálculo. Usa «Calcular pre-nómina».</td></tr>
    <% } %>
    <% detalles.forEach(function(d) {
      const emp = empMap.get(String(d.empleadoId));
      const nombre = emp ? (emp.firstName + ' ' + emp.lastName) : '—';
    %>
    <tr>
      <td><%= nombre %></td>
      <td><%= d.diasTrabajados %></td>
      <td><%= d.diasFalta %></td>
      <td><%= d.minutosRetardo %></td>
      <td><%= d.minutosHorasExtra %></td>
      <td>$<%= d.totalPercepciones.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
      <td>$<%= d.totalDeducciones.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
      <td><strong>$<%= d.netoPagar.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong></td>
      <td>
        <a href="/prenomina-periodos/<%= periodo._id %>/comprobante/<%= d.empleadoId %>">Comprobante</a>
        <% if (periodo.estatus !== 'cerrado') { %>
        · <a href="#ajuste-<%= d.empleadoId %>">Ajustar</a>
        <% } %>
      </td>
    </tr>
    <% if (periodo.estatus !== 'cerrado') { %>
    <tr id="ajuste-<%= d.empleadoId %>">
      <td colspan="9">
        <form method="post" action="/prenomina-periodos/<%= periodo._id %>/ajuste/<%= d.empleadoId %>" class="form-grid" style="margin-top:.5rem">
          <label>Concepto (catálogo)
            <select name="conceptoClave" required>
              <option value="">— Selecciona —</option>
              <% (conceptosAjuste || []).forEach(function(c) {
                const k = (c.clave || c.codigo || '').toUpperCase();
                if (!k || k === 'P001' || k === 'P002') return;
              %>
              <option value="<%= k %>" data-tipo="<%= c.tipo %>">
                <%= k %> — <%= c.nombre %> (<%= c.tipo === 'deduccion' ? 'deducción' : 'percepción' %>)
              </option>
              <% }); %>
            </select>
          </label>
          <input type="hidden" name="tipo" value="percepcion" class="ajuste-tipo-<%= d.empleadoId %>" />
          <input type="number" name="monto" step="0.01" min="0" placeholder="Monto" required />
          <input name="nota" placeholder="Nota / autorización" />
          <label class="inline-check" style="max-width:42rem">
            <input type="checkbox" name="reclasificarHe" value="1" />
            Reclasificar HE (quita P002) → este concepto
            <span class="muted small">Úsalo cuando no quieras pagar el excedente como horas extra (p. ej. bono), no solo por “exceder” el tope.</span>
          </label>
          <label class="inline-check" style="max-width:42rem">
            <input type="checkbox" name="acceptDisclaimerHe" value="1" />
            Acepto el disclaimer: modificar la naturaleza fiscal del tiempo extraordinario genera discrepancias en CFDI 4.0, afecta SBC y expone a multas por simulación. La acción es responsabilidad del administrador.
          </label>
          <button type="submit">Aplicar ajuste</button>
        </form>
      </td>
    </tr>
    <% } %>
    <% }); %>
  </tbody>
</table>
<script>
(function () {
  document.querySelectorAll('select[name="conceptoClave"]').forEach(function (sel) {
    sel.addEventListener('change', function () {
      var opt = sel.options[sel.selectedIndex];
      var tipo = (opt && opt.getAttribute('data-tipo')) || 'percepcion';
      var form = sel.closest('form');
      if (!form) return;
      var hidden = form.querySelector('input[name="tipo"]');
      if (hidden) hidden.value = tipo === 'deduccion' ? 'deduccion' : 'percepcion';
    });
  });
})();
</script>
<%- include('../Partials/layout-bottom') %>
