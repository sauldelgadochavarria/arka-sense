<%- include('../Partials/layout-top', { title: 'Nuevo centro de costo', session }) %>
<p><a href="/prenomina/centros-costo">← Volver a lista</a></p>
<h1>Nuevo centro de costo</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada.</p>
<% } else { %>
<form method="post" action="/prenomina/centros-costo" class="form-grid">
  <input name="codigo" placeholder="Código interno" required style="text-transform:uppercase" />
  <input name="codigoExterno" placeholder="Código externo" />
  <input name="codigoLegado" type="number" placeholder="Código legado (CLA_CENTRO_COSTO)" />
  <input name="cuentaContableExterna" placeholder="Cuenta contable externa" />
  <input name="nombre" placeholder="Nombre" required />
  <input name="descripcion" placeholder="Descripción" />
  <button type="submit">Crear</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
