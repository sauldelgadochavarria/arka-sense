<%- include('../../Partials/layout-top', { title: 'Tablas fiscales', session }) %>
<h1>Tablas fiscales</h1>
<div class="toolbar">
  <a class="btn" href="/nomina/catalogos">← Catálogos</a>
</div>

<p>
  ISR (rangos Art. 96), <strong>IMSS cuotas</strong> obrero-patronal por ramo y
  <strong>CEAV patronal</strong> por tramos de SBC.
  Funciones: <code>isrPeriodo()</code>, <code>imssObrero()</code>, <code>imssPatronal()</code>.
</p>

<h2>Nueva tabla / vigencia</h2>
<form method="post" action="/nomina/catalogos/tablas-fiscales" class="form-grid">
  <select name="codigo" required>
    <% codigosTabla.forEach(function(c) { %>
    <option value="<%= c.value %>"><%= c.label %></option>
    <% }); %>
  </select>
  <input name="nombre" placeholder="Nombre descriptivo" required />
  <select name="periodicidad">
    <% periodicidades.forEach(function(p) { %>
    <option value="<%= p.value %>" <%= p.value === 'mensual' ? 'selected' : '' %>><%= p.label %></option>
    <% }); %>
  </select>
  <input name="vigenciaDesde" type="date" />
  <button type="submit">Crear tabla</button>
</form>
<p class="muted">Al crear una nueva vigencia del mismo código, la vigencia anterior se cierra automáticamente.</p>

<table>
  <thead>
    <tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Periodicidad</th><th>Vigencia</th><th>Filas</th><th>Activa</th><th></th></tr>
  </thead>
  <tbody>
    <% if (!tablas.length) { %>
    <tr><td colspan="8" class="muted">Sin tablas. Ejecuta <code>seed:nomina-fiscal</code>.</td></tr>
    <% } %>
    <% tablas.forEach(function(t) {
         const cod = String(t.codigo || '');
         let tipoLabel = 'ISR rangos';
         if (cod === 'IMSS_CUOTAS') tipoLabel = 'IMSS cuotas';
         else if (cod === 'IMSS_CEAV_PATRONAL') tipoLabel = 'IMSS CEAV';
         else if (cod.indexOf('IMSS_') === 0) tipoLabel = 'IMSS (legado)';
    %>
    <tr class="<%= !t.activo ? 'row-muted' : '' %>">
      <td><code><%= t.codigo %></code></td>
      <td><%= t.nombre || '—' %></td>
      <td><%= tipoLabel %></td>
      <td><%= t.periodicidad %></td>
      <td>
        <%= new Date(t.vigenciaDesde).toLocaleDateString('es-MX') %>
        <% if (t.vigenciaHasta) { %> – <%= new Date(t.vigenciaHasta).toLocaleDateString('es-MX') %><% } %>
      </td>
      <td><%= t.rangosCount %></td>
      <td><%= t.activo ? 'Sí' : 'No' %></td>
      <td><a href="/nomina/catalogos/tablas-fiscales/<%= t._id %>">Editar</a></td>
    </tr>
    <% }); %>
  </tbody>
</table>
<%- include('../../Partials/layout-bottom') %>
