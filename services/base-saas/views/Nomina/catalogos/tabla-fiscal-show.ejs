<%- include('../../Partials/layout-top', { title: tabla.codigo, session }) %>
<h1><code><%= tabla.codigo %></code></h1>
<div class="toolbar">
  <a class="btn" href="/nomina/catalogos/tablas-fiscales">← Tablas fiscales</a>
  <form method="post" action="/nomina/catalogos/tablas-fiscales/<%= tabla._id %>/toggle" class="inline-form">
    <button type="submit"><%= tabla.activo ? 'Desactivar tabla' : 'Activar tabla' %></button>
  </form>
</div>

<p><strong><%= tabla.nombre %></strong> · <%= tabla.periodicidad %> · vigente desde <%= new Date(tabla.vigenciaDesde).toLocaleDateString('es-MX') %></p>

<h2>Agregar rango</h2>
<form method="post" action="/nomina/catalogos/tablas-fiscales/<%= tabla._id %>/rangos" class="form-grid">
  <input name="limiteInferior" type="number" step="0.01" placeholder="Límite inferior" required />
  <input name="limiteSuperior" type="number" step="0.01" placeholder="Límite superior" required />
  <input name="cuotaFija" type="number" step="0.01" placeholder="Cuota fija" value="0" />
  <input name="porcentajeExcedente" type="number" step="0.0001" placeholder="% excedente (ej. 0.192)" required />
  <button type="submit">Agregar rango</button>
</form>
<p class="muted">El porcentaje excedente es decimal: 19.2% → <code>0.192</code></p>

<h2>Rangos (<%= rangos.length %>)</h2>
<table>
  <thead>
    <tr><th>Límite inf.</th><th>Límite sup.</th><th>Cuota fija</th><th>% excedente</th><th></th></tr>
  </thead>
  <tbody>
    <% if (!rangos.length) { %>
    <tr><td colspan="5" class="muted">Sin rangos. Agrega filas de la tabla ISR.</td></tr>
    <% } %>
    <% rangos.forEach(function(r) { %>
    <tr>
      <td><%= r.limiteInferior %></td>
      <td><%= r.limiteSuperior %></td>
      <td><%= r.cuotaFija %></td>
      <td><%= (r.porcentajeExcedente * 100).toFixed(4) %>%</td>
      <td>
        <form method="post" action="/nomina/catalogos/tablas-fiscales/<%= tabla._id %>/rangos/<%= r._id %>/delete" class="inline-form">
          <button type="submit">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>

<h2>Nueva vigencia (copiar rangos)</h2>
<form method="post" action="/nomina/catalogos/tablas-fiscales/<%= tabla._id %>/copiar" class="form-grid">
  <input name="vigenciaDesde" type="date" required />
  <button type="submit">Copiar tabla y rangos</button>
</form>
<%- include('../../Partials/layout-bottom') %>
