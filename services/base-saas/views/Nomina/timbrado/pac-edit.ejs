<%- include('../../Partials/layout-top', { title: isNew ? 'Nuevo PAC' : 'Editar PAC', session }) %>
<% const P = pac || {}; %>
<h1><%= isNew ? 'Nuevo PAC' : ('Editar PAC: ' + (P.codigo || '')) %></h1>
<p><a href="/nomina/pac">← Volver</a></p>
<form method="post" action="<%= isNew ? '/nomina/pac' : ('/nomina/pac/' + P._id) %>" class="form-grid form-wide">
  <fieldset class="form-section">
    <legend>General</legend>
    <label>Código
      <input name="codigo" required value="<%= P.codigo || '' %>" <%= isNew ? '' : 'readonly' %> />
    </label>
    <label>Nombre
      <input name="nombre" required value="<%= P.nombre || '' %>" />
    </label>
    <label>Proveedor
      <select name="proveedor">
        <% (proveedores || []).forEach(function(pr) { %>
        <option value="<%= pr %>" <%= P.proveedor === pr ? 'selected' : '' %>><%= pr %></option>
        <% }); %>
      </select>
    </label>
    <label>Ambiente (legado pac_ambiente)
      <select name="ambiente">
        <option value="1" <%= String(P.ambiente) === '1' ? 'selected' : '' %>>1 — Producción</option>
        <option value="0" <%= String(P.ambiente) === '0' ? 'selected' : '' %>>0 — Prueba</option>
      </select>
    </label>
    <label>Formato de envío al PAC
      <select name="formato" id="pac-formato">
        <option value="JSON" <%= P.formato !== 'XML' ? 'selected' : '' %>>JSON (application/jsontoxml — SW)</option>
        <option value="XML" <%= P.formato === 'XML' ? 'selected' : '' %>>XML (multipart — PAC genéricos)</option>
      </select>
    </label>
    <p class="muted small" style="grid-column:1/-1">
      Nómina 1.2 se genera en ambos formatos desde el mismo builder. El PAC elige cuál enviar según esta opción.
    </p>
    <label>Subsidiaria
      <select name="subsidiariaId">
        <option value="">— Todas / empresa —</option>
        <% (subsidiarias || []).forEach(function(s) { %>
        <option value="<%= s._id %>" <%= P.subsidiariaId && String(P.subsidiariaId) === String(s._id) ? 'selected' : '' %>><%= s.nombre %></option>
        <% }); %>
      </select>
    </label>
    <label class="checkbox"><input type="checkbox" name="activo" value="1" <%= P.activo !== false ? 'checked' : '' %> /> Activo (pac_activo)</label>
    <label class="checkbox"><input type="checkbox" name="generarLayout" value="1" <%= P.generarLayout !== false ? 'checked' : '' %> /> Generar layout (pac_layout)</label>
    <label class="checkbox"><input type="checkbox" name="modoReal" value="1" <%= P.modoReal ? 'checked' : '' %> /> Modo real (llamar PAC; si no, simula UUID)</label>
  </fieldset>

  <fieldset class="form-section">
    <legend>Credenciales y URLs</legend>
    <label>Usuario
      <input name="usuario" value="<%= P.usuario || '' %>" autocomplete="off" />
    </label>
    <label>Password
      <input type="password" name="password" value="<%= P.password || '' %>" autocomplete="new-password" placeholder="<%= isNew ? '' : '******** para no cambiar' %>" />
    </label>
    <label>URL Auth
      <input name="urlAuth" id="pac-url-auth" value="<%= P.urlAuth || '' %>" style="min-width:28rem" />
    </label>
    <p class="muted small" style="grid-column:1/-1">
      Producción: <code>services.sw.com.mx</code> · Pruebas: <code>services.test.sw.com.mx</code>.
      Las credenciales de prueba no funcionan en producción (y viceversa).
    </p>
    <label>URL Timbrado (JSON)
      <input name="urlTimbrado" id="pac-url-timbrado-json" value="<%= P.urlTimbrado || '' %>" style="min-width:28rem" placeholder="…/v3/cfdi33/issue/json/v4" />
    </label>
    <label>URL Timbrado (XML)
      <input name="urlTimbradoXml" id="pac-url-timbrado-xml" value="<%= P.urlTimbradoXml || '' %>" style="min-width:28rem" placeholder="…/cfdi33/issue/v4" />
    </label>
    <p class="muted small" style="grid-column:1/-1">
      JSON: <code>application/jsontoxml</code> + Bearer. XML: <code>multipart/form-data</code> campo <code>xml</code>.
      Ref. <a href="https://developers.sw.com.mx/knowledge-base/nomina-1-2/" target="_blank" rel="noopener">Nómina 1.2 SW</a>.
    </p>
    <label>URL Cancelación
      <input name="urlCancelacion" value="<%= P.urlCancelacion || '' %>" style="min-width:28rem" />
    </label>
    <label>URL Consulta
      <input name="urlConsulta" value="<%= P.urlConsulta || '' %>" style="min-width:28rem" />
    </label>
    <label>Timeout (s)
      <input type="number" name="timeout" min="5" max="300" value="<%= P.timeout != null ? P.timeout : 30 %>" />
    </label>
    <label>Reintentos
      <input type="number" name="reintentos" min="0" max="10" value="<%= P.reintentos != null ? P.reintentos : 3 %>" />
    </label>
  </fieldset>

  <fieldset class="form-section">
    <legend>Serie, carpeta y templates</legend>
    <label>Serie default
      <input name="serieDefault" value="<%= P.serieDefault || '' %>" maxlength="10" />
    </label>
    <label>Carpeta XML
      <input name="carpetaXml" value="<%= P.carpetaXml || '' %>" />
    </label>
    <label>Email errores
      <input name="emailErrores" type="email" value="<%= P.emailErrores || '' %>" />
    </label>
    <label>Template ingreso
      <input name="templateIngreso" value="<%= P.templateIngreso || '' %>" />
    </label>
    <label>Template egreso
      <input name="templateEgreso" value="<%= P.templateEgreso || '' %>" />
    </label>
    <label>Template pago
      <input name="templatePago" value="<%= P.templatePago || '' %>" />
    </label>
    <label>Template traslado
      <input name="templateTraslado" value="<%= P.templateTraslado || '' %>" />
    </label>
  </fieldset>

  <fieldset class="form-section">
    <legend>Datos prueba SAT</legend>
    <label>RFC test
      <input name="rfcSatTest" value="<%= P.rfcSatTest || '' %>" />
    </label>
    <label>Nombre SAT test
      <input name="nombreSatTest" value="<%= P.nombreSatTest || '' %>" style="min-width:24rem" />
    </label>
    <label>Notas
      <textarea name="notas" rows="2"><%= P.notas || '' %></textarea>
    </label>
  </fieldset>

  <% if (!isNew) { %>
  <p class="muted" style="grid-column:1/-1">Total timbrados: <%= P.totalTimbrados || 0 %> · Último uso: <%= P.ultimaFechaUso ? new Date(P.ultimaFechaUso).toLocaleString('es-MX') : '—' %></p>
  <% } %>

  <button type="submit" class="btn btn-primary"><%= isNew ? 'Crear' : 'Guardar' %></button>
</form>

<% if (!isNew && P._id) { %>
<form method="post" action="/nomina/pac/<%= P._id %>/probar" class="inline-form" style="margin:1rem 0">
  <button type="submit" class="btn">Probar autenticación SW</button>
</form>
<% } %>

<script>
(function () {
  var amb = document.querySelector('select[name="ambiente"]');
  var auth = document.getElementById('pac-url-auth');
  var timbradoJson = document.getElementById('pac-url-timbrado-json');
  var timbradoXml = document.getElementById('pac-url-timbrado-xml');
  var testUrls = <%- JSON.stringify(testUrls || {}) %>;
  var prodAuth = 'https://services.sw.com.mx/v2/security/authenticate';
  var prodJson = 'https://services.sw.com.mx/v3/cfdi33/issue/json/v4';
  var prodXml = 'https://services.sw.com.mx/cfdi33/issue/v4';
  if (!amb) return;
  function esUrlProd(u) {
    return u && u.indexOf('services.sw.com.mx') >= 0 && u.indexOf('services.test.') < 0;
  }
  function esUrlTest(u) {
    return u && u.indexOf('services.test.sw.com.mx') >= 0;
  }
  function aplicarAmbiente() {
    var esTest = amb.value === '0';
    if (auth && (!auth.value || (esTest && esUrlProd(auth.value)) || (!esTest && esUrlTest(auth.value)))) {
      auth.value = esTest ? (testUrls.urlAuth || prodAuth.replace('services.', 'services.test.')) : prodAuth;
    }
    if (timbradoJson && (!timbradoJson.value || (esTest && esUrlProd(timbradoJson.value)) || (!esTest && esUrlTest(timbradoJson.value)))) {
      timbradoJson.value = esTest ? (testUrls.urlTimbrado || prodJson.replace('services.', 'services.test.')) : prodJson;
    }
    if (timbradoXml && (!timbradoXml.value || (esTest && esUrlProd(timbradoXml.value)) || (!esTest && esUrlTest(timbradoXml.value)))) {
      timbradoXml.value = esTest ? (testUrls.urlTimbradoXml || prodXml.replace('services.', 'services.test.')) : prodXml;
    }
  }
  amb.addEventListener('change', aplicarAmbiente);
  aplicarAmbiente();
})();
</script>
<%- include('../../Partials/layout-bottom') %>
