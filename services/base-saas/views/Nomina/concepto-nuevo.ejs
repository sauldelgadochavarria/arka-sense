<%- include('../Partials/layout-top', { title: 'Nuevo concepto', session }) %>
<p><a href="/nomina/conceptos">← Volver a lista</a></p>
<h1>Nuevo concepto</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada.</p>
<% } else { %>
<form method="post" action="/nomina/conceptos" class="form-grid props-form">
  <fieldset class="props-fieldset">
    <legend>Identidad</legend>
    <div class="form-row-2">
      <label>Código
        <input name="codigo" placeholder="ej. BONO_PUNT" maxlength="32" required style="text-transform:uppercase" />
      </label>
      <label>Código externo
        <input name="codigoExterno" placeholder="Código externo" />
      </label>
    </div>
    <label>Nombre
      <input name="nombre" placeholder="Nombre" required />
    </label>
    <div class="form-row-3">
        <label>Tipo
        <select name="tipo" id="nuevo-tipo" required>
          <% tiposConcepto.forEach(function(t) { %>
          <option value="<%= t.value %>"><%= t.label %></option>
          <% }); %>
        </select>
      </label>
      <label>Naturaleza
        <select name="naturaleza">
          <% naturalezas.forEach(function(n) { %>
          <option value="<%= n.value %>" <%= n.value === 'gravado' ? 'selected' : '' %>><%= n.label %></option>
          <% }); %>
        </select>
      </label>
      <label>Categoría
        <select name="categoria">
          <%
            const _catsN = (typeof categoriasConcepto !== 'undefined' && categoriasConcepto && categoriasConcepto.length)
              ? categoriasConcepto
              : [
                  { value: 'ordinario', label: 'Ordinario' },
                  { value: 'prevision_social', label: 'Previsión social' },
                  { value: 'fiscal', label: 'Fiscal' },
                  { value: 'informativo', label: 'Informativo' },
                  { value: 'otro', label: 'Otro' }
                ];
          %>
          <% _catsN.forEach(function(c) { %>
          <option value="<%= c.value %>" <%= c.value === 'ordinario' ? 'selected' : '' %>><%= c.label %></option>
          <% }); %>
        </select>
      </label>
      <label>Orden
        <input name="ordenCalculo" type="number" min="1" placeholder="Orden" value="100" />
      </label>
    </div>
    <div class="form-row-3">
      <label>Fase
        <select name="fase">
          <option value="1">1 — Percepciones</option>
          <option value="2">2 — Acumuladores</option>
          <option value="3">3 — Deducciones</option>
          <option value="4">4 — Neto</option>
        </select>
      </label>
      <label>Ámbito
        <select name="aplicaEn">
          <option value="nomina">Solo nómina</option>
          <option value="prenomina">Solo pre-nómina</option>
          <option value="ambos">Ambos</option>
        </select>
      </label>
      <label>Cuenta contable
        <input name="cuentaContable" placeholder="Cuenta contable" />
      </label>
    </div>
  </fieldset>

  <fieldset class="props-fieldset">
    <legend>Ámbito de aplicación</legend>
    <p class="muted small" style="margin-top:0">
      Sin selección = aplica a todos. Opciones desde
      <a href="/config-sistema/enums" target="_blank">Config sistema → Enums</a>.
    </p>
    <%
      const _tiposEmpNuevo = (typeof tiposEmpleadoOpts !== 'undefined' && tiposEmpleadoOpts) ? tiposEmpleadoOpts : [];
      const _tiposPerNuevo = (typeof tiposPeriodoOpts !== 'undefined' && tiposPeriodoOpts) ? tiposPeriodoOpts : [];
      const _tiposNomNuevo = (typeof tiposNominaOpts !== 'undefined' && tiposNominaOpts) ? tiposNominaOpts : [];
    %>
    <label>Tipos de empleado
      <div class="form-row-checks">
        <% if (!_tiposEmpNuevo.length) { %><span class="muted">Sin ítems en tipo_empleado.</span><% } %>
        <% _tiposEmpNuevo.forEach(function(te) { %>
        <label class="inline-check">
          <input type="checkbox" name="aplicaTiposEmpleado" value="<%= te.value %>" />
          <%= te.label || te.value %>
        </label>
        <% }); %>
      </div>
    </label>
    <label>Tipos de período
      <div class="form-row-checks">
        <% if (!_tiposPerNuevo.length) { %><span class="muted">Sin ítems en tipo_periodo.</span><% } %>
        <% _tiposPerNuevo.forEach(function(tp) { %>
        <label class="inline-check">
          <input type="checkbox" name="aplicaTiposPeriodo" value="<%= tp.value %>" />
          <%= tp.label || tp.value %>
        </label>
        <% }); %>
      </div>
    </label>
    <label>Tipos de nómina
      <div class="form-row-checks">
        <% if (!_tiposNomNuevo.length) { %><span class="muted">Sin ítems en tipo_nomina.</span><% } %>
        <% _tiposNomNuevo.forEach(function(tn) { %>
        <label class="inline-check">
          <input type="checkbox" name="aplicaTipoNomina" value="<%= tn.value %>" />
          <%= tn.label || tn.value %>
        </label>
        <% }); %>
      </div>
    </label>
  </fieldset>

  <fieldset class="props-fieldset">
    <legend>SAT y fiscal</legend>
    <%
      const _opcionesSat = (typeof opcionesSat !== 'undefined' && opcionesSat) ? opcionesSat : [];
      const _opcionesSatPorTipo = (typeof opcionesSatPorTipo !== 'undefined' && opcionesSatPorTipo)
        ? opcionesSatPorTipo
        : { percepcion: _opcionesSat, deduccion: [], otro_pago: [] };
      const _desgloseModos = (typeof desgloseModos !== 'undefined' && desgloseModos) ? desgloseModos : [
        { value: 'todo_gravado', label: 'Todo gravado' },
        { value: 'todo_exento', label: 'Todo exento' },
        { value: 'tope_uma', label: 'Tope en UMAs' },
        { value: 'tope_monto', label: 'Tope en monto' },
        { value: 'formula', label: 'Fórmula' },
        { value: 'regla_ley', label: 'Regla de ley' }
      ];
      const _imssModos = (typeof imssDesgloseModos !== 'undefined' && imssDesgloseModos) ? imssDesgloseModos : [
        { value: 'todo_integra', label: 'Todo integra SBC' },
        { value: 'todo_excluye', label: 'Nada integra' }
      ];
      const _natSdi = (typeof naturalezaSdiOpts !== 'undefined' && naturalezaSdiOpts) ? naturalezaSdiOpts : [
        { value: 'variable', label: 'Variable (bimestre)' },
        { value: 'fijo', label: 'Fijo (SDI/factor)' },
        { value: 'excluido', label: 'Excluido' }
      ];
    %>
    <div class="form-row-2">
      <label>Clave SAT
        <select name="satClave" id="nuevo-sat-clave">
          <option value="">— Sin clave SAT —</option>
          <% _opcionesSat.forEach(function(e) { %>
          <option value="<%= e.clave %>" data-desc="<%= (e.descripcion || '').replace(/"/g, '&quot;') %>">
            <%= e.clave %> — <%= e.descripcion || '' %>
          </option>
          <% }); %>
        </select>
      </label>
      <label>Descripción SAT
        <input name="satDescripcion" id="nuevo-sat-desc" placeholder="Se completa al elegir la clave" />
      </label>
    </div>
    <% if (!_opcionesSat.length) { %>
    <p class="muted small">No hay entradas SAT cargadas para este tipo.
      <a href="/nomina/catalogos/sat">Administrar catálogo SAT</a>
    </p>
    <% } else { %>
    <p class="muted small" id="nuevo-sat-hint">
      Opciones filtradas por tipo del concepto (percepción / deducción / otro pago).
      <a href="/nomina/catalogos/sat">Ver catálogo completo</a>
    </p>
    <% } %>
    <div class="form-row-checks">
      <label class="inline-check"><input type="checkbox" name="integraISR" checked /> Integra ISR</label>
      <label class="inline-check"><input type="checkbox" name="integraIMSS" checked /> Integra IMSS</label>
      <label class="inline-check"><input type="checkbox" name="integraINFONAVIT" /> Integra INFONAVIT</label>
    </div>
    <div class="form-row-2">
      <label>Naturaleza SDI
        <select name="naturalezaSdi">
          <% _natSdi.forEach(function(o) { %>
          <option value="<%= o.value %>" <%= o.value === 'variable' ? 'selected' : '' %>><%= o.label %></option>
          <% }); %>
        </select>
      </label>
      <label>Modo desglose IMSS
        <select name="imssDesgloseModo">
          <% _imssModos.forEach(function(o) { %>
          <option value="<%= o.value %>" <%= o.value === 'todo_integra' ? 'selected' : '' %>><%= o.label %></option>
          <% }); %>
        </select>
      </label>
    </div>
    <label>Modo de desglose ISR
      <select name="desgloseModo">
        <% _desgloseModos.forEach(function(m) { %>
        <option value="<%= m.value %>"><%= m.label %></option>
        <% }); %>
      </select>
    </label>
  </fieldset>

  <fieldset class="props-fieldset">
    <legend>Pre-nómina (opcional)</legend>
    <div class="form-row-2">
      <label>Fórmula pre-nómina
        <select name="formulaPrenomina">
          <option value="">—</option>
          <option value="salario_periodo">Salario del período</option>
          <option value="horas_extra">Horas extra</option>
          <option value="retardos">Retardos</option>
          <option value="faltas">Faltas</option>
          <option value="salida_anticipada">Salida anticipada</option>
          <option value="manual">Manual</option>
        </select>
      </label>
      <label>Clave pre-nómina
        <input name="clavePrenomina" style="text-transform:uppercase" />
      </label>
    </div>
    <label>Tipos de incidencia <span class="muted">(claves separadas por coma, ej. RET, HEO)</span>
      <input name="tiposIncidencia" placeholder="RET, HEO" />
    </label>
  </fieldset>

  <button type="submit">Crear concepto</button>
</form>
<script>
(function () {
  var porTipo = <%- JSON.stringify(typeof opcionesSatPorTipo !== 'undefined' && opcionesSatPorTipo ? opcionesSatPorTipo : { percepcion: [], deduccion: [], otro_pago: [] }) %>;
  var tipoSel = document.getElementById('nuevo-tipo') || document.querySelector('select[name="tipo"]');
  var satSel = document.getElementById('nuevo-sat-clave');
  var satDesc = document.getElementById('nuevo-sat-desc');
  if (!tipoSel || !satSel) return;

  function fillSat(tipo) {
    var rows = porTipo[tipo] || porTipo.percepcion || [];
    var prev = satSel.value;
    satSel.innerHTML = '';
    var empty = document.createElement('option');
    empty.value = '';
    empty.textContent = '— Sin clave SAT —';
    satSel.appendChild(empty);
    rows.forEach(function (e) {
      var opt = document.createElement('option');
      opt.value = e.clave;
      opt.setAttribute('data-desc', e.descripcion || '');
      opt.textContent = e.clave + (e.descripcion ? ' — ' + e.descripcion : '');
      if (String(prev) === String(e.clave)) opt.selected = true;
      satSel.appendChild(opt);
    });
    if (satDesc && satSel.selectedIndex > 0) {
      var d = satSel.options[satSel.selectedIndex].getAttribute('data-desc') || '';
      if (d) satDesc.value = d;
    }
  }

  tipoSel.addEventListener('change', function () {
    fillSat(tipoSel.value || 'percepcion');
    if (satDesc) satDesc.value = '';
  });
  satSel.addEventListener('change', function () {
    if (!satDesc) return;
    var opt = satSel.options[satSel.selectedIndex];
    if (!opt || !opt.value) return;
    var d = opt.getAttribute('data-desc') || '';
    if (d) satDesc.value = d;
  });
})();
</script>
<% } %>
<%- include('../Partials/layout-bottom') %>
