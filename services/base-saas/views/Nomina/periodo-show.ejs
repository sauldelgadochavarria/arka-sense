<%- include('../Partials/layout-top', { title: 'Período de nómina', session }) %>
<% const _canEdit = typeof canEdit !== 'undefined' ? canEdit : true; %>
<h1>
  Período <%= periodo.tipoPeriodo %>
  <% if (periodo.numeroPeriodo != null) { %>#<%= periodo.numeroPeriodo %><% } %>
  · <%= periodo.tipoNomina %>
  <% if (periodo.anio) { %><span class="muted small">(<%= periodo.anio %>)</span><% } %>
</h1>
<p>
  <strong><%= new Date(periodo.fechaInicio).toLocaleDateString('es-MX') %></strong>
  al
  <strong><%= new Date(periodo.fechaFin).toLocaleDateString('es-MX') %></strong>
  · <%= periodo.diasPeriodo %> días
  · Estatus: <span class="badge badge-<%= periodo.estatus === 'cerrado' ? 'baja' : periodo.estatus === 'calculado' ? 'activo' : periodo.estatus === 'calculando' ? 'suspendido' : 'suspendido' %>"><%= estatusLabels[periodo.estatus] || periodo.estatus %></span>
  <% if (periodo.omitirDispersionBancaria) { %>
  · <span class="muted small">Dispersión bancaria opcional</span>
  <% } %>
  <% const lbPer = periodo.layoutBancario || {}; %>
  <% if (lbPer.estatus === 'generado') { %>
  · Dispersión: <span class="badge badge-activo">Layout generado</span>
  <span class="muted small">(<%= lbPer.layoutCodigo || '' %> · <%= lbPer.archivoNombre || '' %>)</span>
  <% } else if (periodo.estatus === 'calculado' || periodo.estatus === 'cerrado') { %>
  · Dispersión: <span class="badge badge-suspendido">Pendiente</span>
  <% } %>
  <% const correoPer = periodo.correo || {}; %>
  <% if (correoPer.estatus === 'enviado') { %>
  · Correo: <span class="badge badge-activo">Enviado</span>
  <span class="muted small"><%= correoPer.enviadoAt ? new Date(correoPer.enviadoAt).toLocaleString('es-MX') : '' %></span>
  <% } else if (correoPer.estatus === 'parcial') { %>
  · Correo: <span class="badge badge-suspendido">Parcial</span>
  <% } else if (periodo.estatus === 'cerrado') { %>
  · Correo: <span class="badge badge-suspendido">Pendiente</span>
  <% } %>
</p>
<%
  function fmtDt(v) {
    if (!v) return '—';
    try {
      return new Date(v).toLocaleString('es-MX', { dateStyle: 'short', timeStyle: 'short' });
    } catch (_) { return '—'; }
  }
  const fechaCalculo = periodo.fechaCalculo || periodo.calculadoAt;
  const fechaCierre = periodo.fechaCierre || periodo.cerradoAt;
%>
<p class="muted small">
  Fecha de cálculo: <strong><%= fmtDt(fechaCalculo) %></strong>
  <% if (periodo.calculoLoteId) { %>
  · Lote: <code><%= periodo.calculoLoteId %></code>
  <% } %>
  · Calculó: <strong><%= (typeof calculadoPor !== 'undefined' && calculadoPor) ? calculadoPor : (periodo.calculadoPorLabel || periodo.calculadoPorUserId || '—') %></strong>
  · Fecha de cierre: <strong><%= fmtDt(fechaCierre) %></strong>
  · Cerró: <strong><%= (typeof cerradoPor !== 'undefined' && cerradoPor) ? cerradoPor : (periodo.cerradoPorLabel || periodo.cerradoPorUserId || '—') %></strong>
  <% if (periodo.cierreResumen && periodo.cierreResumen.recibosArchivados) { %>
  · Histórico: <%= periodo.cierreResumen.recibosArchivados %> recibos
  <% if (periodo.cierreResumen.operativosEliminados != null) { %>
  · Temporal limpiado: <%= periodo.cierreResumen.operativosEliminados %>
  <% } %>
  · <%= periodo.cierreResumen.conceptosAcumulados || 0 %> líneas a acumulados
  <% } %>
</p>

<%
  const prest = periodo.prestaciones || {};
  const estatusPrest = String(periodo.estatus || '').toLowerCase();
  const puedeEditarPrest = _canEdit && (estatusPrest === 'abierto' || estatusPrest === 'calculado');
  const fmtMoney = function (n) {
    return Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
  };
%>
<section class="panel" style="margin:1rem 0">
  <h2 class="panel-title">Prestaciones del período</h2>
  <% if (puedeEditarPrest) { %>
  <p class="muted small">Puedes marcar si este período paga despensa. Tras guardar, vuelve a <strong>Calcular nómina</strong> para aplicar el cambio.</p>
  <form method="post" action="/nomina/periodos/<%= periodo._id %>/prestaciones" class="form-grid">
    <div class="checkbox-group" style="grid-column:1/-1">
      <label>
        <input type="hidden" name="pagaDespensa" value="0" />
        <input type="checkbox" name="pagaDespensa" value="1" <%= prest.pagaDespensa ? 'checked' : '' %> />
        Paga despensa / vales en este período
      </label>
      <label>
        <input type="hidden" name="despensaPagoMensual" value="0" />
        <input type="checkbox" name="despensaPagoMensual" value="1" <%= prest.despensaPagoMensual !== false ? 'checked' : '' %> />
        Pago mensual completo (tope IMSS = 40% UMA mensual)
      </label>
    </div>
    <label>Override monto despensa ($)
      <input type="number" name="despensaMontoOverride" min="0" step="0.01"
        value="<%= prest.despensaMontoOverride > 0 ? prest.despensaMontoOverride : '' %>"
        placeholder="Vacío = política del empleado" />
    </label>
    <button type="submit">Guardar prestaciones</button>
  </form>
  <% } else { %>
  <p class="banner-readonly" style="margin:0 0 0.75rem">Solo consulta — el período está <strong><%= estatusLabels[periodo.estatus] || periodo.estatus %></strong>; no se puede editar.</p>
  <dl class="flag-labels">
    <div class="flag-readonly <%= prest.pagaDespensa ? 'is-on' : '' %>">
      <input type="checkbox" <%= prest.pagaDespensa ? 'checked' : '' %> disabled />
      Paga despensa: <strong><%= prest.pagaDespensa ? 'sí' : 'no' %></strong>
    </div>
    <div class="flag-readonly <%= prest.despensaPagoMensual !== false ? 'is-on' : '' %>">
      <input type="checkbox" <%= prest.despensaPagoMensual !== false ? 'checked' : '' %> disabled />
      Tope IMSS <%= prest.despensaPagoMensual !== false ? 'mensual' : 'prorrateado' %>
    </div>
  </dl>
  <% if (prest.despensaMontoOverride > 0) { %>
  <p class="muted" style="margin:0.5rem 0 0">Override monto: <strong>$<%= fmtMoney(prest.despensaMontoOverride) %></strong></p>
  <% } %>
  <% } %>
</section>

<% if (prenominaPeriodo) { %>
<p class="muted">
  Pre-nómina vinculada:
  <a href="/prenomina-periodos/<%= prenominaPeriodo._id %>"><%= prenominaPeriodo.tipo %></a>
  (<%= prenominaPeriodo.estatus %>) ·
  <%= new Date(prenominaPeriodo.fechaInicio).toLocaleDateString('es-MX') %>
  –
  <%= new Date(prenominaPeriodo.fechaFin).toLocaleDateString('es-MX') %>.
  Solo se calculan empleados con <strong>días trabajados, HE o percepciones</strong> en esa pre-nómina
  (quien solo tiene faltas / ceros no entra).
</p>
<% } else if (periodo.payrollPeriodId) { %>
<p class="muted warn-text">Pre-nómina vinculada no encontrada.</p>
<% } else { %>
<div class="alert alert-warning">
  <strong>Sin pre-nómina vinculada.</strong>
  El recálculo usa calendario/expediente (todos los activos, <%= periodo.diasPeriodo %> días).
  La asistencia de pre-nómina <em>no</em> aplica hasta vincular.
  <% if (_canEdit && typeof prenominaCandidatos !== 'undefined' && prenominaCandidatos.length) { %>
  <p class="muted small" style="grid-column:1/-1">
    Solo puedes vincular una pre-nómina del <strong>mismo tipo</strong> (<%= periodo.tipoPeriodo %>).
    Vincular <em>no</em> cambia el tipo del período de nómina.
  </p>
  <form method="post" action="/nomina/periodos/<%= periodo._id %>/vincular-prenomina" class="form-grid" style="margin-top:0.75rem">
    <label>Vincular pre-nómina (alinea fechas a ese período)
      <select name="payrollPeriodId" required>
        <option value="">— Elegir —</option>
        <% prenominaCandidatos.forEach(function(p) { %>
        <option value="<%= p._id %>">
          #<%= p.numeroPeriodo != null ? p.numeroPeriodo : '—' %>
          <%= p.tipo %>
          <%= new Date(p.fechaInicio).toLocaleDateString('es-MX') %> – <%= new Date(p.fechaFin).toLocaleDateString('es-MX') %>
          (<%= p.estatus %><%= p.totales && p.totales.empleados ? ', ' + p.totales.empleados + ' emp.' : '' %>)
        </option>
        <% }); %>
      </select>
    </label>
    <button type="submit">Vincular y alinear fechas</button>
  </form>
  <% } else { %>
  <p class="muted" style="margin:0.5rem 0 0">No hay pre-nóminas compartidas abiertas/calculadas. Ábrelas en Pre-nómina o márcalas «compartir con nómina».</p>
  <% } %>
</div>
<% } %>

<% if (preflight) { %>
  <% if (!preflight.ok) { %>
<div class="alert alert-warning">
  <strong>Preflight — no se puede calcular:</strong>
  <ul>
    <% preflight.bloqueos.forEach(function(b) { %><li><%= b.mensaje %></li><% }); %>
  </ul>
</div>
  <% } else if (preflight.advertencias.length) { %>
<div class="alert alert-warning">
  <strong>Advertencias antes de calcular:</strong>
  <ul>
    <% preflight.advertencias.forEach(function(a) { %><li><%= a.mensaje %></li><% }); %>
  </ul>
</div>
  <% } else { %>
<p class="muted">Preflight OK — <%= preflight.resumen.empleadosCalculables %> empleado(s) calculables, <%= preflight.resumen.formulas %> fórmulas vigentes.</p>
  <% } %>
<% } %>

<div id="calculo-progress" class="calculo-progress <%= periodo.estatus === 'calculando' || (calculoJob && ['pending','running'].includes(calculoJob.estatus)) ? '' : 'hidden' %>">
  <h3>Cálculo en curso</h3>
  <div class="progress-bar"><div id="progress-fill" class="progress-fill" style="width:0%"></div></div>
  <p id="progress-text" class="muted">Iniciando…</p>
  <ul id="progress-errores" class="alert-list-compact"></ul>
</div>

<div class="toolbar">
  <a class="btn" href="/nomina/periodos">← Períodos</a>
  <% if (!_canEdit) { %>
  <span class="muted small">Consulta — calcular/cerrar requiere rol Nómina operativa</span>
  <% } %>
  <% if (_canEdit && periodo.estatus !== 'cerrado' && periodo.estatus !== 'calculando') { %>
  <% if (periodo.tipoNomina === 'finiquito' || periodo.tipoNomina === 'indemnizacion') { %>
  <p class="muted small" style="margin:0">
    Período especial: los montos vienen del motor de finiquitos (no uses «Calcular nómina» ordinaria).
    Re-inyecta desde el cálculo en <a href="/nomina/finiquitos">Finiquitos</a>.
  </p>
  <% } else { %>
  <form method="post" action="/nomina/periodos/<%= periodo._id %>/calcular" class="inline-form">
    <button type="submit" <%= preflight && !preflight.ok ? 'disabled' : '' %>>Calcular nómina (async)</button>
  </form>
  <% } %>
  <% } %>
  <% if (_canEdit && periodo.estatus === 'calculado') { %>
  <form method="post" action="/nomina/periodos/<%= periodo._id %>/cerrar" class="inline-form" onsubmit="return confirm('¿Cerrar período? Los recibos se moverán al histórico (copiar + borrar del temporal), se actualizarán acumulados y no se podrá recalcular.');">
    <button type="submit">Cerrar período</button>
  </form>
  <% } %>
  <% if (_canEdit && (periodo.estatus === 'calculado' || periodo.estatus === 'cerrado')) { %>
  <% if (periodo.omitirDispersionBancaria) { %>
  <p class="muted small" style="margin:0 0 .5rem">Dispersión bancaria opcional (finiquito/cheque a la firma). Puedes generar layout si aplica.</p>
  <% } %>
  <a class="btn btn-primary" href="/nomina/dispersion-bancaria?periodoId=<%= periodo._id %>">Generar archivo bancario</a>
  <% } %>
  <% if (_canEdit && periodo.estatus === 'cerrado') { %>
  <a class="btn" href="/nomina/envio-correo?periodoId=<%= periodo._id %>"><%= (periodo.correo && periodo.correo.estatus === 'enviado') ? 'Reenviar correos' : 'Enviar recibos por correo' %></a>
  <% } %>
</div>

<% if (periodo.totales && periodo.totales.empleados) { %>
<div class="summary-cards">
  <div class="card"><strong><%= periodo.totales.empleados %></strong> recibos</div>
  <% if (periodo.totales.empleadosConError) { %>
  <div class="card warn"><strong><%= periodo.totales.empleadosConError %></strong> errores</div>
  <% } %>
  <div class="card"><strong>$<%= (periodo.totales.percepciones || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong> percepciones</div>
  <div class="card"><strong>$<%= (periodo.totales.deducciones || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong> deducciones</div>
  <div class="card"><strong>$<%= (periodo.totales.neto || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong> neto</div>
</div>
<% } %>

<% if (calculoJob && calculoJob.estatus === 'failed') { %>
<div class="alert alert-warning"><strong>Error en cálculo:</strong> <%= calculoJob.error %></div>
<% } %>

<h2>Recibos</h2>
<table>
  <thead>
    <tr>
      <th>No.</th>
      <th>Empleado</th>
      <th>ID cálculo</th>
      <th>Días lab.</th>
      <th>Faltas</th>
      <th>Origen insumos</th>
      <th>Percepciones</th>
      <th>Deducciones</th>
      <th>Neto</th>
      <th>Dispersión</th>
      <th>Correo</th>
      <th>Cálculo</th>
      <th>Cierre</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="recibos-body">
    <% if (!recibos.length) { %>
    <tr><td colspan="14" class="muted"><%= periodo.estatus === 'cerrado' ? 'Sin recibos en histórico para este período.' : 'Sin recibos. Ejecuta el cálculo del período.' %></td></tr>
    <% } %>
    <% recibos.forEach(function(r) {
         const fuente = r.insumosFuente || 'default';
         const fuenteLabel = fuente === 'prenomina' ? 'Pre-nómina / asistencia'
           : (fuente === 'prenomina_sin_detalle' ? 'Pre-nómina (sin detalle)' : 'Calendario / expediente');
         const lb = r.layoutBancario || {};
         const cor = r.correo || {};
    %>
    <tr>
      <td><%= r.numEmpleado %></td>
      <td><%= r.empleadoNombre %></td>
      <td class="muted small"><code title="<%= r.calculoLoteId || '' %>"><%= r.calculoId || '—' %></code></td>
      <td><%= r.diasLaborados %></td>
      <td><%= r.faltas %></td>
      <td class="muted small"><%= fuenteLabel %></td>
      <td>$<%= r.totalPercepciones.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
      <td>$<%= r.totalDeducciones.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
      <td>$<%= r.netoPagar.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
      <td>
        <% if (lb.estatus === 'generado') { %>
        <span class="badge badge-activo" title="<%= lb.layoutCodigo || '' %>">Generado</span>
        <% } else { %>
        <span class="muted small">—</span>
        <% } %>
      </td>
      <td>
        <% if (cor.estatus === 'enviado') { %>
        <span class="badge badge-activo" title="<%= cor.destinatario || '' %>">Enviado</span>
        <% } else if (cor.estatus === 'error') { %>
        <span class="badge badge-baja" title="<%= cor.errorMensaje || '' %>">Error</span>
        <% } else if (cor.estatus === 'omitido') { %>
        <span class="muted small">Omitido</span>
        <% } else if (periodo.estatus === 'cerrado') { %>
        <span class="muted small">Pendiente</span>
        <% } else { %>
        <span class="muted small">—</span>
        <% } %>
      </td>
      <td class="muted small"><%= fmtDt(r.fechaCalculo) %></td>
      <td class="muted small"><%= fmtDt(r.fechaCierre) %></td>
      <td><a href="/nomina/periodos/<%= periodo._id %>/recibos/<%= r._id %>">Detalle</a></td>
    </tr>
    <% }); %>
  </tbody>
</table>

<% if (typeof auditoria !== 'undefined' && auditoria && auditoria.length) { %>
<h2>Bitácora de auditoría</h2>
<table>
  <thead>
    <tr>
      <th>Fecha</th>
      <th>Acción</th>
      <th>Usuario</th>
      <th>Mensaje</th>
    </tr>
  </thead>
  <tbody>
    <% auditoria.forEach(function(a) { %>
    <tr>
      <td class="muted small"><%= fmtDt(a.createdAt) %></td>
      <td><code><%= a.accion %></code></td>
      <td class="muted small"><%= a.userLabel || a.userId || '—' %></td>
      <td><%= a.mensaje || '—' %></td>
    </tr>
    <% }); %>
  </tbody>
</table>
<% } %>

<script>
(function() {
  const periodoId = '<%= periodo._id %>';
  const estatus = '<%= periodo.estatus %>';
  const jobInicial = <%- JSON.stringify(calculoJob ? { estatus: calculoJob.estatus } : null) %>;
  const debePoll = estatus === 'calculando' || (jobInicial && ['pending','running'].includes(jobInicial.estatus));
  if (!debePoll) return;

  const box = document.getElementById('calculo-progress');
  const fill = document.getElementById('progress-fill');
  const text = document.getElementById('progress-text');
  const errList = document.getElementById('progress-errores');
  box.classList.remove('hidden');

  async function poll() {
    try {
      const res = await fetch('/nomina/periodos/' + periodoId + '/estado-calculo');
      const data = await res.json();
      if (!data.ok || !data.job) return;
      const j = data.job;
      fill.style.width = j.porcentaje + '%';
      text.textContent = j.estatus === 'running' || j.estatus === 'pending'
        ? `Procesando ${j.progreso.procesados || 0} / ${j.progreso.total || '…'} empleados`
        : j.estatus === 'completed'
          ? `Completado: ${j.progreso.exitos} recibos, ${j.progreso.errores} errores`
          : 'Falló: ' + (j.error || 'error desconocido');

      if (j.erroresDetalle && j.erroresDetalle.length) {
        errList.innerHTML = j.erroresDetalle.slice(-5).map(function(e) {
          return '<li>' + (e.numEmpleado || '') + ' ' + (e.nombre || '') + ': ' + e.error + '</li>';
        }).join('');
      }

      if (j.estatus === 'completed' || j.estatus === 'failed') {
        setTimeout(function() { window.location.reload(); }, 1200);
        return;
      }
    } catch (e) { /* ignore */ }
    setTimeout(poll, 1500);
  }
  poll();
})();
</script>
<%- include('../Partials/layout-bottom') %>
