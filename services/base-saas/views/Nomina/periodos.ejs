<%- include('../Partials/layout-top', { title: 'Períodos de nómina', session }) %>
<% const _canEdit = typeof canEdit !== 'undefined' ? canEdit : true; %>
<h1>Períodos de nómina</h1>
<div class="toolbar">
  <a class="btn" href="/nomina">← Nómina</a>
</div>
<% if (!_canEdit) { %>
<p class="alert">Consulta: puedes ver períodos y recibos. Calcular, cerrar o abrir período requiere el rol <strong>Nómina operativa</strong>.</p>
<% } %>
<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant.</p>
<% } else { %>

<% if (_canEdit) { %>
<h2>Nuevo período</h2>
<form method="post" action="/nomina/periodos" class="form-grid">
  <label>Tipo de período
    <select name="tipoPeriodo" required>
      <% tiposPeriodo.forEach(function(t) { %>
      <option value="<%= t.value %>"><%= t.label %></option>
      <% }); %>
    </select>
  </label>
  <label>Tipo de nómina
    <select name="tipoNomina" required>
      <% tiposNomina.forEach(function(t) { %>
      <option value="<%= t.value %>"><%= t.label %></option>
      <% }); %>
    </select>
  </label>
  <label>Fecha de referencia
    <input type="date" name="fechaReferencia" value="<%= new Date().toISOString().slice(0,10) %>" />
  </label>
  <label>Período pre-nómina compartido (insumos, opcional)
    <select name="payrollPeriodId">
      <option value="">— Sin vincular —</option>
      <% prenominaPeriodos.forEach(function(p) { %>
      <option value="<%= p._id %>">
        #<%= p.numeroPeriodo != null ? p.numeroPeriodo : '—' %>
        <%= p.tipo %>
        <%= new Date(p.fechaInicio).toLocaleDateString('es-MX') %> – <%= new Date(p.fechaFin).toLocaleDateString('es-MX') %>
        (<%= p.estatus %>)
      </option>
      <% }); %>
    </select>
  </label>
  <p class="muted small" style="grid-column:1/-1">
    Catálogo/pre-nómina y nómina formal son colecciones distintas: pueden tener fechas distintas
    (p. ej. semana sáb–vie del catálogo vs lun–dom al abrir sin vínculo).
    <strong>Al elegir pre-nómina aquí, las fechas se copian de esa pre-nómina</strong>.
    Si abres sin vincular, el cálculo ignora la asistencia.
  </p>
  <label>Notas
    <input name="notas" placeholder="Opcional" />
  </label>
  <div class="checkbox-group" style="grid-column:1/-1">
    <label>
      <input type="hidden" name="pagaDespensa" value="0" />
      <input type="checkbox" name="pagaDespensa" value="1" id="pagaDespensa"
        <%= typeof sugerirPagaDespensaDefault !== 'undefined' && sugerirPagaDespensaDefault ? 'checked' : '' %> />
      Paga despensa / vales en este período
    </label>
  </div>
  <label>Override monto despensa (opcional)
    <input type="number" name="despensaMontoOverride" min="0" step="0.01" placeholder="Vacío = política del empleado" />
  </label>
  <div class="checkbox-group" style="grid-column:1/-1">
    <label>
      <input type="hidden" name="despensaPagoMensual" value="0" />
      <input type="checkbox" name="despensaPagoMensual" value="1" id="despensaPagoMensual" checked />
      Pago mensual completo (tope IMSS = 40% UMA mensual)
    </label>
  </div>
  <p class="muted small" style="grid-column:1/-1">
    Habitual: 2ª quincena o 3ª semana. El checkbox se sugiere según tipo y fecha de referencia.
    Pago mensual → tope IMSS = 40% UMA mensual (~$1,426).
  </p>
  <button type="submit">Abrir período</button>
</form>

<script>
(function () {
  function sugerir(tipo, ymd) {
    var d = Number(String(ymd || '').slice(8, 10)) || 0;
    tipo = String(tipo || '').toLowerCase();
    if (tipo === 'mensual') return true;
    if (tipo === 'quincenal' || tipo === 'catorcenal') return d >= 16;
    if (tipo === 'semanal') return Math.min(5, Math.ceil(d / 7)) === 3;
    return false;
  }
  var form = document.querySelector('form[action="/nomina/periodos"]');
  if (!form) return;
  var tipoSel = form.querySelector('[name=tipoPeriodo]');
  var fechaInp = form.querySelector('[name=fechaReferencia]');
  var chk = form.querySelector('#pagaDespensa');
  function refresh() {
    if (!chk || !tipoSel || !fechaInp) return;
    chk.checked = sugerir(tipoSel.value, fechaInp.value);
  }
  if (tipoSel) tipoSel.addEventListener('change', refresh);
  if (fechaInp) fechaInp.addEventListener('change', refresh);
})();
</script>
<% } %>

<h2>Períodos</h2>
<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Año</th>
      <th>Tipo período</th>
      <th>Tipo nómina</th>
      <th>Inicio</th>
      <th>Fin</th>
      <th>Pre-nómina</th>
      <th>Estatus</th>
      <th>Dispersión</th>
      <th>Despensa</th>
      <th>Calculó</th>
      <th>Cerró</th>
      <th>Empleados</th>
      <th>Neto</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (!periodos.length) { %>
    <tr><td colspan="15" class="muted">Sin períodos. Al abrir el primero se sembrarán conceptos y fórmulas base.</td></tr>
    <% } %>
    <% periodos.forEach(function(p) {
         const lb = p.layoutBancario || {};
    %>
    <tr>
      <td><strong><%= p.numeroPeriodo != null ? p.numeroPeriodo : '—' %></strong></td>
      <td><%= p.anio || (p.fechaInicio ? new Date(p.fechaInicio).getFullYear() : '—') %></td>
      <td><%= p.tipoPeriodo %></td>
      <td><%= p.tipoNomina %></td>
      <td><%= new Date(p.fechaInicio).toLocaleDateString('es-MX') %></td>
      <td><%= new Date(p.fechaFin).toLocaleDateString('es-MX') %></td>
      <td class="muted small"><%= p.payrollPeriodId ? 'Vinculada' : 'Sin vincular' %></td>
      <td><span class="badge badge-<%= p.estatus === 'cerrado' ? 'baja' : p.estatus === 'calculado' ? 'activo' : 'suspendido' %>"><%= estatusLabels[p.estatus] || p.estatus %></span></td>
      <td>
        <% if (lb.estatus === 'generado') { %>
        <span class="badge badge-activo" title="<%= lb.layoutCodigo || '' %>">Generado</span>
        <% } else if (p.estatus === 'calculado' || p.estatus === 'cerrado') { %>
        <span class="muted small">Pendiente</span>
        <% } else { %>—<% } %>
      </td>
      <td class="muted small"><%= p.prestaciones && p.prestaciones.pagaDespensa ? 'Sí' : 'No' %></td>
      <td class="muted small"><%= p.calculadoPorLabel || '—' %></td>
      <td class="muted small"><%= p.cerradoPorLabel || '—' %></td>
      <td><%= p.totales?.empleados || 0 %></td>
      <td>$<%= (p.totales?.neto || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
      <td><a href="/nomina/periodos/<%= p._id %>">Ver</a></td>
    </tr>
    <% }); %>
  </tbody>
</table>
<% } %>
<%- include('../Partials/layout-bottom') %>
