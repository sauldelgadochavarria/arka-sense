<%- include('../Partials/layout-top', { title: 'Períodos de nómina', session }) %>
<%
  const _canEdit = typeof canEdit !== 'undefined' ? canEdit : true;
  const F = typeof filtros !== 'undefined' && filtros ? filtros : {};
  const showCreate = typeof openCreate !== 'undefined' && openCreate;
  function labelTipo(list, val) {
    const hit = (list || []).find(function (t) { return String(t.value) === String(val); });
    return hit ? hit.label : (val || '—');
  }
  function satLabel(code) {
    if (code == null || code === '') return '—';
    const hit = (typeof periodicidadesSat !== 'undefined' ? periodicidadesSat : []).find(function (p) {
      return Number(p.value) === Number(code);
    });
    return hit ? (hit.code + ' · ' + hit.label) : String(code);
  }
%>
<h1>Períodos de nómina</h1>
<div class="toolbar">
  <a class="btn" href="/nomina">← Nómina</a>
  <% if (_canEdit && empresa) { %>
  <a class="btn btn-primary" href="/nomina/periodos?nuevo=1<%= F.anio ? '&anio=' + encodeURIComponent(F.anio) : '' %>#nuevo-periodo">+ Nuevo período</a>
  <a class="btn" href="#organizar-periodos">Organizar períodos</a>
  <% } %>
</div>
<% if (!_canEdit) { %>
<p class="alert">Consulta: puedes ver períodos y recibos. Calcular, cerrar o abrir período requiere el rol <strong>Nómina operativa</strong>.</p>
<% } %>
<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant.</p>
<% } else { %>

<% if (_canEdit) { %>
<%
  var _cd = typeof createDefaults !== 'undefined' && createDefaults ? createDefaults : {};
  var _defTipo = _cd.tipoPeriodo || 'quincenal';
  var _defNomina = _cd.tipoNomina || 'ordinaria';
  var _defFecha = _cd.fechaReferencia || new Date().toISOString().slice(0, 10);
  var _sug = _cd.sugerencia || null;
%>
<section class="panel" id="nuevo-periodo" style="<%= showCreate ? '' : 'display:none' %>">
  <h2 class="panel-title">Nuevo período</h2>
  <form method="post" action="/nomina/periodos" class="form-grid" id="form-nuevo-periodo">
    <input type="hidden" name="periodicidadPagoSat" id="nuevo-periodicidad-sat" value="4" />
    <input type="hidden" name="tipoNominaCfdi" id="nuevo-tipo-nomina-cfdi" value="O" />

    <label>Tipo de período (motor interno)
      <select name="tipoPeriodo" id="nuevo-tipo-periodo" required>
        <% tiposPeriodo.forEach(function(t) { %>
        <option value="<%= t.value %>" <%= t.value === _defTipo ? 'selected' : '' %>><%= t.label %></option>
        <% }); %>
      </select>
    </label>
    <label>Tipo de nómina (negocio)
      <select name="tipoNomina" id="nuevo-tipo-nomina" required>
        <% tiposNomina.forEach(function(t) { %>
        <option value="<%= t.value %>" <%= t.value === _defNomina ? 'selected' : '' %>><%= t.label %></option>
        <% }); %>
      </select>
    </label>

    <div class="alert" style="grid-column:1/-1;margin:0" id="nuevo-info-sat">
      <strong>Mapeo SAT (se guarda al crear)</strong>
      <ul style="margin:.35rem 0 0;padding-left:1.2rem">
        <li>PeriodicidadPago SAT: <strong id="info-periodicidad-sat">04 · Quincenal</strong></li>
        <li>TipoNomina CFDI: <strong id="info-tipo-nomina-cfdi">O · Ordinaria</strong></li>
      </ul>
      <p class="muted small" style="margin:.5rem 0 0">
        El motor interno define la periodicidad SAT. El tipo de negocio define si el CFDI es
        <code>O</code> (solo ordinaria) o <code>E</code> (cualquier extraordinaria: aguinaldo, PTU, finiquito…).
      </p>
    </div>

    <div class="alert" style="grid-column:1/-1;margin:0;background:#f0f7ff;border-color:#b6d4fe" id="nuevo-info-siguiente">
      <strong>Siguiente propuesto</strong>
      <p class="muted small" style="margin:.35rem 0 0" id="info-siguiente-texto">
        <% if (_sug && _sug.tieneHistorico && _sug.ultimo) { %>
        Último: #<%= _sug.ultimo.numeroPeriodo %>/<%= _sug.ultimo.anio %>
        (<%= _sug.ultimo.fechaInicio %> – <%= _sug.ultimo.fechaFin %>).
        Propuesto: <strong>#<%= _sug.numeroPeriodo %>/<%= _sug.anio %></strong>
        · <%= _sug.fechaInicio %> – <%= _sug.fechaFin %>.
        <% } else if (_sug) { %>
        Sin histórico para esta combinación. Ventana sugerida:
        <strong>#<%= _sug.numeroPeriodo %>/<%= _sug.anio %></strong>
        · <%= _sug.fechaInicio %> – <%= _sug.fechaFin %>.
        <% } else { %>
        Se calculará al elegir tipo de período y nómina.
        <% } %>
      </p>
    </div>

    <label>Fecha de referencia
      <input type="date" name="fechaReferencia" id="nuevo-fecha-ref" value="<%= _defFecha %>" />
    </label>
    <label>Período pre-nómina compartido (insumos, opcional)
      <select name="payrollPeriodId">
        <option value="">— Sin vincular —</option>
        <% prenominaPeriodos.forEach(function(p) { %>
        <option value="<%= p._id %>">
          #<%= p.numeroPeriodo != null ? p.numeroPeriodo : '—' %>
          <%= p.tipo %>
          <%= new Date(p.fechaInicio).toLocaleDateString('es-MX') %> – <%= new Date(p.fechaFin).toLocaleDateString('es-MX') %>
          (<%= p.estatus %>)
        </option>
        <% }); %>
      </select>
    </label>
    <p class="muted small" style="grid-column:1/-1">
      <strong>Al elegir pre-nómina, las fechas se copian de esa pre-nómina</strong>.
      Si abres sin vincular, el cálculo ignora la asistencia.
      La fecha de referencia se prellena con el día siguiente al último período del mismo tipo (evita duplicar # / fechas tras carga histórica).
    </p>
    <label>Notas
      <input name="notas" placeholder="Opcional" />
    </label>
    <div class="checkbox-group" style="grid-column:1/-1">
      <label>
        <input type="hidden" name="pagaDespensa" value="0" />
        <input type="checkbox" name="pagaDespensa" value="1" id="pagaDespensa"
          <%= typeof sugerirPagaDespensaDefault !== 'undefined' && sugerirPagaDespensaDefault ? 'checked' : '' %> />
        Paga despensa / vales en este período
      </label>
    </div>
    <label>Override monto despensa (opcional)
      <input type="number" name="despensaMontoOverride" min="0" step="0.01" placeholder="Vacío = política del empleado" />
    </label>
    <div class="checkbox-group" style="grid-column:1/-1">
      <label>
        <input type="hidden" name="despensaPagoMensual" value="0" />
        <input type="checkbox" name="despensaPagoMensual" value="1" id="despensaPagoMensual" checked />
        Pago mensual completo (tope IMSS = 40% UMA mensual)
      </label>
    </div>
    <div style="grid-column:1/-1;display:flex;gap:.5rem">
      <button type="submit" class="btn btn-primary">Abrir período</button>
      <a class="btn" href="/nomina/periodos">Cancelar</a>
    </div>
  </form>
</section>

<script>
(function () {
  function sugerir(tipo, ymd) {
    var d = Number(String(ymd || '').slice(8, 10)) || 0;
    tipo = String(tipo || '').toLowerCase();
    if (tipo === 'mensual') return true;
    if (tipo === 'quincenal' || tipo === 'catorcenal') return d >= 16;
    if (tipo === 'semanal') return Math.min(5, Math.ceil(d / 7)) === 3;
    return false;
  }

  var motorSat = <%- JSON.stringify(typeof motorAPeriodicidadSat !== 'undefined' ? motorAPeriodicidadSat : { quincenal: 4 }) %>;
  var satCatalog = <%- JSON.stringify(typeof periodicidadesSat !== 'undefined' ? periodicidadesSat : []) %>;
  var sugerencias = <%- JSON.stringify(typeof sugerenciasSiguiente !== 'undefined' ? sugerenciasSiguiente : {}) %>;
  var satByVal = {};
  satCatalog.forEach(function (p) { satByVal[String(p.value)] = p; });

  var form = document.getElementById('form-nuevo-periodo');
  if (!form) return;
  var tipoSel = form.querySelector('#nuevo-tipo-periodo');
  var nominaSel = form.querySelector('#nuevo-tipo-nomina');
  var fechaInp = form.querySelector('[name=fechaReferencia]');
  var chk = form.querySelector('#pagaDespensa');
  var hidSat = form.querySelector('#nuevo-periodicidad-sat');
  var hidCfdi = form.querySelector('#nuevo-tipo-nomina-cfdi');
  var infoSat = document.getElementById('info-periodicidad-sat');
  var infoCfdi = document.getElementById('info-tipo-nomina-cfdi');
  var infoSig = document.getElementById('info-siguiente-texto');
  var fechaTouched = false;

  function keySug() {
    return String(tipoSel ? tipoSel.value : 'quincenal') + '|' + String(nominaSel ? nominaSel.value : 'ordinaria');
  }

  function refreshSiguiente(applyFecha) {
    var s = sugerencias[keySug()];
    if (infoSig) {
      if (s && s.tieneHistorico && s.ultimo) {
        infoSig.innerHTML =
          'Último: #' + s.ultimo.numeroPeriodo + '/' + s.ultimo.anio +
          ' (' + s.ultimo.fechaInicio + ' – ' + s.ultimo.fechaFin + '). ' +
          'Propuesto: <strong>#' + s.numeroPeriodo + '/' + s.anio + '</strong>' +
          ' · ' + s.fechaInicio + ' – ' + s.fechaFin + '.';
      } else if (s) {
        infoSig.innerHTML =
          'Sin histórico para esta combinación. Ventana sugerida: ' +
          '<strong>#' + s.numeroPeriodo + '/' + s.anio + '</strong>' +
          ' · ' + s.fechaInicio + ' – ' + s.fechaFin + '.';
      } else {
        infoSig.textContent =
          'Sin propuesta cargada para esta combinación; se usará la fecha de referencia y el siguiente # libre.';
      }
    }
    if (applyFecha && s && s.fechaReferencia && fechaInp && !fechaTouched) {
      fechaInp.value = s.fechaReferencia;
    }
  }

  function refreshDespensa() {
    if (!chk || !tipoSel || !fechaInp) return;
    chk.checked = sugerir(tipoSel.value, fechaInp.value);
  }

  function refreshSat() {
    var motor = tipoSel ? tipoSel.value : 'quincenal';
    var code = motorSat[motor];
    if (code == null) code = 4;
    if (hidSat) hidSat.value = String(code);
    var meta = satByVal[String(code)];
    if (infoSat) {
      infoSat.textContent = meta
        ? (meta.code + ' · ' + meta.label)
        : String(code);
    }
  }

  function refreshCfdi() {
    var negocio = nominaSel ? nominaSel.value : 'ordinaria';
    var cfdi = negocio === 'ordinaria' ? 'O' : 'E';
    if (hidCfdi) hidCfdi.value = cfdi;
    if (infoCfdi) {
      infoCfdi.textContent = cfdi === 'O'
        ? 'O · Ordinaria'
        : 'E · Extraordinaria (por tipo de negocio «' + negocio + '»)';
    }
  }

  function refreshAll(applyFecha) {
    refreshSiguiente(applyFecha !== false);
    refreshDespensa();
    refreshSat();
    refreshCfdi();
  }

  if (tipoSel) tipoSel.addEventListener('change', function () { fechaTouched = false; refreshAll(true); });
  if (nominaSel) nominaSel.addEventListener('change', function () { fechaTouched = false; refreshAll(true); });
  if (fechaInp) fechaInp.addEventListener('change', function () {
    fechaTouched = true;
    refreshDespensa();
  });
  refreshAll(false);
})();
</script>
<% } %>

<% if (_canEdit && empresa) { %>
<section class="panel" id="organizar-periodos">
  <h2 class="panel-title">Organizar períodos (tras importación CFDI)</h2>
  <p class="muted small">
    Separa períodos mezclados entre subsidiarias, fusiona ventanas solapadas y renumeración cronológica 1…N
    por subsidiaria / año / tipo. Úsalo después de una carga masiva de históricos si los números o fechas no cuadran.
  </p>
  <form method="post" action="/nomina/periodos/organizar" class="form-grid"
        onsubmit="return confirm('¿Organizar períodos? Separará mezclas entre subsidiarias, fusionará solapes y renumerará cronológicamente.');">
    <label>Tipo período (motor)
      <select name="tipoPeriodo" required>
        <% tiposPeriodo.forEach(function(t) { %>
        <option value="<%= t.value %>" <%= (F.tipoPeriodo || 'semanal') === t.value ? 'selected' : '' %>><%= t.label %></option>
        <% }); %>
      </select>
    </label>
    <label>Tipo nómina (negocio)
      <select name="tipoNomina" required>
        <% tiposNomina.forEach(function(t) { %>
        <option value="<%= t.value %>" <%= (F.tipoNomina || 'ordinaria') === t.value ? 'selected' : '' %>><%= t.label %></option>
        <% }); %>
      </select>
    </label>
    <% if (F.anio) { %>
    <input type="hidden" name="anio" value="<%= F.anio %>" />
    <% } %>
    <div style="align-self:end">
      <button type="submit" class="btn btn-primary">Organizar períodos</button>
    </div>
  </form>
</section>
<% } %>

<section class="panel">
  <h2 class="panel-title">Filtros</h2>
  <form method="get" action="/nomina/periodos" class="filter-form form-grid">
    <label>Año
      <input type="number" name="anio" min="2020" max="2100" value="<%= F.anio || '' %>" placeholder="Todos" />
    </label>
    <label>Tipo período
      <select name="tipoPeriodo">
        <option value="">Todos</option>
        <% tiposPeriodo.forEach(function(t) { %>
        <option value="<%= t.value %>" <%= F.tipoPeriodo === t.value ? 'selected' : '' %>><%= t.label %></option>
        <% }); %>
      </select>
    </label>
    <label>Tipo nómina (negocio)
      <select name="tipoNomina">
        <option value="">Todos</option>
        <% tiposNomina.forEach(function(t) { %>
        <option value="<%= t.value %>" <%= F.tipoNomina === t.value ? 'selected' : '' %>><%= t.label %></option>
        <% }); %>
      </select>
    </label>
    <label>Estatus
      <select name="estatus">
        <option value="">Todos</option>
        <% Object.keys(estatusLabels).forEach(function(k) { %>
        <option value="<%= k %>" <%= F.estatus === k ? 'selected' : '' %>><%= estatusLabels[k] %></option>
        <% }); %>
      </select>
    </label>
    <label>CFDI TipoNomina
      <select name="tipoNominaCfdi">
        <option value="">Todos</option>
        <% (tiposNominaCfdi || []).forEach(function(t) { %>
        <option value="<%= t.value %>" <%= F.tipoNominaCfdi === t.value ? 'selected' : '' %>><%= t.label %></option>
        <% }); %>
      </select>
    </label>
    <label>Periodicidad SAT
      <select name="periodicidadPagoSat">
        <option value="">Todas</option>
        <% (periodicidadesSat || []).forEach(function(p) { %>
        <option value="<%= p.value %>" <%= String(F.periodicidadPagoSat) === String(p.value) ? 'selected' : '' %>><%= p.code %> · <%= p.label %></option>
        <% }); %>
      </select>
    </label>
    <label>Buscar
      <input type="search" name="q" value="<%= F.q || '' %>" placeholder="Notas / usuario…" />
    </label>
    <div style="align-self:end;display:flex;gap:.5rem">
      <button type="submit" class="btn btn-primary">Filtrar</button>
      <a class="btn" href="/nomina/periodos">Limpiar</a>
    </div>
  </form>
</section>

<h2>Períodos <span class="muted small">(<%= periodos.length %>)</span></h2>
<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Año</th>
      <th>Motor</th>
      <th>Periodicidad SAT</th>
      <th>CFDI</th>
      <th>Tipo nómina</th>
      <th>Inicio</th>
      <th>Fin</th>
      <th>Estatus</th>
      <th>Dispersión</th>
      <th>Empleados</th>
      <th>Neto</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (!periodos.length) { %>
    <tr><td colspan="13" class="muted">Sin períodos con estos filtros.</td></tr>
    <% } %>
    <% periodos.forEach(function(p) {
         const lb = p.layoutBancario || {};
    %>
    <tr>
      <td><strong><%= p.numeroPeriodo != null ? p.numeroPeriodo : '—' %></strong></td>
      <td><%= p.anio || (p.fechaInicio ? new Date(p.fechaInicio).getFullYear() : '—') %></td>
      <td><%= labelTipo(tiposPeriodo, p.tipoPeriodo) %></td>
      <td class="muted small"><%= satLabel(p.periodicidadPagoSat) %></td>
      <td>
        <% if (p.tipoNominaCfdi === 'O' || p.tipoNominaCfdi === 'E') { %>
        <span class="badge"><%= p.tipoNominaCfdi %></span>
        <% } else { %><span class="muted small">—</span><% } %>
      </td>
      <td>
        <% if (_canEdit) { %>
        <form method="post" action="/nomina/periodos/<%= p._id %>/clasificacion" class="inline-form" style="display:flex;gap:.35rem;align-items:center">
          <input type="hidden" name="returnTo" value="/nomina/periodos<%= (function(){ const qs=[]; if(F.anio) qs.push('anio='+encodeURIComponent(F.anio)); if(F.tipoPeriodo) qs.push('tipoPeriodo='+encodeURIComponent(F.tipoPeriodo)); if(F.tipoNomina) qs.push('tipoNomina='+encodeURIComponent(F.tipoNomina)); if(F.estatus) qs.push('estatus='+encodeURIComponent(F.estatus)); if(F.tipoNominaCfdi) qs.push('tipoNominaCfdi='+encodeURIComponent(F.tipoNominaCfdi)); if(F.periodicidadPagoSat) qs.push('periodicidadPagoSat='+encodeURIComponent(F.periodicidadPagoSat)); if(F.q) qs.push('q='+encodeURIComponent(F.q)); return qs.length?'?'+qs.join('&'):''; })() %>" />
          <select name="tipoNomina" onchange="this.form.submit()" title="Clasificación de negocio (editable)">
            <% tiposNomina.forEach(function(t) { %>
            <option value="<%= t.value %>" <%= p.tipoNomina === t.value ? 'selected' : '' %>><%= t.label %></option>
            <% }); %>
          </select>
        </form>
        <% } else { %>
        <%= labelTipo(tiposNomina, p.tipoNomina) %>
        <% } %>
      </td>
      <td><%= new Date(p.fechaInicio).toLocaleDateString('es-MX') %></td>
      <td><%= new Date(p.fechaFin).toLocaleDateString('es-MX') %></td>
      <td><span class="badge badge-<%= p.estatus === 'cerrado' ? 'baja' : p.estatus === 'calculado' ? 'activo' : 'suspendido' %>"><%= estatusLabels[p.estatus] || p.estatus %></span></td>
      <td>
        <% if (lb.estatus === 'generado') { %>
        <span class="badge badge-activo">Generado</span>
        <% } else if (p.estatus === 'calculado' || p.estatus === 'cerrado') { %>
        <span class="muted small">Pendiente</span>
        <% } else { %>—<% } %>
      </td>
      <td><%= p.totales?.empleados || 0 %></td>
      <td>$<%= (p.totales?.neto || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></td>
      <td><a href="/nomina/periodos/<%= p._id %>">Ver</a></td>
    </tr>
    <% }); %>
  </tbody>
</table>
<% } %>
<%- include('../Partials/layout-bottom') %>
