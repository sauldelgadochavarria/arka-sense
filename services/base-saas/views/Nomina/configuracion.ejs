<%- include('../Partials/layout-top', { title: 'Configuración fiscal', session }) %>
<h1>Configuración fiscal</h1>
<div class="toolbar">
  <a class="btn" href="/nomina">← Nómina</a>
  <a class="btn" href="/nomina/conceptos">Conceptos</a>
  <a class="btn" href="/nomina/catalogos">Catálogos</a>
  <a class="btn" href="/config-empresa/cargas">Cargas iniciales</a>
</div>

<p>Tablas y parámetros globales usados por las fórmulas (<code>aplicarTabla</code>, <code>uma</code>, etc.).</p>

<section class="panel">
  <h2 class="panel-title">Motor ISR (SAT + Inteligente)</h2>
  <p class="muted small">
    El <strong>Motor SAT</strong> es el oficial: tabla del período → ISR que se retiene y reporta en CFDI.
    El <strong>Motor Inteligente</strong> proyecta ingreso anual y sugiere una retención uniforme
    (conceptos informativos <code>ISR_SAT</code>, <code>ISR_PROYECTADO</code>, <code>ISR_AJUSTADO</code>, <code>ISR_DIFERENCIA</code>).
    En v1 el neto/CFDI <em>siempre</em> usa ISR SAT.
  </p>
  <form method="post" action="/nomina/configuracion/isr-motor" class="form-grid">
    <label class="inline-check">
      <input type="checkbox" name="activo" <%= typeof isrActivo === 'undefined' || isrActivo ? 'checked' : '' %> />
      Activar motor inteligente / proyección
    </label>
    <label>Modo
      <select name="modo">
        <option value="sat" <%= typeof isrModo !== 'undefined' && isrModo === 'sat' ? 'selected' : '' %>>Solo SAT (oficial)</option>
        <option value="inteligente_alerta" <%= typeof isrModo === 'undefined' || isrModo === 'inteligente_alerta' ? 'selected' : '' %>>SAT + alertas / proyección (recomendado)</option>
        <option value="inteligente_retencion" <%= typeof isrModo !== 'undefined' && isrModo === 'inteligente_retencion' ? 'selected' : '' %>>Retención uniforme (experimental; CFDI sigue en SAT)</option>
      </select>
    </label>
    <button type="submit">Guardar motor ISR</button>
  </form>
</section>

<section class="panel">
  <h2 class="panel-title">Política de días pagados / descanso semanal</h2>
  <p class="muted small">
    El sueldo usa <code>diasPagados</code> (laborados + descanso pagado), no solo días laborados.
    La «pérdida del séptimo» no es regla única de la LFT: configúrala según contrato / CCT / reglamento.
  </p>
  <%
    const pd = (typeof politicaDias !== 'undefined' && politicaDias) ? politicaDias : {};
    const modoD = pd.modoDescanso || 'todo_o_nada';
  %>
  <form method="post" action="/nomina/configuracion/dias-pagados" class="form-grid">
    <label class="inline-check">
      <input type="checkbox" name="activo" <%= pd.activo !== false ? 'checked' : '' %> />
      Activar motor de días pagados
    </label>
    <label>Modo de descanso
      <select name="modoDescanso">
        <option value="todo_o_nada" <%= modoD === 'todo_o_nada' ? 'selected' : '' %>>Todo o nada (falta injustificada → pierde descanso)</option>
        <option value="proporcional" <%= modoD === 'proporcional' ? 'selected' : '' %>>Proporcional al cumplimiento</option>
        <option value="conservar" <%= modoD === 'conservar' ? 'selected' : '' %>>Siempre pagar descanso</option>
        <option value="ninguno" <%= modoD === 'ninguno' ? 'selected' : '' %>>Nunca agregar descanso al sueldo</option>
      </select>
    </label>
    <label class="inline-check">
      <input type="checkbox" name="pierdeDescansoConUnaFaltaInjustificada" <%= pd.pierdeDescansoConUnaFaltaInjustificada !== false ? 'checked' : '' %> />
      Pierde descanso con ≥1 falta injustificada
    </label>
    <label class="inline-check">
      <input type="checkbox" name="pagaDescansoConIncapacidad" <%= pd.pagaDescansoConIncapacidad !== false ? 'checked' : '' %> />
      Incapacidad cuenta para no perder descanso
    </label>
    <label class="inline-check">
      <input type="checkbox" name="pagaDescansoConVacaciones" <%= pd.pagaDescansoConVacaciones !== false ? 'checked' : '' %> />
      Vacaciones cuentan para no perder descanso
    </label>
    <label class="inline-check">
      <input type="checkbox" name="pagaDescansoConPermisoConGoce" <%= pd.pagaDescansoConPermisoConGoce !== false ? 'checked' : '' %> />
      Permiso con goce cuenta para no perder descanso
    </label>
    <label class="inline-check">
      <input type="checkbox" name="cuentaJustificadasComoCumplidas" <%= pd.cuentaJustificadasComoCumplidas !== false ? 'checked' : '' %> />
      Faltas justificadas cuentan como cumplidas
    </label>
    <label class="inline-check">
      <input type="checkbox" name="imssUsaDiasPagados" <%= pd.imssUsaDiasPagados !== false ? 'checked' : '' %> />
      IMSS usa días pagados (cotización)
    </label>
    <div class="form-row-2">
      <label>Días programados (opcional)
        <input type="number" name="diasProgramadosPorPeriodo" min="0" step="1"
          value="<%= pd.diasProgramadosPorPeriodo != null ? pd.diasProgramadosPorPeriodo : '' %>"
          placeholder="Vacío = según tipo de período (ej. 5 semanal)" />
      </label>
      <label>Días de descanso (opcional)
        <input type="number" name="diasDescansoPorPeriodo" min="0" step="1"
          value="<%= pd.diasDescansoPorPeriodo != null ? pd.diasDescansoPorPeriodo : '' %>"
          placeholder="Vacío = calendario − programados (ej. 2)" />
      </label>
    </div>
    <button type="submit">Guardar política de días</button>
  </form>
</section>

<div class="summary-cards">
  <div class="card"><strong><%= satCount %></strong> claves SAT de referencia</div>
  <div class="card"><strong><%= parametros.length %></strong> parámetros</div>
  <div class="card"><strong><%= tablas.length %></strong> tablas fiscales</div>
</div>

<p class="muted">Seeds: <code>npm run seed:nomina-fiscal</code> · <code>npm run seed:catalogo-sat</code> · <code>npm run seed:catalogo-mapeo-legado</code> · Import legado: <code>npm run import:conceptos-legado -- --slug=&lt;tenant&gt;</code></p>
<p><a href="/nomina/catalogos">Administrar catálogos SAT, mapeo legado y parámetros →</a></p>

<h2>Parámetros generales</h2>
<table>
  <thead>
    <tr><th>Clave</th><th>Valor</th><th>Vigencia desde</th><th>Descripción</th></tr>
  </thead>
  <tbody>
    <% if (!parametros.length) { %>
    <tr><td colspan="4" class="muted">Sin parámetros. Ejecuta el seed fiscal.</td></tr>
    <% } %>
    <% parametros.forEach(function(p) { %>
    <tr>
      <td><code><%= p.clave %></code></td>
      <td><%= p.valor %></td>
      <td><%= new Date(p.vigenciaDesde).toLocaleDateString('es-MX') %></td>
      <td><%= p.descripcion || '—' %></td>
    </tr>
    <% }); %>
  </tbody>
</table>

<h2>Tablas fiscales</h2>
<p><a href="/nomina/catalogos/tablas-fiscales">Administrar tablas ISR y rangos →</a></p>
<% if (!tablas.length) { %>
<p class="muted">Sin tablas. Ejecuta el seed fiscal o créalas en Catálogos.</p>
<% } %>
<% tablas.forEach(function(t) { %>
<section class="tabla-fiscal-block">
  <h3><code><%= t.codigo %></code> — <%= t.nombre || t.periodicidad %></h3>
  <p class="muted">Vigente desde <%= new Date(t.vigenciaDesde).toLocaleDateString('es-MX') %></p>
  <% if (t.rangos && t.rangos.length) { %>
  <table>
    <thead>
      <tr><th>Límite inf.</th><th>Límite sup.</th><th>Cuota fija</th><th>% excedente</th></tr>
    </thead>
    <tbody>
      <% t.rangos.forEach(function(r) { %>
      <tr>
        <td><%= r.limiteInferior %></td>
        <td><%= r.limiteSuperior %></td>
        <td><%= r.cuotaFija %></td>
        <td><%= (r.porcentajeExcedente * 100).toFixed(2) %>%</td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</section>
<% }); %>
<%- include('../Partials/layout-bottom') %>
