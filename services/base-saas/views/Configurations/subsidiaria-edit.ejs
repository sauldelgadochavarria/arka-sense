<%- include('../Partials/layout-top', { title: 'Editar subsidiaria', session }) %>
<p><a href="/config-subsidiarias">← Volver a subsidiarias</a></p>

<h1>Editar subsidiaria</h1>
<form method="post" action="/config-subsidiarias/<%= subsidiaria._id %>" class="form-grid form-wide">
  <input name="codigo" value="<%= subsidiaria.codigo %>" placeholder="Código" required />
  <input name="codigoLegado" type="number" placeholder="Código legado Fortia" value="<%= subsidiaria.codigoLegado != null ? subsidiaria.codigoLegado : '' %>" />
  <input name="nombre" value="<%= subsidiaria.nombre %>" placeholder="Nombre" required />
  <input name="direccion" value="<%= subsidiaria.direccion || '' %>" placeholder="Dirección" />
  <input name="ciudad" value="<%= subsidiaria.ciudad || '' %>" placeholder="Ciudad" />
  <input name="estado" value="<%= subsidiaria.estado || '' %>" placeholder="Estado (texto libre, no determina el ISN)" />
  <label>Entidad del ISN
    <select name="entidadFederativa">
      <option value="">— Lugar del establecimiento —</option>
      <% (entidadesFederativas || []).forEach(function (e) { %>
      <option value="<%= e.value %>" <%= subsidiaria.entidadFederativa === e.value ? 'selected' : '' %>><%= e.label %></option>
      <% }); %>
    </select>
  </label>
  <input name="codigoPostal" value="<%= subsidiaria.codigoPostal || '' %>" placeholder="Código postal" />
  <input name="lat" type="number" step="any" value="<%= subsidiaria.lat != null ? subsidiaria.lat : '' %>" placeholder="Latitud" />
  <input name="lng" type="number" step="any" value="<%= subsidiaria.lng != null ? subsidiaria.lng : '' %>" placeholder="Longitud" />
  <input name="geocercaRadioMetros" type="number" min="0" value="<%= subsidiaria.geocercaRadioMetros != null ? subsidiaria.geocercaRadioMetros : '' %>" placeholder="Radio de referencia (m)" />
  <p class="muted small" style="grid-column:1/-1;margin:0;">Latitud, longitud y radio quedan como referencia de la plaza. El checado valida la geocerca del <a href="/config-puntos-acceso">punto de acceso</a>.</p>
  <label style="grid-column:1/-1;">
    Zona horaria (IANA)
    <select name="zonaHoraria">
      <%
        const tzActual = (subsidiaria.zonaHoraria || 'America/Mexico_City');
        const zonas = [
          'America/Mexico_City',
          'America/Cancun',
          'America/Merida',
          'America/Monterrey',
          'America/Mazatlan',
          'America/Chihuahua',
          'America/Tijuana',
          'America/Hermosillo',
          'America/Bahia_Banderas'
        ];
      %>
      <% zonas.forEach(function(z) { %>
      <option value="<%= z %>" <%= tzActual === z ? 'selected' : '' %>><%= z %></option>
      <% }); %>
      <% if (zonas.indexOf(tzActual) < 0) { %>
      <option value="<%= tzActual %>" selected><%= tzActual %></option>
      <% } %>
    </select>
    <small class="muted">Reloj de esta plaza: checado, asistencia, prenómina, nómina y la app móvil. El servidor guarda el instante en UTC.</small>
  </label>
  <label style="display:flex;align-items:flex-start;gap:8px;grid-column:1/-1;margin-top:8px;">
    <input
      type="checkbox"
      name="exigirRegistroDispositivo"
      value="true"
      <%= subsidiaria.seguridadMovil && subsidiaria.seguridadMovil.exigirRegistroDispositivo ? 'checked' : '' %>
    />
    <span>
      <strong>Exigir registro de dispositivo (SMS + UUID)</strong><br />
      <small>
        Si está activo, el empleado debe verificar el móvil con código SMS antes de checar.
        La marcación siempre envía <code>deviceUuid</code> + GPS; con esta opción además debe estar registrado.
      </small>
    </span>
  </label>

  <fieldset style="grid-column:1/-1;margin-top:12px;border:1px solid var(--border, #ddd);padding:12px;border-radius:8px;">
    <legend><strong>Horas extra y checada fuera de horario</strong></legend>
    <p class="muted small">
      Las horas extra solo piden aprobación en Autorizar si llegan a este mínimo.
      Por debajo quedan como nota. Una checada fuera del horario del turno también queda como nota, no como retardo por autorizar.
    </p>
    <label>Minutos mínimos de horas extra para autorizar
      <input name="heMinutosParaAutorizar" type="number" min="0" max="180" value="<%= subsidiaria.heMinutosParaAutorizar != null ? subsidiaria.heMinutosParaAutorizar : 15 %>" />
    </label>
  </fieldset>

  <fieldset style="grid-column:1/-1;margin-top:12px;border:1px solid var(--border, #ddd);padding:12px;border-radius:8px;">
    <legend><strong>Marcación automática (entrada y salida)</strong></legend>
    <% const auto = subsidiaria.marcacionAutomatica || {}; %>
    <p class="muted small">
      Minutos de margen alrededor de la hora del turno. Cada empleado con la casilla en su ficha
      recibe una hora al azar dentro de este rango. Se generan en Marcaciones y se pueden reprocesar por día y departamento.
      Si el “después” de la entrada supera la tolerancia del turno, el día queda como retardo.
    </p>
    <label>Entrada: minutos antes
      <input name="autoEntradaAntes" type="number" min="0" max="180" value="<%= auto.entradaAntesMin != null ? auto.entradaAntesMin : 10 %>" />
    </label>
    <label>Entrada: minutos después
      <input name="autoEntradaDespues" type="number" min="0" max="180" value="<%= auto.entradaDespuesMin != null ? auto.entradaDespuesMin : 5 %>" />
    </label>
    <label>Salida: minutos antes
      <input name="autoSalidaAntes" type="number" min="0" max="180" value="<%= auto.salidaAntesMin != null ? auto.salidaAntesMin : 5 %>" />
    </label>
    <label>Salida: minutos después
      <input name="autoSalidaDespues" type="number" min="0" max="180" value="<%= auto.salidaDespuesMin != null ? auto.salidaDespuesMin : 10 %>" />
    </label>
  </fieldset>

  <fieldset style="grid-column:1/-1;margin-top:12px;border:1px solid var(--border, #ddd);padding:12px;border-radius:8px;">
    <legend><strong>Módulos en esta subsidiaria</strong></legend>
    <input type="hidden" name="modulosForm" value="1" />
    <p class="muted small">
      La app usa <strong>licencia del tenant y esta subsidiaria</strong>.
      Si Vacaciones o Recibos están apagados en el tenant, quedan desactivados aquí y en Arka Sense.
    </p>
    <% (modulosUi || []).forEach(function(m) { %>
    <label style="display:flex;align-items:flex-start;gap:8px;margin:8px 0;<%= m.tenantOn ? '' : 'opacity:.72' %>">
      <input
        type="checkbox"
        name="modulos[<%= m.key %>]"
        value="true"
        <%= m.checked ? 'checked' : '' %>
        <%= m.tenantOn ? '' : 'disabled' %>
      />
      <span>
        <strong><%= m.label %></strong>
        <% if (!m.tenantOn) { %> <span class="muted">— desactivado en la licencia del tenant</span><% } %>
        <br /><small class="muted"><%= m.hint %></small>
      </span>
    </label>
    <% }); %>
  </fieldset>

  <button type="submit">Guardar</button>
</form>
<%- include('../Partials/layout-bottom') %>
