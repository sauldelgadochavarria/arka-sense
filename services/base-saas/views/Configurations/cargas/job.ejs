<%- include('../../Partials/layout-top', { title: 'Job de carga', session }) %>
<%
  const isCfdi = job.tipo === 'cfdi_nomina_zip' || job.tipo === 'cfdi_nomina_zip_masivo';
  const isMasivo = job.tipo === 'cfdi_nomina_zip_masivo';
  const pollStatuses = ['encolado', 'parseando', 'aplicando'];
  const shouldPoll = isMasivo && pollStatuses.includes(job.estatus);
  const isReligar = (job.progreso && String(job.progreso.fase || '').indexOf('religar_xml') === 0 && job.estatus === 'aplicando');
  const applyAsyncZip = !!(job.resumen && job.resumen.applyAsync) || (isCfdi && pollStatuses.includes(job.estatus));
  const shouldPollAny = shouldPoll || isReligar || applyAsyncZip || job.estatus === 'aplicando';
  const P = job.progreso || {};
%>
<h1>Job de carga</h1>
<div class="toolbar">
  <a class="btn" href="/config-empresa/cargas">← Cargas</a>
  <% if (carga) { %>
  <a class="btn" href="/config-empresa/cargas/<%= carga.codigo %>">Volver a <%= carga.titulo %></a>
  <% } %>
</div>

<div class="summary-cards">
  <div class="card"><strong><%= job.tipo %></strong> tipo</div>
  <div class="card"><strong id="job-estatus"><%= job.estatus %></strong> estatus</div>
  <div class="card"><strong id="job-total"><%= job.totalFilas || 0 %></strong> filas</div>
  <div class="card"><strong id="job-ok"><%= job.filasOk || 0 %></strong> OK</div>
  <div class="card"><strong id="job-err"><%= job.filasError || 0 %></strong> errores</div>
  <div class="card"><strong id="job-apl"><%= job.filasAplicadas || 0 %></strong> aplicadas</div>
</div>

<% if (isMasivo || shouldPollAny) { %>
<section class="panel" id="panel-progreso">
  <h2 class="panel-title">Progreso (async)</h2>
  <p class="muted" id="job-progreso-msg"><%= P.mensaje || P.fase || '—' %></p>
  <% const tot = Number(P.total || job.totalFilas || 0); const proc = Number(P.procesados || 0); %>
  <div style="background:#e5e7eb;border-radius:6px;height:12px;overflow:hidden;max-width:420px">
    <div id="job-progreso-bar" style="height:100%;width:<%= tot ? Math.min(100, Math.round(proc / tot * 100)) : 0 %>%;background:#2563eb;transition:width .3s"></div>
  </div>
  <p class="muted small" id="job-progreso-nums">
    <%= proc %> / <%= tot || '—' %>
    · OK <%= P.exitos || 0 %> · err <%= P.errores || 0 %> · omit <%= P.omitidos || 0 %>
  </p>
</section>
<% } %>

<p class="muted small">
  Archivo: <strong><%= job.archivoNombre || '—' %></strong>
  · <%= new Date(job.createdAt).toLocaleString('es-MX') %>
  <% if (job.userLabel) { %> · por <%= job.userLabel %><% } %>
</p>
<p id="job-notas"><% if (job.notas) { %><%= job.notas %><% } %></p>

<% if (isCfdi && (job.estatus === 'ok' || job.estatus === 'parcial' || job.aplicadoAt)) { %>
<% const PR = (job.resumen && job.resumen.postReport) || null; %>
<section class="panel" id="post-report">
  <h2 class="panel-title">Resultados y sugerencias de configuración</h2>
  <% if (!PR) { %>
  <p class="muted">
    Este job aún no tiene informe post-aplicación (cargas anteriores al feature).
    Puedes generarlo ahora sin reaplicar.
  </p>
  <form method="post" action="/config-empresa/cargas/jobs/<%= job._id %>/informe-config">
    <button type="submit" class="btn btn-primary">Generar informe</button>
  </form>
  <% } else {
    const C = PR.contadores || {};
    const sevBadge = function (s) {
      if (s === 'bloqueante') return 'badge-baja';
      if (s === 'revisar') return 'badge-suspendido';
      return 'badge-activo';
    };
  %>
  <div class="summary-cards" style="margin-bottom:.75rem">
    <div class="card"><strong><%= C.recibosAplicados || 0 %></strong> recibos</div>
    <div class="card"><strong><%= C.empleadosAfectados || 0 %></strong> empleados</div>
    <div class="card"><strong><%= C.conceptosMapeados || 0 %></strong> conceptos mapeados</div>
    <div class="card"><strong><%= C.conceptosPendientes || 0 %></strong> pendientes mapa</div>
    <div class="card"><strong><%= C.sinCuentaContable || 0 %></strong> sin cuenta</div>
    <div class="card"><strong><%= C.pendientes || 0 %></strong> pendientes</div>
  </div>
  <p class="muted small">
    Generado <%= PR.generadoEn ? new Date(PR.generadoEn).toLocaleString('es-MX') : '—' %>
    · <a href="/nomina/mapeo-sat">Mapeo SAT</a>
    · <a href="/nomina/conceptos">Conceptos</a>
    · <a href="/nomina/periodos">Períodos</a>
  </p>

  <% if (PR.sugerencias && PR.sugerencias.length) { %>
  <h3 class="panel-title" style="font-size:1rem;margin-top:1rem">Sugerencias</h3>
  <ul class="vars-list">
    <% PR.sugerencias.forEach(function(s) { %>
    <li style="margin-bottom:.65rem">
      <span class="badge <%= sevBadge(s.severidad) %>"><%= s.severidad %></span>
      <strong><%= s.titulo %></strong>
      <div class="muted small"><%= s.detalle %></div>
      <% if (s.link) { %>
      <a href="<%= s.link %>"><%= s.linkLabel || 'Ir' %></a>
      <% } %>
      <% if (s.items && s.items.length) { %>
      <details style="margin-top:.25rem">
        <summary class="muted small"><%= s.items.length %> ítem(s)</summary>
        <ul class="muted small">
          <% s.items.slice(0, 25).forEach(function(it) { %>
          <li>
            <% if (it.link) { %><a href="<%= it.link %>"><%= it.label %></a><% } else { %><%= it.label %><% } %>
          </li>
          <% }); %>
        </ul>
      </details>
      <% } %>
    </li>
    <% }); %>
  </ul>
  <% } else { %>
  <p class="muted">Sin pendientes detectados. Revisa períodos y recalcula la nómina.</p>
  <% } %>

  <% if (PR.conceptos && PR.conceptos.mapeados && PR.conceptos.mapeados.length) { %>
  <details style="margin-top:.75rem">
    <summary>Conceptos mapeados (<%= PR.conceptos.mapeados.length %>)</summary>
    <table>
      <thead><tr><th>CFDI</th><th>Motor</th><th>Nombre</th><th>SAT</th></tr></thead>
      <tbody>
        <% PR.conceptos.mapeados.forEach(function(r) { %>
        <tr>
          <td><a href="<%= r.link %>"><code><%= r.codigo %></code></a></td>
          <td><code><%= r.codigoMotor || '—' %></code></td>
          <td><%= r.nombre %></td>
          <td><%= r.claveSat || '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </details>
  <% } %>

  <% if (PR.conceptos && PR.conceptos.pendientesMapa && PR.conceptos.pendientesMapa.length) { %>
  <details style="margin-top:.5rem" open>
    <summary>Conceptos pendientes de mapear (<%= PR.conceptos.pendientesMapa.length %>)</summary>
    <table>
      <thead><tr><th>CFDI</th><th>Nombre</th><th>SAT</th><th></th></tr></thead>
      <tbody>
        <% PR.conceptos.pendientesMapa.forEach(function(r) { %>
        <tr>
          <td><code><%= r.codigo %></code></td>
          <td><%= r.nombre %></td>
          <td><%= r.claveSat || '—' %></td>
          <td><a href="/nomina/mapeo-sat">Mapear</a> · <a href="<%= r.link %>">Editar</a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </details>
  <% } %>

  <form method="post" action="/config-empresa/cargas/jobs/<%= job._id %>/informe-config" style="margin-top:1rem">
    <button type="submit" class="btn">Actualizar informe</button>
  </form>
  <% } %>
</section>
<% } %>

<% if (isCfdi && (job.estatus === 'ok' || job.estatus === 'parcial')) { %>
<section class="panel">
  <h2 class="panel-title">Organizar períodos</h2>
  <p class="muted">
    Tras una importación masiva, los períodos pueden quedar mezclados entre subsidiarias o con numeración fuera de orden.
    Este paso separa mezclas, fusiona solapes y renumeración cronológica por subsidiaria.
  </p>
  <form method="post" action="/config-empresa/cargas/jobs/<%= job._id %>/organizar-periodos" class="form-grid"
        onsubmit="return confirm('¿Organizar períodos ahora?');">
    <label>Tipo período (motor)
      <select name="tipoPeriodo">
        <option value="semanal" selected>Semanal</option>
        <option value="catorcenal">Catorcenal</option>
        <option value="quincenal">Quincenal</option>
        <option value="mensual">Mensual</option>
      </select>
    </label>
    <label>Tipo nómina
      <select name="tipoNomina">
        <option value="ordinaria" selected>Ordinaria</option>
        <option value="aguinaldo">Aguinaldo</option>
        <option value="ptu">PTU</option>
        <option value="finiquito">Finiquito</option>
      </select>
    </label>
    <div style="align-self:end;display:flex;gap:.5rem;flex-wrap:wrap">
      <button type="submit" class="btn btn-primary">Organizar períodos</button>
      <a class="btn" href="/nomina/periodos">Ver períodos</a>
    </div>
  </form>
</section>

<section class="panel">
  <h2 class="panel-title">Religar XML a históricos</h2>
  <p class="muted">
    Si ves «UUID sin archivo» en el detalle del período, sube de nuevo el mismo ZIP de CFDI.
    Solo guarda/liga los XML por UUID (no vuelve a crear empleados ni períodos).
  </p>
  <form method="post" action="/config-empresa/cargas/jobs/<%= job._id %>/religar-xml"
        enctype="multipart/form-data" class="form-grid form-wide">
    <label>ZIP original
      <input type="file" name="zip" accept=".zip,application/zip" required />
    </label>
    <button type="submit" class="btn btn-primary">Religar XML</button>
  </form>
</section>
<% } %>

<% if (job.resumen) { %>
<section class="panel">
  <h2 class="panel-title">Conciliación / resumen</h2>
  <% const R = job.resumen; %>
  <% if (isCfdi) { %>
  <% const O = R.opciones || {}; const OR = R.opcionesResumen || {}; const Plan = R.planAplicacion || {}; %>
  <ul class="vars-list">
    <li>Año: <strong><%= R.anio || '—' %></strong><% if (R.async) { %> · <span class="badge">async</span><% } %></li>
    <li>Bloques: <strong><%= (OR.bloques || []).join(', ') || '—' %></strong> · modo <code><%= OR.modo || 'upsert' %></code></li>
    <% if (Plan.empresa != null) { %>
    <li>Plan: empresa <%= Plan.empresa ? 'sí' : 'no' %> · empleados <%= Plan.empleados %> · org <%= Plan.organizacion %> · conceptos <%= Plan.conceptos %> · histórico <%= Plan.historico %> · acumulados <%= Plan.acumulados %></li>
    <% } %>
    <li>XML en ZIP: <%= R.xmlEnZip || 0 %> · Recibos OK: <strong><%= R.recibosOk || 0 %></strong> · Omitidos: <%= R.omitidos || 0 %></li>
    <li>Empleados únicos: <%= R.empleadosUnicos || 0 %> (crear <%= R.empleadosCrear || 0 %> · actualizar <%= R.empleadosActualizar || 0 %>)</li>
    <li>Conceptos detectados: <%= R.conceptosDetectados || 0 %></li>
    <li>Departamentos: <%= (R.departamentos || []).length %> · Puestos: <%= (R.puestos || []).length %></li>
    <li>Neto total XML: <strong>$<%= Number(R.totalNeto || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong></li>
    <li>Recibos que no cuadran (±$0.05): <%= R.recibosNoCuadran || 0 %></li>
    <li>RFC empresa: <code><%= R.rfcEmpresa || '—' %></code> · Emisor muestra: <code><%= R.rfcEmisorMuestra || '—' %></code></li>
    <% if (R.periodos) { %>
    <li>Períodos inferidos: <strong><%= R.periodos.ventanas || 0 %></strong> ventanas · tipos <%= R.periodos.tipos || 0 %> · creados <%= R.periodos.periodosCreados || 0 %> · actualizados <%= R.periodos.periodosActualizados || 0 %>
      · <a href="/nomina/periodos">Ver períodos de nómina</a>
      · <a href="/catalogos/periodos">Ver catálogo / pre-nómina</a>
    </li>
    <% } %>
    <% if (R.aplicadas != null) { %>
    <li>Aplicadas: <strong><%= R.aplicadas %></strong> · empleados afectados <%= R.empleadosAfectados || 0 %></li>
    <% } %>
  </ul>
  <% if (R.departamentos && R.departamentos.length) { %>
  <p class="muted small">Deptos: <%= R.departamentos.slice(0, 20).join(', ') %><%= R.departamentos.length > 20 ? '…' : '' %></p>
  <% } %>
  <% if (R.conceptosMuestra && R.conceptosMuestra.length) { %>
  <details>
    <summary>Conceptos (muestra)</summary>
    <pre class="muted small" style="max-height:200px;overflow:auto"><%= JSON.stringify(R.conceptosMuestra, null, 2) %></pre>
  </details>
  <% } %>
  <% if (R.omitidosMuestra && R.omitidosMuestra.length) { %>
  <details>
    <summary>Omitidos (muestra)</summary>
    <pre class="muted small" style="max-height:160px;overflow:auto"><%= JSON.stringify(R.omitidosMuestra, null, 2) %></pre>
  </details>
  <% } %>
  <% } else if (R.nota) { %>
  <p class="muted small"><%= R.nota %></p>
  <% } %>
</section>
<% } %>

<% 
  const canApplyFirst = (job.estatus === 'validado' || job.estatus === 'parcial') && !job.aplicadoAt;
  const canReapplyCfdi = isCfdi && ['ok', 'parcial', 'validado', 'error'].includes(job.estatus) && !['encolado', 'parseando', 'aplicando'].includes(job.estatus);
  const showApplyForm = canApplyFirst || canReapplyCfdi;
%>
<% if (showApplyForm) { %>
<section class="panel">
  <h2 class="panel-title"><%= canApplyFirst ? '2. Confirmar aplicación' : (job.estatus === 'error' ? 'Reintentar aplicación' : 'Reaplicar / completar bloques') %></h2>
  <% if (canApplyFirst) { %>
  <p class="muted small">Se aplicarán las <strong><%= job.filasOk %></strong> filas válidas según los bloques marcados.</p>
  <% } else if (job.estatus === 'error') { %>
  <p class="muted small">
    Este job falló al aplicar. Puedes <strong>reintentar con el staging ya parseado</strong> (no hace falta volver a subir el ZIP).
    Deja marcado <strong>Períodos</strong> si el error fue al inferir períodos.
  </p>
  <% } else { %>
  <p class="muted small">
    Este job ya se aplicó. Puedes volver a ejecutar bloques (idempotente).
    Para generar períodos cerrados/timbrados desde el CFDI, deja marcado <strong>Períodos</strong>.
  </p>
  <% } %>
  <% if (job.tipo === 'historico_recibos') { %>
  <p class="muted small">Los recibos se guardan como histórico importado (sin período local vinculado).</p>
  <% } %>
  <% if (isCfdi) {
    const O = (job.resumen && job.resumen.opciones) || {};
    const reapply = !canApplyFirst;
  %>
  <form method="post" action="/config-empresa/cargas/jobs/<%= job._id %>/aplicar" class="form-grid"
        onsubmit="return confirm('<%= reapply ? '¿Reaplicar con los bloques seleccionados?' : '¿Aplicar con los bloques seleccionados?' %>');">
    <input type="hidden" name="opcionesForm" value="1" />
    <fieldset style="grid-column:1/-1;border:1px solid #e5e7eb;border-radius:8px;padding:0.85rem 1rem">
      <legend>Bloques a aplicar (puedes ajustar)</legend>
      <label class="inline-check"><input type="checkbox" name="importEmpresa" value="1" <%= !reapply && O.importEmpresa !== false ? 'checked' : '' %> /> Empresa</label>
      <label class="inline-check"><input type="checkbox" name="importEmpleados" value="1" <%= (!reapply && O.importEmpleados !== false) || reapply ? 'checked' : '' %> /> Empleados</label>
      <label class="inline-check"><input type="checkbox" name="importOrganizacion" value="1" <%= !reapply && O.importOrganizacion !== false ? 'checked' : '' %> /> Deptos / puestos</label>
      <label class="inline-check"><input type="checkbox" name="importConceptos" value="1" <%= !reapply && O.importConceptos !== false ? 'checked' : '' %> /> Conceptos</label>
      <label class="inline-check"><input type="checkbox" name="importHistorico" value="1" id="job-opt-hist" <%= (!reapply && O.importHistorico !== false) || reapply ? 'checked' : '' %> /> Histórico</label>
      <label class="inline-check"><input type="checkbox" name="importAcumulados" value="1" id="job-opt-acu" <%= !reapply && O.importAcumulados !== false ? 'checked' : '' %> /> Acumulados</label>
      <label class="inline-check"><input type="checkbox" name="importPeriodos" value="1" id="job-opt-per" checked /> Períodos (inferir / cerrar / timbrados)</label>
    </fieldset>
    <label>Modo de escritura
      <select name="modoEscritura">
        <option value="upsert" <%= O.modoEscritura === 'upsert' || !O.modoEscritura ? 'selected' : '' %>>Upsert</option>
        <option value="crear_solo" <%= O.modoEscritura === 'crear_solo' ? 'selected' : '' %>>Solo crear</option>
        <option value="solo_vacios" <%= O.modoEscritura === 'solo_vacios' ? 'selected' : '' %>>Solo vacíos</option>
      </select>
    </label>
    <label class="inline-check"><input type="checkbox" name="excluirExtraordinarias" value="1" <%= O.excluirExtraordinarias ? 'checked' : '' %> /> Excluir extraordinarias</label>
    <label class="inline-check"><input type="checkbox" name="actualizarDatosLaborales" value="1" <%= O.actualizarDatosLaborales !== false ? 'checked' : '' %> /> Actualizar datos laborales</label>
    <button type="submit"><%= isMasivo ? (reapply ? 'Reencolar apply (async)' : 'Encolar apply (async)') : (reapply ? 'Reaplicar selección' : 'Aplicar selección') %></button>
  </form>
  <script>
  (function(){
    var h=document.getElementById('job-opt-hist'), a=document.getElementById('job-opt-acu'), p=document.getElementById('job-opt-per');
    function s(){
      if(!h)return;
      if(!h.checked){
        if(a){a.checked=false;a.disabled=true;}
        if(p){p.checked=false;p.disabled=true;}
      } else {
        if(a) a.disabled=false;
        if(p) p.disabled=false;
      }
    }
    if(h) h.addEventListener('change',s); s();
  })();
  </script>
  <% } else if (canApplyFirst) { %>
  <form method="post" action="/config-empresa/cargas/jobs/<%= job._id %>/aplicar"
        onsubmit="return confirm('¿Aplicar <%= job.filasOk %> fila(s) válidas?');">
    <button type="submit">Aplicar filas válidas</button>
  </form>
  <% } %>
</section>
<% } %>

<% if (job.muestraOk && job.muestraOk.length) { %>
<section class="panel">
  <h2 class="panel-title">Muestra de filas OK</h2>
  <pre class="muted small" style="max-height:240px;overflow:auto"><%= JSON.stringify(job.muestraOk, null, 2) %></pre>
</section>
<% } %>

<% if (job.errores && job.errores.length) { %>
<section class="panel" id="errores-job">
  <h2 class="panel-title">Errores</h2>
  <table>
    <thead><tr><th>Fila</th><th>Campo</th><th>Mensaje</th><th>Valor</th></tr></thead>
    <tbody>
      <% job.errores.forEach(function(e) { %>
      <tr>
        <td><%= e.fila %></td>
        <td><code><%= e.campo || '—' %></code></td>
        <td><%= e.mensaje %></td>
        <td><code><%= e.valor || '' %></code></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</section>
<% } %>

<% if (shouldPollAny) { %>
<script>
(function () {
  var done = { validado:1, parcial:1, ok:1, error:1, cancelado:1 };
  function tick() {
    fetch('/config-empresa/cargas/jobs/<%= job._id %>/status.json', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d || !d.ok) return;
        var el = function (id) { return document.getElementById(id); };
        if (el('job-estatus')) el('job-estatus').textContent = d.estatus || '';
        if (el('job-total')) el('job-total').textContent = d.totalFilas || 0;
        if (el('job-ok')) el('job-ok').textContent = d.filasOk || 0;
        if (el('job-err')) el('job-err').textContent = d.filasError || 0;
        if (el('job-apl')) el('job-apl').textContent = d.filasAplicadas || 0;
        if (el('job-notas') && d.notas) el('job-notas').textContent = d.notas;
        var p = d.progreso || {};
        if (el('job-progreso-msg')) el('job-progreso-msg').textContent = p.mensaje || p.fase || '—';
        var tot = Number(p.total || d.totalFilas || 0);
        var proc = Number(p.procesados || 0);
        var pct = tot ? Math.min(100, Math.round(proc / tot * 100)) : 0;
        if (el('job-progreso-bar')) el('job-progreso-bar').style.width = pct + '%';
        if (el('job-progreso-nums')) {
          el('job-progreso-nums').textContent =
            proc + ' / ' + (tot || '—') +
            ' · OK ' + (p.exitos || 0) +
            ' · err ' + (p.errores || 0) +
            ' · omit ' + (p.omitidos || 0);
        }
        if (done[d.estatus]) {
          window.location.reload();
          return;
        }
        setTimeout(tick, 2500);
      })
      .catch(function () { setTimeout(tick, 4000); });
  }
  setTimeout(tick, 1500);
})();
</script>
<% } %>

<%- include('../../Partials/layout-bottom') %>
