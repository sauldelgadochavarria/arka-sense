<%- include('../Partials/layout-top', { title: 'Subsidiarias', session }) %>
<h1>Subsidiarias</h1>
<% if (!empresa) { %>
<p>No hay empresa vinculada a este tenant. Activa el tenant desde Arka-Presence Admin.</p>
<% } else { %>
<table>
  <thead><tr><th>Código</th><th>Cód. legado</th><th>Nombre</th><th>Ciudad</th><th>Geocerca</th><th>Activo</th><th></th></tr></thead>
  <tbody>
    <% subsidiarias.forEach(function(s) { %>
    <tr class="<%= !s.activo ? 'row-muted' : '' %>">
      <td><code><%= s.codigo %></code></td>
      <td><%= s.codigoLegado != null ? s.codigoLegado : '—' %></td>
      <td><%= s.nombre %></td>
      <td><%= s.ciudad || '—' %></td>
      <td><%= s.geocercaRadioMetros ? s.geocercaRadioMetros + ' m' : '—' %></td>
      <td><%= s.activo ? 'Sí' : 'No' %></td>
      <td class="actions">
        <% if (!session.subsidiariaActiva || String(session.subsidiariaActiva._id) !== String(s._id)) { %>
        <form method="post" action="/cambiar-subsidiaria/<%= s._id %>" class="inline-form">
          <button type="submit">Usar</button>
        </form>
        <% } else { %>Activa<% } %>
        <a href="/config-subsidiarias/<%= s._id %>/edit">Editar</a>
        <form method="post" action="/config-subsidiarias/<%= s._id %>/toggle" class="inline-form">
          <button type="submit"><%= s.activo ? 'Desactivar' : 'Activar' %></button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>

<h2>Nueva subsidiaria</h2>
<form method="post" action="/config-subsidiarias" class="form-grid form-wide">
  <input name="codigo" placeholder="Código (ej. SUC01)" required />
  <input name="codigoLegado" type="number" placeholder="Código legado Fortia (CLA_UBICACION)" />
  <input name="nombre" placeholder="Nombre" required />
  <input name="direccion" placeholder="Dirección" />
  <input name="ciudad" placeholder="Ciudad" />
  <input name="estado" placeholder="Estado" />
  <input name="codigoPostal" placeholder="Código postal" />
  <input name="lat" type="number" step="any" placeholder="Latitud (opcional)" />
  <input name="lng" type="number" step="any" placeholder="Longitud (opcional)" />
  <input name="geocercaRadioMetros" type="number" min="0" placeholder="Radio geocerca (metros)" />
  <button type="submit">Crear</button>
</form>
<% } %>
<%- include('../Partials/layout-bottom') %>
