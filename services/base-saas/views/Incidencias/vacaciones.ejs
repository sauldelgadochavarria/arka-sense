<%- include('../Partials/layout-top', { title: 'Vacaciones', session }) %>
<p>
  <a href="/incidencias">← Incidencias</a>
  · <a href="/incidencias/vacaciones/solicitudes">Solicitudes (RRHH)</a>
  · <a href="/incidencias/dias-inhabiles">Días inhábiles</a>
</p>
<h1>Saldos de vacaciones <%= anio %></h1>
<% if (session && session.subsidiariaActiva) { %>
<p class="muted">De la subsidiaria <strong><%= session.subsidiariaActiva.nombre %></strong>.</p>
<% } %>

<form method="post" action="/incidencias/vacaciones/recalcular" class="toolbar inline-form">
  <input type="hidden" name="anio" value="<%= anio %>" />
  <button type="submit">Recalcular saldos (LFT)</button>
</form>

<table>
  <thead>
    <tr><th>Empleado</th><th>Antigüedad</th><th>Corresponden</th><th>Tomados</th><th>Reservados</th><th>Disponibles</th><th>Prima %</th></tr>
  </thead>
  <tbody>
    <% filas.forEach(function(f) { %>
    <tr>
      <td><%= f.empleado ? f.empleado.firstName + ' ' + f.empleado.lastName : '—' %></td>
      <td><%= f.anios %> año(s)</td>
      <td><%= f.saldo.diasCorresponden %></td>
      <td><%= f.saldo.diasTomados %></td>
      <td><%= f.saldo.diasCongelados || 0 %></td>
      <td><strong><%= f.saldo.diasPendientes %></strong></td>
      <td><%= f.saldo.primaVacacionalPct %>%</td>
    </tr>
    <% }); %>
    <% if (!filas.length) { %>
    <tr><td colspan="7" class="muted">Ningún empleado activo en esta subsidiaria.</td></tr>
    <% } %>
  </tbody>
</table>
<%- include('../Partials/layout-bottom') %>
