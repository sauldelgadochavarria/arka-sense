# Bookworm: canvas + face-api (Alpine/musl no es viable)
FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    pkg-config \
    libcairo2-dev \
    libjpeg-dev \
    libpango1.0-dev \
    libgif-dev \
    librsvg2-dev \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
# Descargar pesos FaceNet / SSD (idempotente)
RUN npm run biometrics:models || true

EXPOSE 3000
CMD ["sh", "-c", "npm install && (npm run biometrics:models || true) && node index.js"]
