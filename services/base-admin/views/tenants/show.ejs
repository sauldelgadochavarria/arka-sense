<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title><%= tenant.displayName %></title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; max-width: 760px; }
    .msg { background: #e8f4fd; padding: 12px; border-radius: 4px; margin-bottom: 1rem; }
    label { display: block; margin-top: 0.45rem; }
    button { margin-top: 1rem; padding: 8px 14px; cursor: pointer; }
    .primary { background: #16a34a; color: #fff; border: none; border-radius: 4px; }
    .danger { background: #dc2626; color: #fff; border: none; border-radius: 4px; }
    .pkg {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 1rem 1.1rem;
      margin: 1rem 0;
      background: #fafafa;
    }
    .pkg h3 { margin: 0 0 0.25rem; font-size: 1.05rem; }
    .pkg .desc { color: #6b7280; font-size: 0.9rem; margin: 0 0 0.75rem; }
    .pkg-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
    .pkg-actions button {
      margin-top: 0;
      padding: 4px 10px;
      font-size: 0.85rem;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      background: #fff;
    }
    .pkg-actions button:hover { background: #f3f4f6; }
    .flag-row { font-weight: normal; }
    .flag-row .meta { color: #6b7280; font-size: 0.85rem; }
    .locked { opacity: 0.75; }
    .hint { color: #6b7280; font-size: 0.9rem; margin: 0.5rem 0 0; }
  </style>
</head>
<body>
  <h1><%= tenant.displayName %></h1>
  <p>Slug: <code><%= tenant.slug %></code> · Estado: <strong><%= tenant.status %></strong></p>

  <% if (typeof message !== 'undefined' && message) { %>
  <div class="msg"><%= message %></div>
  <% } %>

  <% if (tenant.status === 'active') { %>
  <p><a href="<%= tenantLoginUrl(tenant.slug) %>" target="_blank">Abrir aplicación SaaS</a></p>

  <h2>Usuario administrador</h2>
  <p>Si la activación no creó el owner (ej. <code>ROLE_NOT_FOUND</code>), ejecuta el seed y usa este formulario:</p>
  <form method="post" action="/admin/tenants/<%= tenant.tenantId %>/provision-owner">
    <label>Email del administrador</label>
    <input type="email" name="ownerEmail" placeholder="admin@empresa.com" required />
    <button type="submit" class="primary">Crear usuario administrador</button>
  </form>
  <% } %>

  <% if (tenant.status === 'pending') { %>
  <form method="post" action="/admin/tenants/<%= tenant.tenantId %>/activate">
    <label>Email del propietario (opcional)</label>
    <input type="email" name="ownerEmail" placeholder="admin@empresa.com" />
    <label>Código subsidiaria principal</label>
    <input type="text" name="codigo" value="MAIN" />
    <button type="submit" class="primary">Activar tenant</button>
  </form>
  <% } %>

  <h2>Licencia / módulos</h2>
  <p class="hint">
    Los <strong>paquetes</strong> son atajos comerciales. Debajo siguen los flags granulares
    (misma fuente que usa el menú SaaS). Núcleo siempre permanece activo.
  </p>

  <form method="post" action="/admin/tenants/<%= tenant.tenantId %>/feature-flags" id="form-flags">
    <% (featurePackages || []).forEach(function(pkg) { %>
    <div class="pkg" data-package="<%= pkg.id %>">
      <h3><%= pkg.label %><% if (pkg.alwaysOn) { %> <small>(siempre ON)</small><% } %></h3>
      <p class="desc"><%= pkg.description %></p>
      <% if (!pkg.alwaysOn) { %>
      <div class="pkg-actions">
        <button type="button" class="btn-pkg-on" data-pkg="<%= pkg.id %>">Activar paquete</button>
        <button type="button" class="btn-pkg-off" data-pkg="<%= pkg.id %>">Desactivar paquete</button>
      </div>
      <% } %>
      <% (pkg.flags || []).forEach(function(f) { %>
      <label class="flag-row<%= f.locked ? ' locked' : '' %>">
        <input
          type="checkbox"
          name="featureFlags[<%= f.key %>]"
          value="true"
          data-pkg="<%= pkg.id %>"
          <%= flags[f.key] ? 'checked' : '' %>
          <%= f.locked ? 'checked disabled' : '' %>
        />
        <%= f.label %>
        <span class="meta">— <%= f.description %></span>
      </label>
      <% if (f.locked) { %>
      <input type="hidden" name="featureFlags[<%= f.key %>]" value="true" />
      <% } %>
      <% }); %>
    </div>
    <% }); %>
    <button type="submit" class="primary">Guardar licencia</button>
  </form>

  <% if (tenant.status === 'active') { %>
  <form method="post" action="/admin/tenants/<%= tenant.tenantId %>/suspend" style="margin-top:2rem">
    <button type="submit" class="danger">Suspender</button>
  </form>
  <% } %>

  <p><a href="/admin/tenants">← Volver</a></p>

  <script>
  (function () {
    function setPackage(pkgId, on) {
      document.querySelectorAll('input[type=checkbox][data-pkg="' + pkgId + '"]').forEach(function (cb) {
        if (cb.disabled) return;
        cb.checked = !!on;
      });
    }
    document.querySelectorAll('.btn-pkg-on').forEach(function (btn) {
      btn.addEventListener('click', function () { setPackage(btn.getAttribute('data-pkg'), true); });
    });
    document.querySelectorAll('.btn-pkg-off').forEach(function (btn) {
      btn.addEventListener('click', function () { setPackage(btn.getAttribute('data-pkg'), false); });
    });
  })();
  </script>
</body>
</html>
